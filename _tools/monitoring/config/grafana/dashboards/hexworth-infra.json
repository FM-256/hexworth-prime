{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "CPU Usage by Server",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1 },
        "overrides": []
      },
      "targets": [{
        "expr": "1 - avg by (server) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
        "legendFormat": "{{server}}"
      }]
    },
    {
      "title": "Memory Usage by Server",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "targets": [{
        "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
        "legendFormat": "{{server}} used"
      }, {
        "expr": "node_memory_MemTotal_bytes",
        "legendFormat": "{{server}} total"
      }]
    },
    {
      "title": "Disk Usage by Server",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":0.7},{"color":"red","value":0.9}] } },
        "overrides": []
      },
      "targets": [{
        "expr": "1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"})",
        "legendFormat": "{{server}}"
      }]
    },
    {
      "title": "Network I/O (receive)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      },
      "targets": [{
        "expr": "rate(node_network_receive_bytes_total{device=~\"eth.*|ens.*|tailscale.*\"}[5m])",
        "legendFormat": "{{server}} {{device}}"
      }]
    },
    {
      "title": "System Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [{
        "expr": "time() - node_boot_time_seconds",
        "legendFormat": "{{server}}"
      }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hexworth", "infrastructure"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Hexworth Infrastructure",
  "uid": "hexworth-infra"
}
