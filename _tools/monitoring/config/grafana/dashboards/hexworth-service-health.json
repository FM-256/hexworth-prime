{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "Hexworth Service Health (SLA)",
  "uid": "hexworth-service-health",
  "tags": [
    "hexworth",
    "sla",
    "services"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "stat",
      "title": "Service status now",
      "description": "up + checked gives a 3-state value: 2 = healthy, 1 = DOWN (we checked and it failed), 0 = BLIND (the check could not run \u2014 that is NOT a verdict about the service). Collapsing blind into down is how a broken prober becomes a false outage.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": ""
          },
          "editorMode": "code",
          "expr": "hexworth_probe_up + hexworth_probe_checked",
          "legendFormat": "{{service}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "BLIND",
                  "color": "purple",
                  "index": 0
                },
                "1": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "UP",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Availability \u2014 24 hours",
      "description": "sum(up)/sum(checked) over the window. Divides by the number of samples we actually took, NOT by wall-clock time, so a blind prober does not count against the service. Windows longer than the probe's lifetime will read from partial data.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": ""
          },
          "editorMode": "code",
          "expr": "100 * sum_over_time(hexworth_probe_up[24h]) / clamp_min(sum_over_time(hexworth_probe_checked[24h]), 1)",
          "legendFormat": "{{service}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 8,
        "minVizHeight": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "yellow",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
