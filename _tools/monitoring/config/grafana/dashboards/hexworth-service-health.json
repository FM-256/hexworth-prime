    },
    {
      "type": "timeseries",
      "title": "Probe latency",
      "description": "Rising latency is the warning that precedes an outage. keystone at 14ms is healthy; the same check at 8s means something is wrong before it fails.",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": ""
          },
          "editorMode": "code",
          "expr": "hexworth_probe_duration_seconds",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "title": "Probe freshness",
      "description": "Seconds since the probe last completed. SILENCE IS THE FAILURE MODE THIS PANEL EXISTS FOR: a monitor that stopped reporting looks exactly like a monitor reporting healthy. Cron runs every 2 min, so >300s means the probe itself is broken and nothing on this page can be trusted.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": ""
          },
          "editorMode": "code",
          "expr": "time() - hexworth_probe_last_run_timestamp_seconds",
          "legendFormat": "age",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 180
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ],
  "description": "Service-level view: does the platform WORK, not do the hosts ping. Built 2026-08-18 after two outages that every host-level check reported as healthy."
}