    {
      "type": "state-timeline",
      "title": "Service state over time",
      "description": "Green = up, red = down, purple = the probe could not check.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": ""
