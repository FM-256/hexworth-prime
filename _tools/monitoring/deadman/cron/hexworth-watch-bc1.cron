# /etc/cron.d/hexworth-watch-bc1 — MON-2 mutual dead-man's-switch (neon half).
# Reverse probe: neon watches bc1's liveness and alerts via neon's existing
# hexworth-alerts ntfy if bc1 goes dark. cron.d DROP-IN (not the user crontab).
# Deploy with:
#   sudo install -m 0644 hexworth-watch-bc1.cron /etc/cron.d/hexworth-watch-bc1
# Username field: eq. PATH set for cron's minimal environment.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/5 * * * * eq /home/eq/hexworth-watch-bc1/check-bc1.sh
