# /etc/cron.d/hexworth-deadman — MON-2 external dead-man's-switch (bc1 half).
# Installed as a cron.d DROP-IN, NOT into the user crontab, so it cannot disturb bc1's
# existing scraper-farm / nexus-scan / JunkTrunk crontab (Nancy #1). Deploy with:
#   sudo install -m 0644 hexworth-deadman.cron /etc/cron.d/hexworth-deadman
# cron.d lines require a username field (here: eq1). PATH set so curl/date resolve
# under cron's minimal environment.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/5 * * * * eq1 /home/eq1/hexworth-deadman/check-peer.sh
