// ============================================================
//  secrets.h — Operator Board (Phase 4: WiFiManager)
//
//  Most fields are OPTIONAL since Phase 4 — credentials are
//  provisioned at runtime via the captive portal and stored in
//  NVS (Preferences). This file only exists to override defaults
//  at compile time (useful for dev / pre-loading a known device).
//
//  COPY THIS FILE to secrets.h. secrets.h is gitignored.
//  An empty secrets.h is valid; the device will open the captive
//  portal on first boot to collect WiFi creds + Board ID.
// ============================================================
#pragma once

// ─── OPTIONAL: pre-load WiFi creds at compile time ────────────
// If both are defined, the device migrates them into NVS on first
// boot (one-time bootstrap). Subsequent boots use NVS regardless.
// Uncomment to use:
// #define WIFI_SSID       "your-2.4ghz-ssid"
// #define WIFI_PASSWORD   "your-password"

// ─── OPTIONAL: hardwired FALLBACK WiFi (always-on secondary) ──
// Unlike WIFI_SSID above (one-time NVS migration), this pair is
// registered with WiFiMulti at EVERY boot as a secondary AP. The
// device will roam to whichever of the primary (NVS) or fallback
// network has the strongest signal. Useful for boards that move
// between a home/lab network and a classroom network.
// Uncomment to use:
// #define FALLBACK_WIFI_SSID      "ClassroomNetwork"
// #define FALLBACK_WIFI_PASSWORD  "classroom-password"

// ─── OPTIONAL: default Board ID for compile-time migration ────
// Used only when WIFI_SSID/WIFI_PASSWORD are defined and NVS is
// empty. Has no effect once the device is provisioned via portal.
// #define DEFAULT_BOARD_ID "room-214"

// ─── OPTIONAL: Cloud Function URL override ────────────────────
// Default is the production hexworth-prime CF — override only if
// you're pointing the device at a staging/preview endpoint.
// #define BOARD_URL "https://us-central1-hexworth-prime.cloudfunctions.net/operatorBoard"

// ─── OPTIONAL: refresh cadence (minutes) ──────────────────────
// Default 15. Lower values increase battery drain (negligible on USB).
// #define REFRESH_MINUTES 15
