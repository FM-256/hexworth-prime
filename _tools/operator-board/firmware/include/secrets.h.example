// Example: https://us-central1-hexworth-prime.cloudfunctions.net/operatorBoard
#define BOARD_URL       "https://us-central1-hexworth-prime.cloudfunctions.net/operatorBoard"

// Refresh cadence (minutes between full screen redraws)
#define REFRESH_MINUTES 15
