#!/bin/bash
# hexpractice — a guided-but-open practice menu for the Hexworth Linux Practice
# Sandbox. Prints categories of real things to try with runnable example
# commands (against the ~/playground starter files). No grading, no lock-in —
# it just gives an open shell a sense of direction. `hexpractice <topic>` jumps
# to one category; bare `hexpractice` lists them all.

C_H='\033[1;36m'; C_T='\033[1;33m'; C_C='\033[0;32m'; C_D='\033[2m'; C_R='\033[0m'

# Print one category: a titled block of "try this" example commands.
topic() {
    printf "${C_T}%s${C_R}\n" "$1"; shift
    for line in "$@"; do printf "  ${C_C}%s${C_R}\n" "$line"; done
    printf "\n"
}

# Print the header + how-to-use line shown above the full topic list.
banner() {
    printf "\n${C_H}HEXWORTH LINUX PRACTICE: things to try${C_R}\n"
    printf "${C_D}Run any line below. Everything is safe to break; relaunch resets the box.${C_R}\n"
    printf "${C_D}Jump to one topic: hexpractice files | perms | text | procs | net | script | git${C_R}\n\n"
}

# Filesystem navigation + copy/inspect drills against the ~/playground tree.
t_files() {
    topic "FILES & NAVIGATION" \
        "cd ~/playground && ls -la" \
        "tree ~/playground" \
        "find ~/playground -name '*.log'" \
        "cp data/users.csv data/users.bak && diff data/users.csv data/users.bak" \
        "du -sh ~/playground/* && ncdu ~/playground"
}
# Permission + ownership drills (chmod/chown/stat/umask).
t_perms() {
    topic "PERMISSIONS & OWNERSHIP" \
        "touch secret.txt && chmod 600 secret.txt && ls -l secret.txt" \
        "chmod u+x,go-rwx secret.txt && stat secret.txt" \
        "sudo chown root:root secret.txt && ls -l secret.txt   # then try to edit it" \
        "umask   # see your default creation mask"
}
# Text-processing drills (grep/awk/sed/cut) on the sample log + CSV.
t_text() {
    topic "TEXT PROCESSING" \
        "cat playground/logs/app.log" \
        "grep ERROR playground/logs/app.log" \
        "awk -F, 'NR>1 {print \$1}' playground/data/users.csv" \
        "sed 's/admin/ADMIN/' playground/data/users.csv" \
        "cut -d, -f2 playground/data/users.csv | sort | uniq -c"
}
# Process + service drills (ps/htop/jobs/kill, systemctl via the shim).
t_procs() {
    topic "PROCESSES & SERVICES" \
        "ps aux | head" \
        "htop           # q to quit" \
        "sleep 300 & jobs -l && kill %1" \
        "sudo systemctl start cron && systemctl status cron"
}
# Networking inspection drills (ip/ping/curl/ss).
t_net() {
    topic "NETWORKING" \
        "ip addr" \
        "ping -c 3 127.0.0.1" \
        "curl -s https://example.com | head" \
        "ss -tulpn 2>/dev/null || netstat -tulpn"
}
# Shell-scripting + Python/sqlite drills.
t_script() {
    topic "SHELL SCRIPTING & PYTHON" \
        "for f in playground/logs/*.log; do echo \"== \$f ==\"; wc -l \"\$f\"; done" \
        "printf '#!/bin/bash\\necho hello \$USER\\n' > hi.sh && chmod +x hi.sh && ./hi.sh" \
        "python3 -c 'print(sum(range(101)))'" \
        "sqlite3 :memory: 'select 2+2;'"
}
# Version-control drills (git init/add/commit/log).
t_git() {
    topic "VERSION CONTROL" \
        "mkdir demo && cd demo && git init" \
        "git config user.email you@hexworth.com && git config user.name you" \
        "echo hi > a.txt && git add a.txt && git commit -m first" \
        "git log --oneline"
}

# The five graded challenges. Do them all in ~/work, then click "Grade my practice"
# in the Observatory to earn the Linux Practitioner badge. (Grading is server-verified.)
t_challenge() {
    printf "\n${C_H}GRADED CHALLENGES${C_R}  ${C_D}(do these in ~/work, then click 'Grade my practice' in the Observatory)${C_R}\n\n"
    printf "  ${C_T}1.${C_R} Put the word \"hexworth\" into ${C_C}~/work/hello.txt${C_R}\n"
    printf "  ${C_T}2.${C_R} Make ${C_C}~/work/greet.sh${C_R} executable and have it print a greeting\n"
    printf "  ${C_T}3.${C_R} Lock ${C_C}~/work/secret.txt${C_R} down to mode ${C_C}600${C_R}\n"
    printf "  ${C_T}4.${C_R} Save the ERROR lines from ${C_C}~/playground/logs/app.log${C_R} into ${C_C}~/work/found.txt${C_R}\n"
    printf "  ${C_T}5.${C_R} Turn ${C_C}~/work${C_R} into a git repo with at least one commit\n\n"
    printf "  ${C_D}Check your progress anytime: ${C_R}${C_C}hexpractice check${C_R}\n\n"
}

# Local self-check preview of the graded challenges. The OFFICIAL, badge-awarding
# grade is server-verified in the Observatory ("Grade my practice"); this is just
# immediate terminal feedback so a learner can see where they stand.
do_check() {
    local W="$HOME/work" p=0
    chk() { if eval "$2" >/dev/null 2>&1; then printf "  ${C_C}PASS${C_R}  %s\n" "$1"; p=$((p+1)); else printf "  FAIL  %s\n" "$1"; fi; }
    printf "\n${C_H}SELF-CHECK${C_R} ${C_D}(preview; official grading is in the Observatory)${C_R}\n\n"
    chk "1. ~/work/hello.txt contains \"hexworth\"" '[ -f "$W/hello.txt" ] && grep -qi hexworth "$W/hello.txt"'
    chk "2. ~/work/greet.sh executable and prints output" '[ -x "$W/greet.sh" ] && [ -n "$("$W/greet.sh" 2>/dev/null)" ]'
    chk "3. ~/work/secret.txt is mode 600" '[ "$(stat -c %a "$W/secret.txt" 2>/dev/null)" = "600" ]'
    chk "4. ~/work/found.txt has the ERROR log lines" 'grep -q ERROR "$W/found.txt" 2>/dev/null'
    chk "5. ~/work is a git repo with >=1 commit" 'git -C "$W" rev-parse HEAD >/dev/null 2>&1'
    printf "\n  ${C_T}%d/5${C_R} complete. %s\n\n" "$p" "$([ $p -eq 5 ] && echo 'All done! Claim your badge in the Observatory.' || echo 'Keep going.')"
}

# Dispatch: a topic keyword shows one category; 'challenge'/'check' drive the graded
# challenges; no arg (or unknown) shows all topics.
case "${1:-all}" in
    files)  t_files ;;
    perms)  t_perms ;;
    text)   t_text ;;
    procs)  t_procs ;;
    net)    t_net ;;
    script) t_script ;;
    git)    t_git ;;
    challenge|challenges) t_challenge ;;
    check)  do_check ;;
    all|*)  banner; t_files; t_perms; t_text; t_procs; t_net; t_script; t_git
            printf "${C_T}EARN A BADGE:${C_R} run ${C_C}hexpractice challenge${C_R} for the 5 graded tasks, ${C_C}hexpractice check${C_R} to see progress.\n"
            printf "${C_D}Tip: 'man <command>' explains any command. 'hexpractice text' focuses one topic.${C_R}\n\n" ;;
esac
