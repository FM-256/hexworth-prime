// ============================================================
//  secrets.h — OPTIONAL compile-time overrides
//
//  Copy this file to secrets.h (gitignored). All fields are
//  optional — an empty secrets.h is valid. Runtime provisioning
//  via the WiFiManager captive portal takes precedence over any
//  values defined here.
//
//  Useful for:
//   - Bootstrapping an already-deployed device that you can't
//     physically access (compile-in current network, deploy
//     once, re-pair from the captive portal next time).
//   - Bench-testing without needing to walk through the portal
//     every time you erase NVS.
// ============================================================
#pragma once

// Pre-load WiFi creds on first boot. Migrated into NVS once and
// then never re-read.
// #define WIFI_SSID       "your-2.4ghz-ssid"
// #define WIFI_PASSWORD   "your-password"

// Pre-load device identity on first boot.
// #define DEFAULT_DEVICE_ID "device-001"

// Optional Cloud Function or backend base URL. Used if your app
// fetches state from a remote.
// #define APP_BASE_URL    "https://us-central1-hexworth-prime.cloudfunctions.net/myEndpoint"

// Optional app refresh cadence (minutes) — used by the example loop.
// #define REFRESH_MINUTES 15
