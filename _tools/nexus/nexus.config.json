{
    "version": 1,
    "spokes": {
        "eduscan": {
            "adapter": "./adapters/eduscan.js",
            "dataPath": "../reports/TREASURE_MAP.json",
            "enabled": true
        },
        "sprint": {
            "adapter": "./adapters/sprint-master.js",
            "dataPath": "../sprint-master/sprints.json",
            "enabled": true
        },
        "hed": {
            "adapter": "./adapters/hed.js",
            "dataPath": "hed-export.json",
            "enabled": true
        },
        "audit": {
            "adapter": "./adapters/audit.js",
            "dataPath": "../../_planning/reports",
            "enabled": true
        },
        "spellbook": {
            "adapter": "./adapters/spellbook.js",
            "dataPath": "../../_spellbook/spells",
            "enabled": true
        },
        "todo": {
            "adapter": "./adapters/todo.js",
            "dataPath": "~/.todo-data.json",
            "enabled": true
        },
        "hexcontent": {
            "adapter": "./adapters/hexcontent.js",
            "dataPath": "cache/hexcontent-state.json",
            "enabled": true
        },
        "functions": {
            "adapter": "./adapters/functions.js",
            "dataPath": "../../functions",
            "enabled": true
        },
        "history": {
            "adapter": "./adapters/scan-history.js",
            "dataPath": "../../_tools/reports/history",
            "enabled": true,
            "autoSave": true
        },
        "deploy-check": {
            "adapter": "./adapters/deploy-check.js",
            "dataPath": "../../_tools/reports",
            "enabled": true
        },
        "quiz-report": {
            "adapter": "./adapters/quiz-report.js",
            "dataPath": "../../functions/quiz_keys.json",
            "enabled": true
        },
        "quiz-sync": {
            "adapter": "./adapters/quiz-sync.js",
            "dataPath": "../../functions/quiz_keys.json",
            "enabled": true
        },
        "quiz-key-callsite": {
            "adapter": "./adapters/quiz-key-callsite.js",
            "dataPath": "../../functions/quiz_keys.json",
            "enabled": true
        },
        "dead-code": {
            "adapter": "./adapters/dead-code.js",
            "dataPath": "../../_app/components",
            "enabled": true
        },
        "auto-fix": {
            "adapter": "./adapters/auto-fix.js",
            "dataPath": "../../_app",
            "enabled": true
        },
        "changelog": {
            "adapter": "./adapters/changelog.js",
            "dataPath": ".",
            "enabled": true
        },
        "smoke-test": {
            "adapter": "./adapters/smoke-test.js",
            "dataPath": ".",
            "enabled": true
        }
    },
    "pull": {
        "hed": {
            "url": "https://us-central1-hexworth-prime.cloudfunctions.net/getHedExport"
        }
    },
    "gate": {
        "failOn": ["critical"],
        "sources": ["eduscan", "hed", "audit", "functions"]
    },
    "pipes": {
        "hed-github": {
            "source": "hed",
            "target": "github",
            "threshold": 3,
            "labels": ["bug", "hed-auto"]
        }
    }
}
