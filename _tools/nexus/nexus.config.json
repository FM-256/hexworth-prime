{
    "version": 1,
    "spokes": {
        "eduscan": {
            "adapter": "./adapters/eduscan.js",
            "dataPath": "../reports/TREASURE_MAP.json",
            "enabled": true
        },
        "sprint": {
            "adapter": "./adapters/sprint-master.js",
            "dataPath": "../sprint-master/sprints.json",
            "enabled": true
        },
        "hed": {
            "adapter": "./adapters/hed.js",
            "dataPath": "hed-export.json",
            "enabled": true
        },
        "audit": {
            "adapter": "./adapters/audit.js",
            "dataPath": "../../_planning/reports",
            "enabled": true
        },
        "spellbook": {
            "adapter": "./adapters/spellbook.js",
            "dataPath": "../../_spellbook/spells",
            "enabled": true
        },
        "todo": {
            "adapter": "./adapters/todo.js",
            "dataPath": "~/.todo-data.json",
            "enabled": true
        },
        "hexcontent": {
            "adapter": "./adapters/hexcontent.js",
            "dataPath": "cache/hexcontent-state.json",
            "enabled": true
        }
    },
    "pull": {
        "hed": {
            "url": "https://us-central1-hexworth-prime.cloudfunctions.net/getHedExport"
        }
    },
    "gate": {
        "failOn": ["critical"],
        "sources": ["eduscan", "hed", "audit"]
    },
    "pipes": {
        "hed-github": {
            "source": "hed",
            "target": "github",
            "threshold": 3,
            "labels": ["bug", "hed-auto"]
        }
    }
}
