// ============================================================
//  secrets.h — OPTIONAL compile-time overrides for the C2 device.
//
//  All fields are optional. Runtime values from the WiFiManager
//  captive portal + c2Register response take precedence after the
//  first successful boot.
// ============================================================
#pragma once

// Pre-load WiFi creds on first boot (migrated to NVS once).
// #define WIFI_SSID       "your-2.4ghz-ssid"
// #define WIFI_PASSWORD   "your-password"

// Pre-load a device name (e.g. "lab-c2-01"). If unset the captive
// portal asks for it; if portal is skipped, falls back to a MAC tail.
// #define DEFAULT_DEVICE_NAME "lab-c2-01"

// Override the C2 backend URL (e.g. for a staging deploy).
// Default: production https://us-central1-hexworth-prime.cloudfunctions.net
// #define C2_BASE_URL "https://us-central1-hexworth-prime.cloudfunctions.net"

// OPTIONAL pre-staged pairing code. If set, the device uses the
// authenticated /c2RegisterWithCode endpoint (KBA #11) on first boot
// instead of the legacy open /c2Register. Single-use — cleared from
// NVS after the first successful registration.
// #define PAIRING_CODE "HEX-PAIR-XK7A2P"
