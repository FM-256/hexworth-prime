# OpenStack Stage 3 claim service -- systemd unit for bc2.
# Install:  sudo cp openstack-bridge.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now openstack-bridge
# Nancy precondition 5: Restart=always so the process holding claim+reconcile paths
# never stays dead after a crash.
[Unit]
Description=Hexworth OpenStack Stage 3 claim service
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=eq1
ExecStart=/usr/bin/python3 /home/eq1/openstack-stage1/claim_service.py
Restart=always
RestartSec=3
# The service refuses to start if its three 0600 stores are missing or too open;
# that startup check is in claim_service.py itself.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
