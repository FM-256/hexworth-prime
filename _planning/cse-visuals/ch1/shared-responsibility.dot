/*
 * CSE companion deck -- CH1 "Shared responsibility: the one diagram that runs the course"
 * PROOF ARTIFACT, Graphviz route (s4 Topological / pure-structure row).
 *
 * Why dot and not fal.ai: four Imagen 3 generations could not hold the one thing this
 * slide teaches -- the boundary's POSITION differing across three stacks. That is a
 * layout constraint, not a style prior. dot solves layout; labels render in real system
 * fonts so they cannot garble.
 *
 * Palette matches the deck (dark navy ground, blue = customer, amber = provider,
 * emerald = the band that never moves).
 *
 * RENDER (deliberate divergence from the standard's s9.1 canonical command):
 *     dot -Tpng -Gdpi=192 shared-responsibility.dot -o out.png
 *     then Pillow -> webp quality 92 method 6
 *
 * s9.1 canonicalises `-Gsize=12.8,7.2! -Gratio=fill -Gdpi=130`, which forces a 16:9
 * canvas. That is right for wide topology graphs. It is WRONG here: this graph is a
 * tall stacked grid (5 rows + legend), and ratio=fill would stretch the rows to pack
 * a 16:9 box, distorting the tier heights -- and the tiers being visually equal is
 * what makes the colour handover readable across columns. Auto-sizing yields 1.35:1,
 * close to the 1.4:1 of the SVG it replaces, so it drops into the existing .viz
 * container without re-tuning it.
 *
 * s9.1 also requires `git add -f` for anything under _planning/ (the directory is
 * gitignored). This file was force-added; do the same for any CSE sibling.
 *
 * OPERATOR SIGN-OFF (s3.1): "for this specific slide, b works, but it is very slide
 * specific" -- 2026-08-03. Scope is THIS slide only. It does not authorise Graphviz
 * for the other CSE visuals; each needs its own proof and its own sign-off.
 */
digraph shared_responsibility {
  bgcolor    = "#0b1220";
  rankdir    = TB;
  newrank    = true;
  splines    = false;
  nodesep    = 0.16;
  ranksep    = 0.16;
  margin     = 0.12;
  fontname   = "DejaVu Sans";

  node [shape=box, style="filled", fontname="DejaVu Sans", fontsize=15,
        width=2.35, height=0.62, fixedsize=true, penwidth=2];
  edge [style=invis];

  /* ---- column headings ------------------------------------------------ */
  node [shape=plaintext, style="", fillcolor="", fontcolor="#93c5fd",
        fontsize=19, height=0.42, penwidth=0];
  h_iaas [label="IaaS"];
  h_paas [label="PaaS"];
  h_saas [label="SaaS"];
  { rank=same; h_iaas; h_paas; h_saas; }

  /* ---- tiers ----------------------------------------------------------
     CUSTOMER = blue, PROVIDER = amber. Reading across a row shows the
     handover point moving left-to-right; that motion is the lesson.       */
  node [shape=box, style="filled", fontsize=15, height=0.62, penwidth=2];

  /* Application tier */
  a_iaas [label="Application", fillcolor="#1e3a5f", color="#7aa2ff", fontcolor="#e6edf3"];
  a_paas [label="Application", fillcolor="#1e3a5f", color="#7aa2ff", fontcolor="#e6edf3"];
  a_saas [label="Application", fillcolor="#3b2f10", color="#ffd86b", fontcolor="#ffd86b"];
  { rank=same; a_iaas; a_paas; a_saas; }

  /* Runtime tier */
  r_iaas [label="Runtime",     fillcolor="#1e3a5f", color="#7aa2ff", fontcolor="#e6edf3"];
  r_paas [label="Runtime",     fillcolor="#3b2f10", color="#ffd86b", fontcolor="#ffd86b"];
  r_saas [label="Runtime",     fillcolor="#3b2f10", color="#ffd86b", fontcolor="#ffd86b"];
  { rank=same; r_iaas; r_paas; r_saas; }

  /* OS tier */
  o_iaas [label="Operating system", fillcolor="#1e3a5f", color="#7aa2ff", fontcolor="#e6edf3"];
  o_paas [label="Operating system", fillcolor="#3b2f10", color="#ffd86b", fontcolor="#ffd86b"];
  o_saas [label="Operating system", fillcolor="#3b2f10", color="#ffd86b", fontcolor="#ffd86b"];
  { rank=same; o_iaas; o_paas; o_saas; }

  /* Infrastructure -- provider's in every column, so one spanning bar */
  infra [label="Hypervisor  ·  hardware  ·  facility  ·  network fabric",
         fillcolor="#3b2f10", color="#ffd86b", fontcolor="#ffd86b",
         width=7.35, height=0.62];

  /* The band that never moves */
  /* A <br/> between the two lines centres each on its own text width, not on the
     node -- the second line drifts right. A single-column table centres both. */
  always [label=<<table border="0" cellborder="0" cellspacing="1" cellpadding="0">
            <tr><td align="center"><b>ALWAYS YOURS &#8212; in every column</b></td></tr>
            <tr><td align="center"><font point-size="15">identity &#183; data &#183; configuration</font></td></tr>
          </table>>,
          fillcolor="#14532d", color="#4ade80", fontcolor="#86efac",
          width=7.35, height=0.92, penwidth=3];

  /* stack the columns */
  h_iaas -> a_iaas -> r_iaas -> o_iaas;
  h_paas -> a_paas -> r_paas -> o_paas;
  h_saas -> a_saas -> r_saas -> o_saas;
  o_iaas -> infra; o_paas -> infra; o_saas -> infra;
  infra  -> always;

  /* legend -- fixedsize must be off here: the HTML-like label sizes itself, and
     inheriting the tier nodes' fixed 2.35x0.62 box clips it (dot warns
     "size too small for label" and the swatches spill). */
  node [shape=plaintext, style="", fillcolor="", fontsize=14, penwidth=0,
        fixedsize=false, width=0, height=0];
  legend [label=<<table border="0" cellborder="0" cellspacing="6">
      <tr>
        <td bgcolor="#1e3a5f" width="20"> </td>
        <td><font color="#94a3b8">yours to secure</font></td>
        <td width="24"> </td>
        <td bgcolor="#3b2f10" width="20"> </td>
        <td><font color="#94a3b8">the provider's</font></td>
      </tr></table>>];
  always -> legend;
}
