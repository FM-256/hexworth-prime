/*
 * CSE companion deck -- CH4 "Key management is the actual subject"
 *
 * Route: s4 process flow with a fixed order. Envelope encryption is a chain where the
 * ORDER and the CONTAINMENT are the lesson (the data key is wrapped by a master key
 * that never leaves the key service). Illustration cannot be trusted to keep a chain
 * in order; dot can.
 *
 * The teaching payload is the last edge: disable the master key and every object
 * encrypted under it becomes unreadable at once, with no terabytes re-encrypted.
 * That is why rotation and revocation are key-service operations.
 *
 * Anchors: 5 (data, data key, master key, key service, the kill switch).
 *
 * RENDER: dot -Tpng -Gdpi=192 envelope-encryption.dot -o out.png  then Pillow -> webp q92
 * _planning/ is gitignored -- `git add -f`.
 */
digraph envelope_encryption {
  bgcolor  = "#0b1220";
  /* ASPECT IS A CORRECTNESS CONSTRAINT HERE, not taste. Two failed shapes:
       rankdir=LR  -> 9.6:1, an unreadable strip.
       rankdir=TB with all four links stacked -> 990x1075 (0.92, portrait). At 560px
         panel width that renders 608px tall inside a ~437px panel and CLIPPED the
         diagram's top border and its entire caption at 1024x600 and 1280x720.
         The `.slide-visual` scroll hid it instead of showing a visible break.
       Fix: keep TB but put `data` and `data key` on the SAME rank so the chain folds
       into three ranks instead of four -- wider, shorter, and it fits. Every other
       visual in this deck is landscape (1.19 to 1.83); this one must be too. */
  rankdir  = TB;
  compound = true;
  fontname = "DejaVu Sans";
  nodesep  = 0.34;
  ranksep  = 0.5;
  margin   = 0.14;

  node [shape=box, style="filled,rounded", fontname="DejaVu Sans", fontsize=14,
        penwidth=2, margin="0.24,0.15"];
  edge [fontname="DejaVu Sans", fontsize=12, penwidth=2, arrowsize=0.85];

  data [label="your data\nobjects, volumes, backups",
        fillcolor="#1e3a5f", color="#7aa2ff", fontcolor="#e6edf3"];

  dek  [label="data key\nencrypts the bytes",
        fillcolor="#14532d", color="#4ade80", fontcolor="#86efac"];

  subgraph cluster_kms {
    label     = "KEY SERVICE  ·  the master key never leaves";
    fontcolor = "#ffd86b";
    fontsize  = 14;
    color     = "#ffd86b";
    style     = "rounded";
    penwidth  = 2;
    margin    = 16;

    cmk [label="master key",
         fillcolor="#3b2f10", color="#ffd86b", fontcolor="#ffd86b"];
  }

  /* Fold the first link onto one rank -- this is what keeps the render landscape. */
  { rank=same; data; dek; }
  data -> dek [label="  encrypted by  ", color="#7aa2ff", fontcolor="#93c5fd"];
  dek  -> cmk [label="  wrapped by  ", color="#4ade80", fontcolor="#86efac",
               lhead="cluster_kms"];

  /* The kill switch -- the sentence the whole slide exists to deliver. */
  kill [label="Disable the master key and every object\nencrypted under it is unreadable at once.\nNo terabytes re-encrypted.",
        shape=box, style="filled,rounded", fillcolor="#2a1519",
        color="#ff6b6b", fontcolor="#fca5a5", fontsize=13, penwidth=2];
  cmk -> kill [color="#ff6b6b", style=dashed, arrowhead=vee,
               ltail="cluster_kms"];
}
