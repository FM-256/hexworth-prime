/*
 * CSE companion deck -- CH7 "Three kinds of telemetry, three different questions"
 *
 * REPLACES a hand-authored CSS terminal that showed a FABRICATED CloudTrail-style audit
 * line. Two problems with that: (1) s5 bans hand-composed text-in-a-styled-box
 * regardless of format -- it is the same shape as the rich-render batch the operator
 * killed; (2) it presented invented output as authentic tool output, which is a
 * factual-accuracy problem on top of the register one. No scanner or cloud CLI is
 * available on the build host, so a real recorded capture was not possible.
 *
 * Route: s4 "structural reference" -- a field layout, which is exactly what dot's
 * record shape exists for. This is the ONE case the standard reserves for explicit
 * positional control.
 *
 * The teaching payload: an audit record answers five questions, and it is only worth
 * anything if all three of enabled/retained/tamper-proof hold.
 *
 * RENDER: dot -Tpng -Gdpi=192 audit-record.dot -o out.png  then Pillow -> webp q92
 * _planning/ is gitignored -- `git add -f`.
 */
digraph audit_record {
  bgcolor  = "#0b1220";
  rankdir  = TB;
  fontname = "DejaVu Sans";
  nodesep  = 0.26;
  ranksep  = 0.34;
  margin   = 0.14;

  node [fontname="DejaVu Sans", penwidth=2];
  edge [penwidth=2, arrowsize=0.8];

  title [shape=plaintext, fontcolor="#93c5fd", fontsize=16,
         label="One audit record answers five questions"];

  /* The record itself. Each cell is a field; the row beneath names the question it
     answers, so the student reads the mapping rather than memorising field names. */
  rec [shape=plaintext, label=<
    <table border="0" cellborder="2" cellspacing="0" cellpadding="9" color="#4ade80">
      <tr>
        <td bgcolor="#14532d"><font color="#86efac" point-size="14"><b>identity</b></font></td>
        <td bgcolor="#14532d"><font color="#86efac" point-size="14"><b>action</b></font></td>
        <td bgcolor="#14532d"><font color="#86efac" point-size="14"><b>resource</b></font></td>
        <td bgcolor="#14532d"><font color="#86efac" point-size="14"><b>timestamp</b></font></td>
        <td bgcolor="#14532d"><font color="#86efac" point-size="14"><b>source</b></font></td>
      </tr>
      <tr>
        <td bgcolor="#101a2b"><font color="#cbd5e1" point-size="12">who</font></td>
        <td bgcolor="#101a2b"><font color="#cbd5e1" point-size="12">did what</font></td>
        <td bgcolor="#101a2b"><font color="#cbd5e1" point-size="12">to which thing</font></td>
        <td bgcolor="#101a2b"><font color="#cbd5e1" point-size="12">when</font></td>
        <td bgcolor="#101a2b"><font color="#cbd5e1" point-size="12">from where</font></td>
      </tr>
    </table>>];

  claim [shape=box, style="filled,rounded", fillcolor="#132033", color="#93c5fd",
         fontcolor="#93c5fd", fontsize=13,
         label="Every control-plane call, recorded by default.\nOn-prem never had this."];

  /* The three conditions -- all three fail quietly, which is the warning. */
  c1 [shape=box, style="filled,rounded", fillcolor="#3b2f10", color="#ffd86b",
      fontcolor="#ffd86b", fontsize=12.5, label="enabled\neverywhere"];
  c2 [shape=box, style="filled,rounded", fillcolor="#3b2f10", color="#ffd86b",
      fontcolor="#ffd86b", fontsize=12.5, label="retained\nlong enough"];
  c3 [shape=box, style="filled,rounded", fillcolor="#3b2f10", color="#ffd86b",
      fontcolor="#ffd86b", fontsize=12.5, label="written where the\nattacker cannot edit"];
  { rank=same; c1; c2; c3; }

  warn [shape=box, style="filled,rounded", fillcolor="#2a1519", color="#ff6b6b",
        fontcolor="#fca5a5", fontsize=13,
        label="All three fail silently.\nNothing alerts you that the log was never on."];

  title -> rec   [style=invis];
  rec   -> claim [style=invis];
  claim -> c1 [color="#ffd86b"];
  claim -> c2 [color="#ffd86b"];
  claim -> c3 [color="#ffd86b"];
  c1 -> warn [color="#ff6b6b", style=dashed, arrowhead=none];
  c2 -> warn [color="#ff6b6b", style=dashed, arrowhead=none];
  c3 -> warn [color="#ff6b6b", style=dashed, arrowhead=none];
}
