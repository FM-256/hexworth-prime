/*
 * CSE companion deck -- CH8 "Risk is a sentence, not a colour"
 *
 * Route: s4 structural. The slide's claim is about ORDER OF DERIVATION -- four inputs
 * make a statement, the statement earns a rating, and only then do you choose a
 * response. Students start at the colour. A diagram whose arrows only run one way is
 * the argument; an illustrated scene cannot enforce direction.
 *
 * Anchors: threat/vulnerability/asset/likelihood+impact -> statement -> rating -> four
 * responses.
 *
 * The "accept" node is deliberately coloured like the others, not red. The slide's
 * point is that accept is a legitimate engineering decision, not a failure -- colouring
 * it as a warning would teach the opposite of the text.
 *
 * RENDER: dot -Tpng -Gdpi=192 risk-anatomy.dot -o out.png  then Pillow -> webp q92
 * _planning/ is gitignored -- `git add -f`.
 */
digraph risk_anatomy {
  bgcolor  = "#0b1220";
  rankdir  = TB;
  fontname = "DejaVu Sans";
  nodesep  = 0.22;
  ranksep  = 0.4;
  margin   = 0.14;

  node [shape=box, style="filled,rounded", fontname="DejaVu Sans", fontsize=13,
        penwidth=2, margin="0.18,0.11"];
  edge [fontname="DejaVu Sans", fontsize=11, penwidth=2, arrowsize=0.8,
        color="#7aa2ff"];

  /* --- the four inputs -------------------------------------------------- */
  threat [label="a threat actor", fillcolor="#1e3a5f", color="#7aa2ff", fontcolor="#e6edf3"];
  vuln   [label="exploits a weakness", fillcolor="#1e3a5f", color="#7aa2ff", fontcolor="#e6edf3"];
  asset  [label="against an asset", fillcolor="#1e3a5f", color="#7aa2ff", fontcolor="#e6edf3"];
  li     [label="with some likelihood\nand some impact", fillcolor="#1e3a5f", color="#7aa2ff", fontcolor="#e6edf3"];
  { rank=same; threat; vuln; asset; li; }

  /* --- the sentence ----------------------------------------------------- */
  stmt [label="THE RISK STATEMENT\nmiss any part and you cannot decide anything",
        fillcolor="#14532d", color="#4ade80", fontcolor="#86efac", fontsize=14,
        penwidth=3];

  threat -> stmt; vuln -> stmt; asset -> stmt; li -> stmt;

  /* --- the rating, which is an OUTPUT ----------------------------------- */
  rating [label="the rating\nan output — never the starting point",
          fillcolor="#3b2f10", color="#ffd86b", fontcolor="#ffd86b", fontsize=14];
  stmt -> rating [label="  earns  ", color="#4ade80", fontcolor="#86efac"];

  /* --- the four responses ----------------------------------------------- */
  mit [label="mitigate",  fillcolor="#16273f", color="#7aa2ff", fontcolor="#cbd5e1"];
  tra [label="transfer",  fillcolor="#16273f", color="#7aa2ff", fontcolor="#cbd5e1"];
  avo [label="avoid",     fillcolor="#16273f", color="#7aa2ff", fontcolor="#cbd5e1"];
  acc [label="accept\ndocumented · owned · revisited",
       fillcolor="#16273f", color="#7aa2ff", fontcolor="#cbd5e1"];
  { rank=same; mit; tra; avo; acc; }

  rating -> mit [color="#ffd86b"];
  rating -> tra [color="#ffd86b"];
  rating -> avo [color="#ffd86b"];
  rating -> acc [color="#ffd86b"];

  note [label="Accept is a decision someone with authority made.\nIt is not the absence of one.",
        shape=box, style="filled,rounded", fillcolor="#132033",
        color="#93c5fd", fontcolor="#93c5fd", fontsize=12.5, penwidth=2];
  acc -> note [style=invis];
}
