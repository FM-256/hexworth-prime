title: RDS Architecture {
  shape: text
  style: {
    font-size: 32
    bold: true
    fill: white
  }
  near: top-center
}
subtitle: Remote Desktop Services — connection flow {
  shape: text
  style: {
    font-size: 13
    fill: "#9ca3af"
  }
  near: top-center
}

direction: down

client: Client\n(laptop / browser) {
  style: { fill: "#1f6feb"; stroke: white; font-color: white; border-radius: 8 }
}

webaccess: RD Web Access\nbrowser portal {
  style: { fill: "#facc15"; stroke: white; font-color: "#0c1a2e"; border-radius: 8 }
}
gateway: RD Gateway\nTLS terminator {
  style: { fill: "#d97706"; stroke: white; font-color: "#0c1a2e"; border-radius: 8 }
}

broker: Connection Broker\norchestrates sessions {
  style: { fill: "#7c3aed"; stroke: white; font-color: white; border-radius: 8 }
}

rdsh: RD Session Host (RDSH)\nshared desktop sessions {
  style: { fill: "#16a34a"; stroke: white; font-color: white; border-radius: 8 }
}
vdi: RD Virtualization Host\nVDI on Hyper-V {
  style: { fill: "#0891b2"; stroke: white; font-color: white; border-radius: 8 }
}

licsrv: License Server\nCAL store {
  style: { fill: "#dc2626"; stroke: white; font-color: white; border-radius: 8 }
}

client -> gateway: "① RDP-over-HTTPS\n  port 443" { style.stroke: "#7aa2ff" }
client -> webaccess: "② browser\n  RemoteApp feed" { style.stroke-dash: 5; style.stroke: "#7aa2ff" }
gateway -> broker: "③ RDP 3389" { style.stroke: "#7aa2ff" }
webaccess -> broker: "launch" { style.stroke-dash: 5; style.stroke: "#7aa2ff" }
broker -> rdsh: "④ dispatch session" { style.stroke: "#7aa2ff" }
broker -> vdi: "④ dispatch VM" { style.stroke-dash: 5; style.stroke: "#7aa2ff" }
rdsh -> licsrv: "⑤ CAL query" { style.stroke: "#f97316" }
vdi -> licsrv: "⑤ CAL query" { style.stroke-dash: 5; style.stroke: "#f97316" }
