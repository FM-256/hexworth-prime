---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryColor: '#1f2937'
    primaryTextColor: '#ffffff'
    primaryBorderColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TD
    Client["Client<br/>laptop / browser"]:::client
    Gateway["RD Gateway<br/>TLS terminator"]:::gateway
    WebAccess["RD Web Access<br/>browser portal"]:::webaccess
    Broker["Connection Broker<br/>orchestrates sessions"]:::broker
    RDSH["RD Session Host (RDSH)<br/>shared desktop sessions"]:::rdsh
    VDI["RD Virtualization Host<br/>VDI on Hyper-V"]:::vdi
    LicSrv["License Server<br/>CAL store"]:::licsrv

    Client -- "① RDP-over-HTTPS, port 443" --> Gateway
    Client -. "② browser, RemoteApp feed" .-> WebAccess
    Gateway -- "③ RDP 3389" --> Broker
    WebAccess -. "launch" .-> Broker
    Broker -- "④ dispatch session" --> RDSH
    Broker -. "④ dispatch VM" .-> VDI
    RDSH -- "⑤ CAL query" --> LicSrv
    VDI -. "⑤ CAL query" .-> LicSrv

    classDef client    fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef gateway   fill:#d97706,color:#0c1a2e,stroke:#fff,stroke-width:2px
    classDef webaccess fill:#facc15,color:#0c1a2e,stroke:#fff,stroke-width:2px
    classDef broker    fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef rdsh      fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef vdi       fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef licsrv    fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
