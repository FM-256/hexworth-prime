digraph rds_architecture {
    rankdir=TB;
    bgcolor="#0c1a2e";
    fontname="Inter";
    pad=0.6;
    nodesep=0.6;
    ranksep=0.9;
    labelloc=t;
    label=<<FONT POINT-SIZE="32" COLOR="white"><B>RDS Architecture</B></FONT><BR/><FONT POINT-SIZE="14" COLOR="#9ca3af">Remote Desktop Services — connection flow</FONT>>;
    fontcolor=white;

    node [
        shape=box,
        style="rounded,filled",
        fontname="Inter",
        fontsize=15,
        fontcolor="#ffffff",
        color="#ffffff",
        penwidth=2,
        margin="0.25,0.18"
    ];
    edge [
        fontname="Inter",
        fontsize=12,
        fontcolor="#ffd86b",
        color="#7aa2ff",
        penwidth=2,
        arrowsize=1.0
    ];

    // Client tier
    client [label="Client\n(laptop / browser)", fillcolor="#1f6feb"];

    // Edge / public surface
    gateway   [label="RD Gateway\nTLS terminator", fillcolor="#d97706", fontcolor="#0c1a2e"];
    webaccess [label="RD Web Access\nbrowser portal",  fillcolor="#facc15", fontcolor="#0c1a2e"];

    // Control plane
    broker [label="Connection Broker\norchestrates sessions", fillcolor="#7c3aed"];

    // Compute tier
    rdsh [label="RD Session Host (RDSH)\nshared desktop sessions", fillcolor="#16a34a"];
    vdi  [label="RD Virtualization Host\nVDI on Hyper-V",          fillcolor="#0891b2"];

    // License tier
    licsrv [label="License Server\nCAL store", fillcolor="#dc2626"];

    // Flow edges
    client    -> gateway   [label=" ① RDP-over-HTTPS\n  port 443"];
    client    -> webaccess [label=" ② browser\n  RemoteApp feed", style=dashed];
    gateway   -> broker    [label=" ③ RDP 3389"];
    webaccess -> broker    [label=" launch", style=dashed];
    broker    -> rdsh      [label=" ④ dispatch\n  session"];
    broker    -> vdi       [label=" ④ dispatch\n  VM", style=dashed];
    rdsh      -> licsrv    [label=" ⑤ CAL query", color="#f97316"];
    vdi       -> licsrv    [label=" ⑤ CAL query", color="#f97316", style=dashed];

    // Rank lock so the tiers stack cleanly
    { rank=same; gateway; webaccess; }
    { rank=same; rdsh; vdi; }
}
