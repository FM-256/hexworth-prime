digraph session_states {
    rankdir=LR;
    bgcolor="#0c1a2e";
    fontname="Inter";
    pad=0.5;
    labelloc=t;
    label=<<FONT POINT-SIZE="30" COLOR="white"><B>RDS Session Management</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#9ca3af">Four session states + admin actions</FONT>>;
    fontcolor=white;

    node [shape=circle, style="filled", fontname="Inter", fontsize=14,
          fontcolor="#ffffff", color="#ffffff", penwidth=2, width=1.6, fixedsize=true];

    listen [label="LISTEN\n(waiting)", fillcolor="#9ca3af", fontcolor="#0c1a2e"];
    active [label="ACTIVE\n(user using)", fillcolor="#16a34a"];
    idle [label="IDLE\n(no input)", fillcolor="#d97706", fontcolor="#0c1a2e"];
    disc [label="DISCON-\nNECTED\n(network drop)", fillcolor="#facc15", fontcolor="#0c1a2e"];

    edge [fontname="Inter", fontsize=11, fontcolor="#ffd86b", color="#7aa2ff", penwidth=2];

    listen -> active [label="user connects"];
    active -> idle [label="idle timeout"];
    idle -> active [label="user input"];
    active -> disc [label="network lost"];
    disc -> active [label="reconnect"];
    disc -> listen [label="disconnect timeout"];
    idle -> listen [label="idle timeout (full)"];

    // Action row
    node [shape=box, style="rounded,filled", width=1.6, height=0.6, fixedsize=true];
    shadow [label="Shadow", fillcolor="#7c3aed"];
    disconnect [label="Disconnect", fillcolor="#7c3aed"];
    logoff [label="Log Off", fillcolor="#dc2626"];
    message [label="Message", fillcolor="#0891b2"];

    actions [label="ADMIN ACTIONS", shape=plaintext, fontcolor="#9ca3af", fontsize=12];
    actions -> shadow [style=invis];
    actions -> disconnect [style=invis];
    actions -> logoff [style=invis];
    actions -> message [style=invis];

    { rank=same; actions; shadow; disconnect; logoff; message; }
    { rank=same; listen; active; idle; disc; }
}
