---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph S [" Session States "]
        direction LR
        Listen(("LISTEN<br/>waiting"))
        Active(("ACTIVE<br/>user using"))
        Idle(("IDLE<br/>no input"))
        Disc(("DISCONN.<br/>network drop"))

        Listen -- "user connects" --> Active
        Active -- "idle timeout" --> Idle
        Idle  -- "user input" --> Active
        Active -- "network lost" --> Disc
        Disc  -- "reconnect" --> Active
        Disc  -- "disc. timeout" --> Listen
        Idle  -- "idle timeout (full)" --> Listen
    end
    subgraph A [" Admin Actions "]
        direction LR
        Shadow[Shadow]:::act
        Disconnect[Disconnect]:::act
        LogOff[Log Off]:::actR
        Message[Message]:::actC
    end

    classDef act  fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2
    classDef actR fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2
    classDef actC fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2

    style Listen fill:#9ca3af,color:#0c1a2e,stroke:#fff,stroke-width:2
    style Active fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2
    style Idle   fill:#d97706,color:#0c1a2e,stroke:#fff,stroke-width:2
    style Disc   fill:#facc15,color:#0c1a2e,stroke:#fff,stroke-width:2
