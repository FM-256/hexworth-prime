title: RDS Session Management {
  shape: text
  style: { font-size: 30; bold: true; fill: white }
}

states: {
  listen: LISTEN\n(waiting) {
    shape: circle
    style: { fill: "#9ca3af"; font-color: "#0c1a2e"; stroke: white }
  }
  active: ACTIVE\n(user using) {
    shape: circle
    style: { fill: "#16a34a"; font-color: white; stroke: white }
  }
  idle: IDLE\n(no input) {
    shape: circle
    style: { fill: "#d97706"; font-color: "#0c1a2e"; stroke: white }
  }
  disconnected: DISCONNECTED\n(network drop) {
    shape: circle
    style: { fill: "#facc15"; font-color: "#0c1a2e"; stroke: white }
  }

  listen -> active: "user connects"
  active -> idle: "idle timeout"
  idle -> active: "user input"
  active -> disconnected: "network lost"
  disconnected -> active: "reconnect"
  disconnected -> listen: "disconnect timeout"
  idle -> listen: "idle timeout (full)"
}

actions: ADMIN ACTIONS {
  shape: text
  style: { font-color: "#9ca3af" }
  act_shadow: Shadow { style: { fill: "#7c3aed"; font-color: white; border-radius: 6 } }
  act_disconnect: Disconnect { style: { fill: "#7c3aed"; font-color: white; border-radius: 6 } }
  act_logoff: Log Off { style: { fill: "#dc2626"; font-color: white; border-radius: 6 } }
  act_message: Message { style: { fill: "#0891b2"; font-color: white; border-radius: 6 } }
}
