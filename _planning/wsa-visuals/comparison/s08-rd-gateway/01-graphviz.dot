digraph rd_gateway {
    rankdir=LR;
    bgcolor="#0c1a2e";
    fontname="Inter";
    pad=0.5;
    nodesep=0.6;
    ranksep=0.7;
    labelloc=t;
    label=<<FONT POINT-SIZE="30" COLOR="white"><B>RD Gateway</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#9ca3af">RDP-over-HTTPS — one open port to the internet</FONT>>;
    fontcolor=white;

    node [shape=box, style="rounded,filled", fontname="Inter", fontsize=14,
          fontcolor="#ffffff", color="#ffffff", penwidth=2, margin="0.25,0.18"];
    edge [fontname="Inter", fontsize=12, fontcolor="#ffd86b", color="#7aa2ff", penwidth=2];

    internet [label="Internet\n(remote user)", fillcolor="#1f6feb"];
    firewall [label="Perimeter Firewall\nONLY port 443 open", fillcolor="#dc2626"];
    gateway  [label="RD Gateway\nTLS terminator", fillcolor="#d97706", fontcolor="#0c1a2e"];
    rdsh     [label="Internal RDSH\nRDP 3389", fillcolor="#16a34a"];

    internet -> firewall [label="RDP-over-HTTPS\nport 443 (TLS tunnel)", color="#f97316", penwidth=3];
    firewall -> gateway  [label="passes 443", color="#f97316", penwidth=3];
    gateway  -> rdsh     [label="RDP 3389\n(internal only)", color="#16a34a", penwidth=3];

    cap [label="CAP — Connection Auth Policy\nWHO can connect", shape=note, fillcolor="#facc15", fontcolor="#0c1a2e"];
    rap [label="RAP — Resource Auth Policy\nWHAT they can reach", shape=note, fillcolor="#facc15", fontcolor="#0c1a2e"];
    cap -> gateway [style=dashed, color="#9ca3af", arrowhead=none];
    rap -> gateway [style=dashed, color="#9ca3af", arrowhead=none];
}
