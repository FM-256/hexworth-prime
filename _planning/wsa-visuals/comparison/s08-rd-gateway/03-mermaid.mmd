---
flowchart LR
    Internet["Internet<br/>(remote user)"]:::client
    Firewall["Perimeter Firewall<br/>ONLY port 443 open"]:::fw
    Gateway["RD Gateway<br/>TLS terminator"]:::gw
    RDSH["Internal RDSH<br/>RDP 3389"]:::svr

    Internet ==>|"RDP-over-HTTPS<br/>port 443 (TLS tunnel)"| Firewall
    Firewall ==>|"passes 443"| Gateway
    Gateway ==>|"RDP 3389<br/>(internal only)"| RDSH

    CAP["CAP — Connection Auth Policy<br/>WHO can connect"]:::note
    RAP["RAP — Resource Auth Policy<br/>WHAT they can reach"]:::note
    CAP -.- Gateway
    RAP -.- Gateway

    classDef client fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef fw     fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef gw     fill:#d97706,color:#0c1a2e,stroke:#fff,stroke-width:2px
    classDef svr    fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef note   fill:#facc15,color:#0c1a2e,stroke:#fff,stroke-width:1px
