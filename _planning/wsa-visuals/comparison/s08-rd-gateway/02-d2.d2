direction: right

title: RD Gateway {
  shape: text
  style: { font-size: 30; bold: true; fill: white }
}

internet: Internet\n(remote user) { style: { fill: "#1f6feb"; stroke: white; font-color: white; border-radius: 8 } }
firewall: Perimeter Firewall\nONLY port 443 open { style: { fill: "#dc2626"; stroke: white; font-color: white; border-radius: 8 } }
gateway: RD Gateway\nTLS terminator { style: { fill: "#d97706"; stroke: white; font-color: "#0c1a2e"; border-radius: 8 } }
rdsh: Internal RDSH\nRDP 3389 { style: { fill: "#16a34a"; stroke: white; font-color: white; border-radius: 8 } }

internet -> firewall: "RDP-over-HTTPS, port 443 (TLS tunnel)" { style.stroke: "#f97316"; style.stroke-width: 3 }
firewall -> gateway: "passes 443" { style.stroke: "#f97316"; style.stroke-width: 3 }
gateway -> rdsh: "RDP 3389 (internal)" { style.stroke: "#16a34a"; style.stroke-width: 3 }

cap: "CAP — Connection Auth Policy: WHO can connect" {
  shape: callout
  style: { fill: "#facc15"; font-color: "#0c1a2e"; stroke: white }
}
rap: "RAP — Resource Auth Policy: WHAT they can reach" {
  shape: callout
  style: { fill: "#facc15"; font-color: "#0c1a2e"; stroke: white }
}
cap -- gateway: { style: { stroke-dash: 5; stroke: "#9ca3af" } }
rap -- gateway: { style: { stroke-dash: 5; stroke: "#9ca3af" } }
