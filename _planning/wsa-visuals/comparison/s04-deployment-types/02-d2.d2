direction: right
vars: { d2-config: { layout-engine: dagre } }

title: Deployment Types {
  shape: text
  style: { font-size: 30; bold: true; fill: white }
}
subtitle: Session-Based vs VDI {
  shape: text
  style: { font-size: 13; fill: "#9ca3af" }
}

Session-Based: {
  style: { fill: "#16a34a"; stroke: white; font-color: white; border-radius: 14; stroke-width: 2 }
  a: "One shared OS\nMultiple user sessions"
  b: "Low cost per user"
  c: "Standardized workloads\n(office, LoB apps)"
  a -> b -> c: { style.opacity: 0 }
  a.style: { fill: "#0c1a2e"; font-color: white; border-radius: 8 }
  b.style: { fill: "#0c1a2e"; font-color: white; border-radius: 8 }
  c.style: { fill: "#0c1a2e"; font-color: white; border-radius: 8 }
}

VDI: {
  style: { fill: "#0891b2"; stroke: white; font-color: white; border-radius: 14; stroke-width: 2 }
  a: "One dedicated VM per user"
  b: "Higher cost,\nfull isolation"
  c: "Best for devs / power users /\nadmin-rights workloads"
  a -> b -> c: { style.opacity: 0 }
  a.style: { fill: "#0c1a2e"; font-color: white; border-radius: 8 }
  b.style: { fill: "#0c1a2e"; font-color: white; border-radius: 8 }
  c.style: { fill: "#0c1a2e"; font-color: white; border-radius: 8 }
}
