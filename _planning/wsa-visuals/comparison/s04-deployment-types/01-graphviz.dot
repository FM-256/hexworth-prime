digraph deployment_types {
    rankdir=TB;
    bgcolor="#0c1a2e";
    fontname="Inter";
    pad=0.5;
    labelloc=t;
    label=<<FONT POINT-SIZE="30" COLOR="white"><B>Deployment Types</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#9ca3af">Session-Based vs VDI</FONT>>;
    fontcolor=white;
    compound=true;

    node [shape=box, style="rounded,filled", fontname="Inter", fontsize=14,
          fontcolor="#ffffff", color="#ffffff", penwidth=2, margin="0.25,0.18"];

    subgraph cluster_sb {
        label=<<FONT POINT-SIZE="20" COLOR="white"><B>Session-Based</B></FONT>>;
        style="rounded,filled";
        fillcolor="#16a34a";
        color="white";
        fontcolor=white;
        margin=18;
        sb_a [label="One shared OS\nMultiple user sessions", fillcolor="#0c1a2e"];
        sb_b [label="Low cost per user", fillcolor="#0c1a2e"];
        sb_c [label="Standardized workloads\n(office apps, line-of-business)", fillcolor="#0c1a2e"];
        edge [style=invis];
        sb_a -> sb_b -> sb_c;
    }

    subgraph cluster_vdi {
        label=<<FONT POINT-SIZE="20" COLOR="white"><B>VDI (Virtual Desktop Infrastructure)</B></FONT>>;
        style="rounded,filled";
        fillcolor="#0891b2";
        color="white";
        fontcolor=white;
        margin=18;
        vdi_a [label="One dedicated VM per user", fillcolor="#0c1a2e"];
        vdi_b [label="Higher cost,\nfull isolation", fillcolor="#0c1a2e"];
        vdi_c [label="Best for devs / power users /\nadmin-rights workloads", fillcolor="#0c1a2e"];
        edge [style=invis];
        vdi_a -> vdi_b -> vdi_c;
    }

    { rank=same; cluster_sb; cluster_vdi; }
}
