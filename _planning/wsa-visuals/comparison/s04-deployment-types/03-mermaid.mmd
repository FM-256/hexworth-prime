---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    primaryColor: '#1f2937'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph SB ["Session-Based"]
        direction TB
        SB1["One shared OS<br/>Multiple user sessions"]
        SB2["Low cost per user"]
        SB3["Standardized workloads<br/>(office, LoB apps)"]
    end
    subgraph VDI ["VDI (Virtual Desktop Infrastructure)"]
        direction TB
        VDI1["One dedicated VM per user"]
        VDI2["Higher cost,<br/>full isolation"]
        VDI3["Best for devs / power users /<br/>admin-rights workloads"]
    end

    classDef sbCard fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef vdiCard fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef item fill:#0c1a2e,color:#fff,stroke:#9ca3af,stroke-width:1px
    class SB sbCard
    class VDI vdiCard
    class SB1,SB2,SB3,VDI1,VDI2,VDI3 item
