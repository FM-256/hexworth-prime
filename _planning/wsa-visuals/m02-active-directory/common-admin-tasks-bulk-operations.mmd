---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["CSV-driven user creation"]
        direction TB
        L0["Import-Csv newusers.csv"]:::lItem
        L1["| ForEach-Object { New-ADUser ... }"]:::lItem
        L2["Use -WhatIf to preview"]:::lItem
    end
    subgraph R ["Pipeline-chained group ops"]
        direction TB
        R0["Get-ADUser -Filter * -SearchBase OU"]:::rItem
        R1["| Add-ADGroupMember "IT Staff""]:::rItem
        R2["One command for many users"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
