---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Workgroup"]
        direction TB
        L0["Peer-to-peer"]:::lItem
        L1["Each PC manages own accounts"]:::lItem
        L2["No central auth, no GPO"]:::lItem
        L3["≤20 computers (practical)"]:::lItem
        L4["Home / small office"]:::lItem
    end
    subgraph R ["Domain"]
        direction TB
        R0["Centralized management"]:::rItem
        R1["Single sign-on across resources"]:::rItem
        R2["Central auth via AD DS"]:::rItem
        R3["Scales to thousands"]:::rItem
        R4["Enterprise"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
