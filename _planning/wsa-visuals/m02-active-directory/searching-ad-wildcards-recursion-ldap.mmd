---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["-Filter (PowerShell style)"]
        direction TB
        L0["{Name -like 'WKS-*'}"]:::lItem
        L1["{Dept -eq 'Sales'}"]:::lItem
        L2["-Recursive flag for nested groups"]:::lItem
        L3["Default style"]:::lItem
    end
    subgraph R ["-LDAPFilter (native LDAP)"]
        direction TB
        R0["(department=Sales)"]:::rItem
        R1["Same speed as -Filter"]:::rItem
        R2["Use when docs give LDAP syntax"]:::rItem
        R3["Standard LDAP query language"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
