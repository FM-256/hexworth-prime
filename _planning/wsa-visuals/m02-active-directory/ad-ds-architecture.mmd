    Domain -->|"contains"| OU
    OU -->|"contains"| Obj
    classDef n_Forest fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Domain fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_OU fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Obj fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
