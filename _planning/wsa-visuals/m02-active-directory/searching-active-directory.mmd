---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["-Filter (server-side) — FAST"]
        direction TB
        L0["Filter runs on DC"]:::lItem
        L1["-Filter * + -SearchBase OU"]:::lItem
        L2["-Filter {Enabled -eq $false}"]:::lItem
        L3["LastLogonDate -lt $cutoff"]:::lItem
    end
    subgraph R ["Where-Object (client-side) — SLOW"]
        direction TB
        R0["Pulls every user, filters local"]:::rItem
        R1["OK for small result sets"]:::rItem
        R2["Avoid on large directories"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
