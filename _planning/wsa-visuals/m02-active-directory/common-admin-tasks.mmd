---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Unlock-ADAccount"]
        direction TB
        L0["Unlock a locked-out user"]:::lItem
        L1["-Identity jsmith"]:::lItem
        L2["Quick recovery after lockout"]:::lItem
    end
    subgraph R ["Move-ADObject"]
        direction TB
        R0["Move user to different OU"]:::rItem
        R1["-Identity (full DN)"]:::rItem
        R2["-TargetPath new OU DN"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
