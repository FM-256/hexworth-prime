---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["CRL"]
        direction TB
        L0["Periodic snapshot list"]:::lItem
        L1["Published at CDP URL"]:::lItem
        L2["Base CRL + Delta CRL"]:::lItem
        L3["Client caches by validity"]:::lItem
        L4["Larger payload"]:::lItem
    end
    subgraph R ["OCSP"]
        direction TB
        R0["Real-time query"]:::rItem
        R1["Per-cert response"]:::rItem
        R2["Small payload"]:::rItem
        R3["Better for web / mobile"]:::rItem
        R4["AIA URL in cert"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
