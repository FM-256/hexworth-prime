---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Properties"]
        direction TB
        L0["Key usage + EKU"]:::lItem
        L1["Validity period"]:::lItem
        L2["Key size + algorithm"]:::lItem
        L3["Subject name format"]:::lItem
        L4["Enrollment permissions"]:::lItem
    end
    subgraph R ["Common Templates"]
        direction TB
        R0["User"]:::rItem
        R1["Computer"]:::rItem
        R2["Web Server"]:::rItem
        R3["Domain Controller"]:::rItem
        R4["Code Signing"]:::rItem
        R5["Kerberos Authentication"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
