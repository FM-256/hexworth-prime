---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Stores"]
        direction TB
        L0["Personal (My)<br/>own + private key"]:::lItem
        L1["Trusted Root CAs"]:::lItem
        L2["Intermediate CAs"]:::lItem
        L3["Trusted Publishers"]:::lItem
        L4["Untrusted Certificates"]:::lItem
    end
    subgraph R ["Locations"]
        direction TB
        R0["CurrentUser<br/>(per-user store)"]:::rItem
        R1["LocalMachine<br/>(machine-wide store)"]:::rItem
        R2["certmgr.msc<br/>(user UI)"]:::rItem
        R3["certlm.msc<br/>(machine UI)"]:::rItem
        R4["Cert:\ PSDrive"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
