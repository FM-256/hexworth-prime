---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    GPO["GPO: Public Key Policies<br/>Certificate Services Client<br/>Auto-Enrollment"]:::n_GPO
    Client["Client (computer/user)<br/>checks AD for templates"]:::n_Client
    Templates["AD Templates<br/>(Configuration partition)"]:::n_Templates
    Check["Autoenroll permission<br/>on template?"]:::n_Check
    CA["Issuing CA<br/>issues silently"]:::n_CA
    Store["Local cert store<br/>Cert:\LocalMachine\My"]:::n_Store
    Renew["Renew + Update<br/>pending requests"]:::n_Renew
    GPO -->|"①"| Client
    Client -->|"② enumerate"| Templates
    Templates -->|"③"| Check
    Check -->|"④ if allowed"| CA
    CA -->|"⑤ install"| Store
    Store -..->|"⑥ near expiry"| Renew
    classDef n_GPO fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Client fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Templates fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Check fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_CA fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Store fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Renew fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
