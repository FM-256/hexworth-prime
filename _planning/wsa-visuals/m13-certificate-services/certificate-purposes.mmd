---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Key Usage"]
        direction TB
        L0["Digital Signature"]:::lItem
        L1["Key Encipherment"]:::lItem
        L2["Data Encipherment"]:::lItem
        L3["Cert Signing (CA only)"]:::lItem
        L4["CRL Signing (CA only)"]:::lItem
    end
    subgraph R ["Extended Key Usage"]
        direction TB
        R0["Server Authentication"]:::rItem
        R1["Client Authentication"]:::rItem
        R2["Code Signing"]:::rItem
        R3["Email Protection (S/MIME)"]:::rItem
        R4["Smart Card Logon"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
