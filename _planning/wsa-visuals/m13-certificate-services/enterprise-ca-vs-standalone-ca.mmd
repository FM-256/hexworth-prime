---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Enterprise CA"]
        direction TB
        L0["AD-integrated (required)"]:::lItem
        L1["Publishes to AD"]:::lItem
        L2["Certificate templates"]:::lItem
        L3["Autoenrollment"]:::lItem
        L4["Subject from AD"]:::lItem
    end
    subgraph R ["Standalone CA"]
        direction TB
        R0["No AD dependency"]:::rItem
        R1["Manual request approval"]:::rItem
        R2["Can run offline"]:::rItem
        R3["No templates"]:::rItem
        R4["Subject from request"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
