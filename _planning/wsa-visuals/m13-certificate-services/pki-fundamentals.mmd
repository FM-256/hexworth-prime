---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Concepts"]
        direction TB
        L0["Public + Private keys<br/>(asymmetric crypto)"]:::lItem
        L1["Cert binds identity<br/>to public key"]:::lItem
        L2["CA = trusted issuer"]:::lItem
        L3["Chain of trust"]:::lItem
    end
    subgraph R ["Uses"]
        direction TB
        R0["SSL / TLS"]:::rItem
        R1["S/MIME (email)"]:::rItem
        R2["Code signing"]:::rItem
        R3["Smart card auth"]:::rItem
        R4["IPsec / VPN"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
