---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["What to Back Up"]
        direction TB
        L0["CA private key + cert"]:::lItem
        L1["CA database<br/>(certsrv.mdb)"]:::lItem
        L2["Registry settings<br/>HKLM\System\<br/>CertSvc"]:::lItem
        L3["CAPolicy.inf"]:::lItem
        L4["Issued certificate log"]:::lItem
    end
    subgraph R ["How to Back Up"]
        direction TB
        R0["certsrv.msc<br/>(GUI wizard)"]:::rItem
        R1["certutil -backup<br/>(scriptable)"]:::rItem
        R2["Backup-CARoleService<br/>-Password (secure)"]:::rItem
        R3["Windows Server Backup<br/>(full system)"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
