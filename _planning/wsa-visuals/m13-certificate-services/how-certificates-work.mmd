---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Contents"]
        direction TB
        L0["Subject (whose key)"]:::lItem
        L1["Issuer (which CA)"]:::lItem
        L2["Serial number"]:::lItem
        L3["Validity dates"]:::lItem
        L4["Public key + algorithm"]:::lItem
        L5["Extensions (SAN, KU, EKU)"]:::lItem
    end
    subgraph R ["Validation"]
        direction TB
        R0["Chain to trusted root"]:::rItem
        R1["Signature verification"]:::rItem
        R2["Dates current"]:::rItem
        R3["Revocation check<br/>(CRL or OCSP)"]:::rItem
        R4["Name match (SAN/CN)"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
