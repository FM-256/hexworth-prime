---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["CDP"]
        direction TB
        L0["CRL download URLs<br/>embedded in cert"]:::lItem
        L1["HTTP and/or LDAP"]:::lItem
        L2["First reachable wins"]:::lItem
        L3["Critical for revocation<br/>checking"]:::lItem
        L4["certutil -getreg<br/>CA\CRLPublicationURLs"]:::lItem
    end
    subgraph R ["AIA"]
        direction TB
        R0["Authority Info Access"]:::rItem
        R1["CA cert download URL"]:::rItem
        R2["OCSP responder URL"]:::rItem
        R3["Builds chain to root"]:::rItem
        R4["certutil -verify<br/>-urlfetch cert.cer"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
