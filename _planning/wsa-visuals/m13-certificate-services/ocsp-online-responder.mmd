---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["vs CRL"]
        direction TB
        L0["Real-time response"]:::lItem
        L1["Smaller payload"]:::lItem
        L2["Cacheable per cert"]:::lItem
        L3["Better for high-volume<br/>web servers"]:::lItem
        L4["No client-side<br/>list download"]:::lItem
    end
    subgraph R ["Setup"]
        direction TB
        R0["Install ADCS-Online-Cert<br/>role service"]:::rItem
        R1["Issue OCSP Signing cert<br/>to responder"]:::rItem
        R2["Add AIA URL to issued<br/>certificate template"]:::rItem
        R3["Install-AdcsOnline<br/>Responder cmdlet"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
