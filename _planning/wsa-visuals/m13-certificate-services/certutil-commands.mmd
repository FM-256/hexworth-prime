---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["CA Operations"]
        direction TB
        L0["-ca<br/>CA info + status"]:::lItem
        L1["-catemplates<br/>list templates"]:::lItem
        L2["-CRL<br/>publish CRL"]:::lItem
        L3["-shutdown / -resume"]:::lItem
        L4["-backup C:\CABackup"]:::lItem
    end
    subgraph R ["Certificate Operations"]
        direction TB
        R0["-dump cert.cer<br/>show full content"]:::rItem
        R1["-verify -urlfetch<br/>full chain check"]:::rItem
        R2["-store My<br/>browse store"]:::rItem
        R3["-pulse<br/>trigger autoenroll"]:::rItem
        R4["-exportPFX<br/>extract with key"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
