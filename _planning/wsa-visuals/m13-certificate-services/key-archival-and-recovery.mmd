---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    Enable["Enable archival on CA<br/>certutil -setreg<br/>CA\KRAFlags"]:::n_Enable
    KRA["KRA cert issued<br/>to recovery agent"]:::n_KRA
    Template["Template allows<br/>private-key export<br/>+ archival"]:::n_Template
    Issue["User certificate<br/>issued + key archived"]:::n_Issue
    DB["Encrypted private key<br/>in CA database"]:::n_DB
    Get["certutil -getkey<br/>search-token blob"]:::n_Get
    Recover["certutil -recoverkey<br/>blob recovered.pfx"]:::n_Recover
    Enable -->|"①"| KRA
    KRA -->|"②"| Template
    Template -->|"③"| Issue
    Issue -->|"④ archive"| DB
    DB -->|"⑤ KRA extracts"| Get
    Get -->|"⑥ KRA decrypts"| Recover
    classDef n_Enable fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_KRA fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Template fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Issue fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DB fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Get fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Recover fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
