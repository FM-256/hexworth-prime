---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Distribute"]
        direction TB
        L0["Root CA certs<br/>(trusted root store)"]:::lItem
        L1["Intermediate CA certs"]:::lItem
        L2["Trusted Publishers<br/>(code-signing certs)"]:::lItem
        L3["Untrusted (block list)"]:::lItem
        L4["certutil -dspublish<br/>(adds to AD)"]:::lItem
    end
    subgraph R ["GPO Path"]
        direction TB
        R0["Computer Configuration"]:::rItem
        R1["> Windows Settings"]:::rItem
        R2["> Security Settings"]:::rItem
        R3["> Public Key Policies"]:::rItem
        R4["> Trusted Root CAs"]:::rItem
        R5["> Intermediate CAs"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
