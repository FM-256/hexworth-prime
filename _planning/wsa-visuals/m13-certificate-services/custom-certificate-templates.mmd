---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Versions"]
        direction TB
        L0["v1 — legacy<br/>(no edit)"]:::lItem
        L1["v2 — autoenroll<br/>(Server 2003+)"]:::lItem
        L2["v3 — CNG keys<br/>(Server 2008+)"]:::lItem
        L3["v4 — renewal w/<br/>same key (2012+)"]:::lItem
    end
    subgraph R ["Key Settings"]
        direction TB
        R0["Subject: from request<br/>vs from AD"]:::rItem
        R1["Enroll permissions"]:::rItem
        R2["Superseded templates"]:::rItem
        R3["Issuance requirements"]:::rItem
        R4["Min key size + hash"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
