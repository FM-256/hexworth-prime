---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Methods"]
        direction TB
        L0["Autoenrollment (silent)"]:::lItem
        L1["MMC certificates snap-in"]:::lItem
        L2["Web Enrollment (/certsrv)"]:::lItem
        L3["certreq.exe"]:::lItem
        L4["Get-Certificate PS cmdlet"]:::lItem
    end
    subgraph R ["Autoenroll GPO"]
        direction TB
        R0["Computer Configuration<br/>> Policies"]:::rItem
        R1["Windows Settings<br/>> Security"]:::rItem
        R2["Public Key Policies"]:::rItem
        R3["Certificate Services Client<br/>— Auto-Enrollment"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
