---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Get-ComputerInfo"]
        direction TB
        L0["Detailed hardware"]:::lItem
        L1["OS version + build"]:::lItem
        L2["Domain info"]:::lItem
        L3["Full picture"]:::lItem
    end
    subgraph R ["hostname"]
        direction TB
        R0["Just the computer name"]:::rItem
        R1["Quick identity check"]:::rItem
        R2["One-line output"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
