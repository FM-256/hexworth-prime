---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI Lab"]
        direction TB
        L0["Walk through Server Manager"]:::lItem
        L1["Hands-on UI exercise"]:::lItem
        L2["See dashboard live"]:::lItem
    end
    subgraph R ["PowerShell Lab"]
        direction TB
        R0["Run cmdlets yourself"]:::rItem
        R1["Fresh shell exercises"]:::rItem
        R2["Same patterns, deeper toolkit"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
