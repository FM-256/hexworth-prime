---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Desktop Experience"]
        direction TB
        L0["Full GUI + Server Manager"]:::lItem
        L1["Larger footprint (~10 GB)"]:::lItem
        L2["Best for: learning, legacy apps"]:::lItem
    end
    subgraph R ["Server Core"]
        direction TB
        R0["Command-line only"]:::rItem
        R1["Smaller footprint, fewer updates"]:::rItem
        R2["Best for: production, security"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
