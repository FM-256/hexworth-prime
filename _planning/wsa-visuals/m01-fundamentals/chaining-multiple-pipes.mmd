---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    GP["Get-Process"]:::n_GP
    SO["Sort-Object CPU<br/>-Descending"]:::n_SO
    SEL["Select-Object<br/>-First 5"]:::n_SEL
    OUT["Top 5 CPU<br/>processes"]:::n_OUT
    GP -->|"all processes"| SO
    SO -->|"sorted by CPU"| SEL
    SEL -->|"top N pattern"| OUT
    classDef n_GP fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_SO fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_SEL fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_OUT fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
