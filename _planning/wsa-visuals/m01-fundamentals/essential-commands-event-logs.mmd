---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Get-EventLog -Newest 20"]
        direction TB
        L0["Recent activity"]:::lItem
        L1["Quick health glance"]:::lItem
        L2["Any log: System / App / Security"]:::lItem
    end
    subgraph R ["Get-EventLog -EntryType Error"]
        direction TB
        R0["Only Error entries"]:::rItem
        R1["Find the failure"]:::rItem
        R2["Triage starting point"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
