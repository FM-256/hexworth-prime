---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Get-Command -Verb X"]
        direction TB
        L0["Discover cmdlets"]:::lItem
        L1[""show me every Get-""]:::lItem
        L2["Filter by verb / noun"]:::lItem
    end
    subgraph R ["Get-Help"]
        direction TB
        R0["-Examples — usage examples"]:::rItem
        R1["-Full — every detail"]:::rItem
        R2["-Online — docs in browser"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
