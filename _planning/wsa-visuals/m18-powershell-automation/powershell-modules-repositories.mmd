---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    Module["Module<br/>HexworthTools/"]:::n_Module
    Manifest[".psd1 Manifest<br/>version, exports, deps"]:::n_Manifest
    Body[".psm1 Body<br/>module code"]:::n_Body
    Public["Public/<br/>exported cmdlets"]:::n_Public
    Private["Private/<br/>internal helpers"]:::n_Private
    Tests["Tests/<br/>Pester specs"]:::n_Tests
    PSGallery["PSGallery<br/>public repo"]:::n_PSGallery
    Internal["Internal Repo<br/>NuGet / file share"]:::n_Internal
    Module -->|"declares"| Manifest
    Module -->|"loads"| Body
    Body -->|"exports"| Public
    Body -..->|"uses"| Private
    Module -..->|"validated by"| Tests
    Module -->|"install-from / publish"| PSGallery
    Module -->|"Register-PSRepository"| Internal
    classDef n_Module fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Manifest fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Body fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Public fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Private fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Tests fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_PSGallery fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Internal fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
