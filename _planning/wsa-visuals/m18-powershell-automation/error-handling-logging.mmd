---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Try["try { ... }<br/>main work block"]:::n_Try
    Success["Success path<br/>continue execution"]:::n_Success
    Catch["catch { ... }<br/>handle failure<br/>Write-Log ERROR"]:::n_Catch
    Finally["finally { ... }<br/>cleanup always runs"]:::n_Finally
    Log["Write-Log<br/>timestamped append"]:::n_Log
    Try -->|"no error"| Success
    Try -->|"exception thrown<br/>($ErrorAction=Stop)"| Catch
    Success -->|"always"| Finally
    Catch -->|"always"| Finally
    Catch -..->|"capture"| Log
    Try -..->|"INFO start"| Log
    Finally -..->|"INFO done"| Log
    classDef n_Try fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Success fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Catch fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Finally fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Log fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
