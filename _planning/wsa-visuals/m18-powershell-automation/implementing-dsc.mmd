---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    Define["① Define<br/>Configuration SecureServer { }"]:::n_Define
    Compile["② Compile<br/>SecureServer -OutputPath"]:::n_Compile
    Push["③ Push<br/>Start-DscConfiguration<br/>-Path ... -Wait"]:::n_Push
    Verify["④ Verify<br/>Test-DscConfiguration<br/>-Detailed"]:::n_Verify
    PushMode["Push mode<br/>admin-initiated"]:::n_PushMode
    PullMode["Pull mode<br/>nodes poll server"]:::n_PullMode
    Define -->|"MOF gen"| Compile
    Compile -->|"on-demand"| Push
    Compile -..->|"OR scheduled"| PullMode
    Push -..->|"pattern"| PushMode
    Push -->|"after apply"| Verify
    PullMode -..->|"after pull"| Verify
    classDef n_Define fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Compile fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Push fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Verify fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_PushMode fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_PullMode fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
