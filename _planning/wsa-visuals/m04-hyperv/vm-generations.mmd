---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Generation 1"]
        direction TB
        L0["Firmware: BIOS (Legacy)"]:::lItem
        L1["Boot disk: IDE"]:::lItem
        L2["No Secure Boot"]:::lItem
        L3["PXE: legacy adapter only"]:::lItem
        L4["No hot-add memory"]:::lItem
        L5["Older Windows / 32-bit Linux"]:::lItem
    end
    subgraph R ["Generation 2"]
        direction TB
        R0["Firmware: UEFI"]:::rItem
        R1["Boot disk: SCSI"]:::rItem
        R2["Secure Boot supported"]:::rItem
        R3["PXE: standard adapter"]:::rItem
        R4["Hot-add memory"]:::rItem
        R5["Windows 8+ / modern Linux"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
