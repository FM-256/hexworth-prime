---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI Lab"]
        direction TB
        L0["Hyper-V Manager console"]:::lItem
        L1["Create Gen 2 VM"]:::lItem
        L2["Bind External vSwitch"]:::lItem
        L3["Take checkpoint, restore"]:::lItem
        L4["One-host scale only"]:::lItem
    end
    subgraph R ["PowerShell Lab"]
        direction TB
        R0["New-VM at scale"]:::rItem
        R1["New-VMSwitch automation"]:::rItem
        R2["Checkpoint-VM batches"]:::rItem
        R3["Set-VM tuning loops"]:::rItem
        R4["Multi-host orchestration"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
