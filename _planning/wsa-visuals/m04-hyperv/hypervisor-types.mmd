---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Type 1 (Bare-Metal)"]
        direction TB
        L0["Runs directly on hardware<br/>(no host OS)"]:::lItem
        L1["Better performance"]:::lItem
        L2["Smaller attack surface"]:::lItem
        L3["Examples: Hyper-V, ESXi"]:::lItem
    end
    subgraph R ["Type 2 (Hosted)"]
        direction TB
        R0["Runs on top of a host OS"]:::rItem
        R1["Easier to install"]:::rItem
        R2["Extra overhead"]:::rItem
        R3["Examples: VirtualBox,<br/>VMware Workstation"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
