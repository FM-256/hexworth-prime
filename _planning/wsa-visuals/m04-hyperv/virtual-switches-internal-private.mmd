---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Internal Switch"]
        direction TB
        L0["VMs ↔ VMs ✓"]:::lItem
        L1["VMs ↔ Host ✓"]:::lItem
        L2["No physical network"]:::lItem
        L3["Use: management plane,<br/>lab traffic to host"]:::lItem
    end
    subgraph R ["Private Switch"]
        direction TB
        R0["VMs ↔ VMs ✓"]:::rItem
        R1["VMs ↔ Host ✗"]:::rItem
        R2["No host, no LAN"]:::rItem
        R3["Use: malware analysis,<br/>isolated test labs"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
