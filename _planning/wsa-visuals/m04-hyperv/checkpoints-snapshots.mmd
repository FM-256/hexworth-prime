---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Standard"]
        direction TB
        L0["Memory + disk state"]:::lItem
        L1["Crash-consistent"]:::lItem
        L2["Best for dev / test"]:::lItem
        L3["Resume exactly as paused"]:::lItem
    end
    subgraph R ["Production (default)"]
        direction TB
        R0["VSS-based, no memory"]:::rItem
        R1["Application-consistent"]:::rItem
        R2["Best for production VMs"]:::rItem
        R3["Default in Windows Server"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
