---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["How"]
        direction TB
        L0["Same FQDN"]:::lItem
        L1["Different IPs returned"]:::lItem
        L2["Resolution depends on<br/>client subnet"]:::lItem
    end
    subgraph R ["Uses"]
        direction TB
        R0["Web apps internal vs external"]:::rItem
        R1["Exchange Autodiscover"]:::rItem
        R2["SharePoint dual access"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
