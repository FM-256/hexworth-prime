---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Hot Standby"]
        direction TB
        L0["Primary serves leases"]:::lItem
        L1["Standby takes over on fail"]:::lItem
        L2["Standby reserves % of pool"]:::lItem
    end
    subgraph R ["Load Balance"]
        direction TB
        R0["Both active"]:::rItem
        R1["Default 50 / 50 split"]:::rItem
        R2["Configurable ratio"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
