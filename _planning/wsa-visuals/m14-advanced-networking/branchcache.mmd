---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Modes + Content"]
        direction TB
        L0["Distributed (P2P)"]:::lItem
        L1["Hosted (cache server)"]:::lItem
        L2["Protocols: SMB, HTTP, BITS"]:::lItem
    end
    subgraph R ["Flow"]
        direction TB
        R0["First client = WAN pull"]:::rItem
        R1["Cached locally"]:::rItem
        R2["Hash-validated"]:::rItem
        R3["Peers serve next request"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
