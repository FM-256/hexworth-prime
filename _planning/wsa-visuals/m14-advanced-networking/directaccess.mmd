---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["How"]
        direction TB
        L0["Auto-connect outside<br/>corp net"]:::lItem
        L1["IPv6 + IP-HTTPS<br/>(6to4, Teredo)"]:::lItem
        L2["Bi-directional"]:::lItem
        L3["Machine certs"]:::lItem
    end
    subgraph R ["Requirements"]
        direction TB
        R0["Windows Enterprise"]:::rItem
        R1["Domain-joined"]:::rItem
        R2["AD + GPO + AD CS"]:::rItem
        R3["DA server with 2 NICs"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
