---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Client["Client query<br/>(subnet, type, time)"]:::n_Client
    DNS["DNS Server"]:::n_DNS
    Policy["Policy match<br/>criteria → scope"]:::n_Policy
    Scope["Zone scope<br/>(records)"]:::n_Scope
    Resp["Tailored<br/>response"]:::n_Resp
    Client -->|"query"| DNS
    DNS -->|"eval"| Policy
    Policy -->|"select"| Scope
    Scope -->|"records"| Resp
    Resp -->|"reply"| Client
    classDef n_Client fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DNS fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Policy fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Scope fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Resp fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
