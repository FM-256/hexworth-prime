---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI Lab"]
        direction TB
        L0["NIC Team build"]:::lItem
        L1["DHCP failover"]:::lItem
        L2["DNS policies"]:::lItem
        L3["Windows Firewall + QoS"]:::lItem
    end
    subgraph R ["PowerShell Lab"]
        direction TB
        R0["Teams + failover"]:::rItem
        R1["Zone scopes"]:::rItem
        R2["Firewall rules"]:::rItem
        R3["IPsec + QoS policies"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
