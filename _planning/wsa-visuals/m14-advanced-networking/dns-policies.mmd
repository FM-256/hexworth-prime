---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Types"]
        direction TB
        L0["Query Resolution"]:::lItem
        L1["Zone Transfer"]:::lItem
        L2["Recursion control"]:::lItem
    end
    subgraph R ["Criteria"]
        direction TB
        R0["Client subnet"]:::rItem
        R1["Query type"]:::rItem
        R2["Time of day"]:::rItem
        R3["Transport (TCP / UDP)"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
