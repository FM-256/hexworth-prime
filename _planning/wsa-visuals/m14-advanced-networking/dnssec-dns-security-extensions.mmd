---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Components"]
        direction TB
        L0["RRSIG — record signatures"]:::lItem
        L1["DNSKEY — public keys"]:::lItem
        L2["DS — delegation hash"]:::lItem
        L3["NSEC / NSEC3"]:::lItem
        L4["KSK / ZSK"]:::lItem
    end
    subgraph R ["Benefits"]
        direction TB
        R0["Prevents cache poisoning"]:::rItem
        R1["Authenticates data origin"]:::rItem
        R2["Chain of trust<br/>root → TLD → zone"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
