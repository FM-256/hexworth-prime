---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    HQ["HQ Content Server<br/>(SMB / HTTP)"]:::n_HQ
    WAN["WAN link"]:::n_WAN
    Cache["Branch Cache<br/>Server"]:::n_Cache
    C1["Branch Client 1"]:::n_C1
    C2["Branch Client 2"]:::n_C2
    C1 -->|"① first read (WAN)"| HQ
    HQ -..->|"② file + hashes"| C1
    C1 -->|"③ deposit"| Cache
    C2 -->|"④ next read (LAN)"| Cache
    Cache -..->|"⑤ serve cached"| C2
    classDef n_HQ fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_WAN fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Cache fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_C1 fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_C2 fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
