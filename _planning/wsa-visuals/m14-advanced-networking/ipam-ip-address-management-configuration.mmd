---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Admin["Admin<br/>IPAM Client"]:::n_Admin
    Server["IPAM Server"]:::n_Server
    DB["WID / SQL<br/>(database)"]:::n_DB
    DHCP["Managed<br/>DHCP"]:::n_DHCP
    DNS["Managed<br/>DNS"]:::n_DNS
    DC["Domain<br/>Controllers"]:::n_DC
    Admin -->|"console"| Server
    Server -->|"reads / writes"| DB
    Server -->|"collect leases"| DHCP
    Server -->|"collect zones"| DNS
    Server -..->|"audit events"| DC
    classDef n_Admin fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Server fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DB fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DHCP fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DNS fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DC fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
