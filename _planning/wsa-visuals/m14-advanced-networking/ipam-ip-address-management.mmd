---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Features"]
        direction TB
        L0["Centralized IP tracking"]:::lItem
        L1["Manages DHCP + DNS"]:::lItem
        L2["Audits + reports"]:::lItem
        L3["Address-space mgmt"]:::lItem
    end
    subgraph R ["Components"]
        direction TB
        R0["IPAM Server"]:::rItem
        R1["IPAM Database (WID / SQL)"]:::rItem
        R2["Managed Servers (DHCP, DNS, DC)"]:::rItem
        R3["IPAM Client (Server Manager)"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
