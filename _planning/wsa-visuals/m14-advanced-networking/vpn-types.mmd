---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Protocols"]
        direction TB
        L0["IKEv2 (recommended)"]:::lItem
        L1["SSTP (TLS over 443)"]:::lItem
        L2["L2TP / IPsec"]:::lItem
        L3["PPTP (avoid)"]:::lItem
    end
    subgraph R ["Picking"]
        direction TB
        R0["IKEv2 = mobile<br/>auto-reconnect"]:::rItem
        R1["SSTP = firewall-friendly<br/>(port 443)"]:::rItem
        R2["L2TP = legacy compat"]:::rItem
        R3["PPTP = insecure, do not use"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
