---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Zone["Authoritative<br/>zone"]:::n_Zone
    KSK["KSK<br/>key-signing key"]:::n_KSK
    ZSK["ZSK<br/>zone-signing key"]:::n_ZSK
    Signed["Signed zone<br/>RRSIG + DNSKEY"]:::n_Signed
    Parent["Parent zone<br/>DS record"]:::n_Parent
    Resolver["Validating resolver"]:::n_Resolver
    Zone -->|"① sign"| Signed
    KSK -->|"② signs DNSKEY"| Signed
    ZSK -->|"③ signs records"| Signed
    Signed -->|"④ DS uploaded"| Parent
    Parent -->|"⑤ trust chain"| Resolver
    Resolver -..->|"⑥ validate"| Signed
    classDef n_Zone fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_KSK fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_ZSK fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Signed fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Parent fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Resolver fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
