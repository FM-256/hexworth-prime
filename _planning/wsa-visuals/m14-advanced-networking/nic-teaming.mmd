---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Modes"]
        direction TB
        L0["Switch Independent"]:::lItem
        L1["Static / LACP (802.3ad)"]:::lItem
        L2["Hyper-V Port"]:::lItem
    end
    subgraph R ["Load Balance"]
        direction TB
        R0["Address Hash"]:::rItem
        R1["Dynamic"]:::rItem
        R2["Hyper-V Port (VM-pinned)"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
