---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Types"]
        direction TB
        L0["SNAT (outbound translation)"]:::lItem
        L1["DNAT (port forwarding)"]:::lItem
        L2["Static 1:1"]:::lItem
        L3["Dynamic pool"]:::lItem
    end
    subgraph R ["Uses"]
        direction TB
        R0["Private LAN → Internet"]:::rItem
        R1["Lab / container networking"]:::rItem
        R2["Conserve public IPv4"]:::rItem
        R3["Hide internal topology"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
