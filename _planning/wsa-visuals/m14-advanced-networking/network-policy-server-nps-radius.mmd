---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Use Cases"]
        direction TB
        L0["VPN authentication"]:::lItem
        L1["Wi-Fi 802.1X"]:::lItem
        L2["Wired 802.1X (NAC)"]:::lItem
        L3["RADIUS proxy"]:::lItem
    end
    subgraph R ["Components"]
        direction TB
        R0["RADIUS clients"]:::rItem
        R1["Connection request policies"]:::rItem
        R2["Network policies"]:::rItem
        R3["Accounting / logging"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
