---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Diagnostic Tools"]
        direction TB
        L0["Test-NetConnection<br/>(connectivity)"]:::lItem
        L1["Get-NetTCPConnection<br/>(active sockets)"]:::lItem
        L2["Get-NetRoute<br/>(routing table)"]:::lItem
        L3["netsh trace<br/>(packet capture)"]:::lItem
    end
    subgraph R ["Performance Counters"]
        direction TB
        R0["Network Interface\<br/>Bytes/sec"]:::rItem
        R1["TCPv4\Connections<br/>Established"]:::rItem
        R2["Network Adapter\<br/>Packets/sec"]:::rItem
        R3["RDMA Activity counters"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
