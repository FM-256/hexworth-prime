flowchart LR
    User["User<br/>(Wi-Fi / VPN)"]:::n_User
    NAS["NAS / Authenticator<br/>(AP, VPN, switch)"]:::n_NAS
    NPS["NPS<br/>(RADIUS server)"]:::n_NPS
    AD["Active Directory<br/>user + group check"]:::n_AD
    Result["Accept / Reject<br/>+ VLAN, ACL"]:::n_Result
    User -->|"① credentials"| NAS
    NAS -->|"② RADIUS<br/>Access-Request"| NPS
    NPS -->|"③ validate"| AD
    AD -..->|"④ group info"| NPS
    NPS -->|"⑤ Access-Accept<br/>+ attributes"| NAS
    NAS -->|"⑥ grant"| User
    classDef n_User fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_NAS fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_NPS fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_AD fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Result fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
