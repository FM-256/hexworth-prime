---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Client["Remote client<br/>(laptop)"]:::n_Client
    Inet["Internet"]:::n_Inet
    FW["Firewall<br/>(443 / 500 / 4500)"]:::n_FW
    VPN["RRAS / VPN<br/>server"]:::n_VPN
    NPS["NPS<br/>(RADIUS auth)"]:::n_NPS
    LAN["Internal<br/>network"]:::n_LAN
    Client -->|"① dial"| Inet
    Inet -->|"② TLS / IKE"| FW
    FW -->|"③ pass"| VPN
    VPN -->|"④ authenticate"| NPS
    NPS -..->|"⑤ accept"| VPN
    VPN -->|"⑥ tunnel<br/>established"| LAN
    classDef n_Client fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Inet fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_FW fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_VPN fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_NPS fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_LAN fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
