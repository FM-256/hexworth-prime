---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Components"]
        direction TB
        L0["Network Controller"]:::lItem
        L1["Software Load Balancer (SLB)"]:::lItem
        L2["RAS Gateway"]:::lItem
        L3["Datacenter Firewall"]:::lItem
    end
    subgraph R ["Benefits"]
        direction TB
        R0["Central management"]:::rItem
        R1["Auto-provisioning"]:::rItem
        R2["Micro-segmentation"]:::rItem
        R3["Network virtualization"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
