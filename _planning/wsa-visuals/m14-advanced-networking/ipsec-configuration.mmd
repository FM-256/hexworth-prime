---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Modes"]
        direction TB
        L0["Transport<br/>(payload only encrypted)"]:::lItem
        L1["Tunnel<br/>(full packet — VPN)"]:::lItem
    end
    subgraph R ["Auth"]
        direction TB
        R0["Kerberos<br/>(domain-joined)"]:::rItem
        R1["Certificates<br/>(PKI)"]:::rItem
        R2["Pre-shared Key<br/>(PSK — lab only)"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
