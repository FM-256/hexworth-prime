---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Concepts"]
        direction TB
        L0["CA — Customer Address<br/>(virtual IP)"]:::lItem
        L1["PA — Provider Address<br/>(physical IP)"]:::lItem
        L2["VXLAN / NVGRE<br/>encapsulation"]:::lItem
    end
    subgraph R ["Benefits"]
        direction TB
        R0["Multi-tenant<br/>without VLANs"]:::rItem
        R1["Workload mobility"]:::rItem
        R2["Cross-subnet live<br/>migration"]:::rItem
        R3["IP overlap OK<br/>between tenants"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
