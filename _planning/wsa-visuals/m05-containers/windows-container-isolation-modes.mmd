---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Process Isolation"]
        direction TB
        L0["Kernel: shared with host"]:::lItem
        L1["Speed: fastest"]:::lItem
        L2["Trust: same-OS only"]:::lItem
        L3["Best for: internal workloads"]:::lItem
        L4["Default on Server"]:::lItem
    end
    subgraph R ["Hyper-V Isolation"]
        direction TB
        R0["Kernel: own (lightweight VM)"]:::rItem
        R1["Speed: slightly slower"]:::rItem
        R2["Trust: cross-version OK"]:::rItem
        R3["Best for: multi-tenant,<br/>untrusted"]:::rItem
        R4["Default on Win 10/11"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
