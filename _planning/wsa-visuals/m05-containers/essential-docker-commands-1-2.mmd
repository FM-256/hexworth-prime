flowchart TB
    H["Image + Run"]:::head
    I0["docker images — list local images"]:::item
    H --> I0
    I1["docker pull mcr.microsoft.com/...<br/>— download a base image"]:::item
    H --> I1
    I2["docker run -d --name web1 IMAGE<br/>— launch detached + named"]:::item
