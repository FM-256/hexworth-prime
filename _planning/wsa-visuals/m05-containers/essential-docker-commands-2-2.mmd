---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    H["Lifecycle + Flags"]:::head
    I0["docker ps — running (or -a all)"]:::item
    H --> I0
    I1["docker stop / start NAME<br/>— graceful pause / resume"]:::item
    H --> I1
    I2["docker rm NAME — delete container"]:::item
    H --> I2
    I3["docker exec -it NAME powershell<br/>— shell into a container"]:::item
    H --> I3
    I4["Flags: -p host:container (port)<br/>-v src:dst (volume)"]:::item
    H --> I4
    classDef head fill:#2496ed,color:#fff,stroke:#fff,stroke-width:2px
    classDef item fill:#0c1a2e,color:#fff,stroke:#9ca3af,stroke-width:1px
