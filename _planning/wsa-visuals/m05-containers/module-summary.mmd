---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI Lab"]
        direction TB
        L0["Docker Desktop / Server console"]:::lItem
        L1["Pull a base image"]:::lItem
        L2["Run a container interactively"]:::lItem
        L3["Inspect with docker ps"]:::lItem
        L4["Hand-walk each lifecycle step"]:::lItem
    end
    subgraph R ["PowerShell Lab"]
        direction TB
        R0["docker CLI scripted"]:::rItem
        R1["Build a custom Dockerfile"]:::rItem
        R2["Tag + push to registry"]:::rItem
        R3["Multi-container orchestration"]:::rItem
        R4["CI/CD-ready automation"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
