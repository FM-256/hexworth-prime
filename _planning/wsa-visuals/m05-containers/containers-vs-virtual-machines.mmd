---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Container"]
        direction TB
        L0["OS: shared host kernel"]:::lItem
        L1["Startup: seconds"]:::lItem
        L2["Size: MBs (image layers)"]:::lItem
        L3["Density: 100s per host"]:::lItem
        L4["Isolation: process-level"]:::lItem
        L5["Best for: microservices,<br/>CI/CD"]:::lItem
    end
    subgraph R ["Virtual Machine"]
        direction TB
        R0["OS: full OS per VM"]:::rItem
        R1["Startup: minutes"]:::rItem
        R2["Size: GBs (full OS)"]:::rItem
        R3["Density: 10s per host"]:::rItem
        R4["Isolation: hardware-level"]:::rItem
        R5["Best for: legacy,<br/>different OS"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#2496ed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#60a5fa,color:#fff,stroke:#fff,stroke-width:2px
