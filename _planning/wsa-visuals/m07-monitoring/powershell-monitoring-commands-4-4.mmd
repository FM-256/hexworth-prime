---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Find Stopped Services"]
        direction TB
        L0["Get-Service"]:::lItem
        L1["Where-Object Status -eq Stopped"]:::lItem
        L2["Spot broken services"]:::lItem
    end
    subgraph R ["Remote Counter Query"]
        direction TB
        R0["Invoke-Command -ComputerName"]:::rItem
        R1["Server01, Server02"]:::rItem
        R2["Get-Counter inside ScriptBlock"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
