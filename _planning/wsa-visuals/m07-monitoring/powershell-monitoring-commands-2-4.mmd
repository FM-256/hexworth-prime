---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Get-EventLog (legacy)"]
        direction TB
        L0["-LogName Application"]:::lItem
        L1["-EntryType Error"]:::lItem
        L2["-Newest 20"]:::lItem
    end
    subgraph R ["Get-Counter"]
        direction TB
        R0["\\Memory\\Available MBytes"]:::rItem
        R1["Live performance sample"]:::rItem
        R2["Returns CounterSample object"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
