---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Discover Counter Sets"]
        direction TB
        L0["Get-Counter -ListSet *"]:::lItem
        L1["Pipe to Select CounterSetName"]:::lItem
        L2["Find what is available"]:::lItem
    end
    subgraph R ["Top 10 by CPU"]
        direction TB
        R0["Get-Process"]:::rItem
        R1["Sort-Object CPU -Descending"]:::rItem
        R2["Select -First 10"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
