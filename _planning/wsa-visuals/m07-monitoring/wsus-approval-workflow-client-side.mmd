flowchart LR
    Sync["Sync<br/>from Microsoft"]:::n_Sync
    Await["Awaiting<br/>Approval"]:::n_Await
    Pilot["Pilot Ring<br/>(test group)"]:::n_Pilot
    All["All Computers<br/>(production)"]:::n_All
    Sync --> Await
    Await -->|"approve test"| Pilot
    Pilot -->|"verified — roll out"| All
    classDef n_Sync fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Await fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Pilot fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_All fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
