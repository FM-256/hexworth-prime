---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Get-SmbSession"]
        direction TB
        L0["Who is connected RIGHT NOW"]:::lItem
        L1["Active session list"]:::lItem
        L2["Client computer + user"]:::lItem
        L3["Debug a stuck connection"]:::lItem
    end
    subgraph R ["Get-SmbOpenFile"]
        direction TB
        R0["Which files are open NOW"]:::rItem
        R1["File path + lock owner"]:::rItem
        R2["Debug a stuck lock"]:::rItem
        R3["Quota / lease issues"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
