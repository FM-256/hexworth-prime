---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Inspect NTFS ACL"]
        direction TB
        L0["Get-Acl D:\Data"]:::lItem
        L1["| Format-List"]:::lItem
        L2["Read existing rules"]:::lItem
        L3["Audit before change"]:::lItem
    end
    subgraph R ["Grant share access"]
        direction TB
        R0["Grant-SmbShareAccess"]:::rItem
        R1["-Name Data"]:::rItem
        R2["-AccountName Domain\ITGroup"]:::rItem
        R3["-AccessRight Change"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
