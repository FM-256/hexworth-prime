---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["MBR — Master Boot Record"]
        direction TB
        L0["Max disk: 2 TB"]:::lItem
        L1["Max partitions: 4 primary<br/>(or 3 + extended)"]:::lItem
        L2["Boot mode: BIOS (Legacy)"]:::lItem
        L3["Single partition table"]:::lItem
    end
    subgraph R ["GPT — GUID Partition Table"]
        direction TB
        R0["Max disk: 18 EB (exabytes)"]:::rItem
        R1["Max partitions: 128"]:::rItem
        R2["Boot mode: UEFI"]:::rItem
        R3["Backup table at disk end"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
