---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Disk["Initialized disk"]:::n_Disk
    NewP["New-Partition<br/>-UseMaximumSize<br/>-AssignDriveLetter"]:::n_NewP
    Part["Partition<br/>+ drive letter"]:::n_Part
    FV["Format-Volume<br/>-FileSystem NTFS<br/>-NewFileSystemLabel Data"]:::n_FV
    Vol["Mounted Volume<br/>ready to use"]:::n_Vol
    Disk -->|"carve"| NewP
    NewP --> Part
    Part -->|"format"| FV
    FV --> Vol
    classDef n_Disk fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_NewP fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Part fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_FV fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Vol fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
