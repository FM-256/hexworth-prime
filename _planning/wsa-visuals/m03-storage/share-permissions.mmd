---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Share Permissions"]
        direction TB
        L0["Apply only over network"]:::lItem
        L1["3 levels: Read, Change, Full"]:::lItem
        L2["Coarse-grained"]:::lItem
        L3["Set on share properties"]:::lItem
    end
    subgraph R ["NTFS Permissions"]
        direction TB
        R0["Apply always (local + network)"]:::rItem
        R1["Granular: Read / Write / Modify / Full"]:::rItem
        R2["Inheritance from parent folders"]:::rItem
        R3["The 'real' permissions"]:::rItem
        R4["Most restrictive wins"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
