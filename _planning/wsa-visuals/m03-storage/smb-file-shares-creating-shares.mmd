---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI — Server Manager"]
        direction TB
        L0["File &amp; Storage Services"]:::lItem
        L1["Shares → Tasks → New Share"]:::lItem
        L2["Select profile<br/>(Quick / Advanced)"]:::lItem
        L3["Set path + permissions"]:::lItem
    end
    subgraph R ["PowerShell — New-SmbShare"]
        direction TB
        R0["-Name Data"]:::rItem
        R1["-Path D:\Shared\Data"]:::rItem
        R2["-FullAccess Admins"]:::rItem
        R3["-ChangeAccess Users"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
