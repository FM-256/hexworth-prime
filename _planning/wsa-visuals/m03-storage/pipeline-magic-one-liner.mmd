---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    GD["Get-Disk 2"]:::n_GD
    ID["Initialize-Disk<br/>-PartitionStyle GPT<br/>-PassThru"]:::n_ID
    NP["New-Partition<br/>-UseMaximumSize<br/>-AssignDriveLetter"]:::n_NP
    FV["Format-Volume<br/>-FileSystem NTFS<br/>-NewFileSystemLabel Backup"]:::n_FV
    Done["Ready volume<br/>in one command"]:::n_Done
    GD -->|"|"| ID
    ID -->|"|"| NP
    NP -->|"|"| FV
    FV --> Done
    classDef n_GD fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_ID fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_NP fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_FV fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Done fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
