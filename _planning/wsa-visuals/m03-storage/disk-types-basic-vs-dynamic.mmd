---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Basic Disks"]
        direction TB
        L0["Default disk type in Windows"]:::lItem
        L1["Uses partitions<br/>(primary, extended, logical)"]:::lItem
        L2["Compatible with all OS versions"]:::lItem
        L3["Prefer Basic + GPT"]:::lItem
    end
    subgraph R ["Dynamic Disks"]
        direction TB
        R0["Uses volumes (not partitions)"]:::rItem
        R1["Supports spanning across disks"]:::rItem
        R2["Software RAID — strip / mirror"]:::rItem
        R3["Being replaced by Storage Spaces"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
