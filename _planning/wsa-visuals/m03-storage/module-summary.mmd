---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Key Takeaways"]
        direction TB
        L0["GPT over MBR<br/>(disks &gt; 2TB or UEFI)"]:::lItem
        L1["Basic Disks preferred"]:::lItem
        L2["Storage Spaces — pool + VD + vol"]:::lItem
        L3["SMB 3.x + NTFS<br/>share Everyone:Full, NTFS controls"]:::lItem
    end
    subgraph R ["Key Cmdlets"]
        direction TB
        R0["Get-Disk · Get-Volume"]:::rItem
        R1["Initialize-Disk | New-Partition<br/>| Format-Volume"]:::rItem
        R2["New-SmbShare"]:::rItem
        R3["Grant-SmbShareAccess"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
