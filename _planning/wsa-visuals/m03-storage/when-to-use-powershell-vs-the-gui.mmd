---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    PD["Physical Disks<br/>(raw drives)"]:::n_PD
    Pool["Storage Pool<br/>logical container"]:::n_Pool
    VD["Virtual Disk<br/>resiliency chosen here<br/>(mirror / parity / simple)"]:::n_VD
    Vol["Volume<br/>formatted + drive letter"]:::n_Vol
    PD -->|"combine"| Pool
    Pool -->|"carve"| VD
    VD -->|"format"| Vol
    classDef n_PD fill:#9ca3af,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Pool fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_VD fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Vol fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
