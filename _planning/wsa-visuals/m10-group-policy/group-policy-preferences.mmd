---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Policies (Enforced)"]
        direction TB
        L0["Settings locked<br/>(grayed out)"]:::lItem
        L1["Removed when GPO<br/>no longer applies"]:::lItem
        L2["Stored under<br/>Policies registry key"]:::lItem
        L3["Users cannot change"]:::lItem
    end
    subgraph R ["Preferences (Initial)"]
        direction TB
        R0["Users can modify"]:::rItem
        R1["Persist if GPO removed"]:::rItem
        R2["Item-level targeting"]:::rItem
        R3["Drive maps, printers,<br/>scheduled tasks"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
