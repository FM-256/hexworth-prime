---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Computer Config"]
        direction TB
        L0["Applies at startup"]:::lItem
        L1["Firewall, software install"]:::lItem
        L2["Security settings"]:::lItem
        L3["Loopback Replace:<br/>computer GPO only"]:::lItem
        L4["Loopback Merge:<br/>user + computer override"]:::lItem
    end
    subgraph R ["User Config"]
        direction TB
        R0["Applies at logon"]:::rItem
        R1["Drives, scripts, settings"]:::rItem
        R2["Start menu, desktop"]:::rItem
        R3["Filtered by user OU<br/>by default"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
