---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    GPO["GPO<br/>Marketing-Restrictions"]:::n_GPO
    Auth["Authenticated Users<br/>(default — remove)"]:::n_Auth
    Target["Marketing group<br/>Read + Apply"]:::n_Target
    DC["Domain Computers<br/>Read only<br/>(MS16-072)"]:::n_DC
    User["Marketing user<br/>logs on"]:::n_User
    GPO -..->|"remove"| Auth
    GPO -->|"add"| Target
    GPO -->|"machine evaluates"| DC
    Target -->|"applies"| User
    classDef n_GPO fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Auth fill:#9ca3af,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Target fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DC fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_User fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
