---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    GPO["Group Policy Object<br/>(GUID)"]:::n_GPO
    GPC["GPC — Container<br/>metadata in AD"]:::n_GPC
    GPT["GPT — Template<br/>settings in SYSVOL"]:::n_GPT
    ADR["AD replication<br/>(GPC)"]:::n_ADR
    DFSR["DFS-R replication<br/>(GPT)"]:::n_DFSR
    Machine["SYSVOL\Machine<br/>Registry.pol + Scripts"]:::n_Machine
    User["SYSVOL\User<br/>Registry.pol + Scripts"]:::n_User
    GPTini["GPT.ini<br/>(version)"]:::n_GPTini
    GPO --> GPC
    GPO --> GPT
    GPC -..-> ADR
    GPT -..-> DFSR
    GPT --> Machine
    GPT --> User
    GPT --> GPTini
    classDef n_GPO fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_GPC fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_GPT fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_ADR fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DFSR fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Machine fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_User fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_GPTini fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
