---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    L["L — Local<br/>local GPO on machine"]:::n_L
    S["S — Site<br/>AD site-level GPOs"]:::n_S
    D["D — Domain<br/>domain-level GPOs"]:::n_D
    OU1["O — Parent OU<br/>top-level OU GPOs"]:::n_OU1
    OU2["U — Child OU<br/>nested OU GPOs<br/>(last writer wins)"]:::n_OU2
    Enf["Enforced GPO<br/>overrides everything"]:::n_Enf
    L -->|"①"| S
    S -->|"②"| D
    D -->|"③"| OU1
    OU1 -->|"④ last wins"| OU2
    Enf -..->|"always overrides"| OU2
    classDef n_L fill:#9ca3af,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_S fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_D fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_OU1 fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_OU2 fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Enf fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
