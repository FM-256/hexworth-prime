---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Backup["C:\GPOBackups<br/>(backup folder)"]:::n_Backup
    Restore["Restore-GPO<br/>restore in place"]:::n_Restore
    Import["Import-GPO -TargetName<br/>(new GPO)"]:::n_Import
    Orig["SEC-Baseline<br/>(restored)"]:::n_Orig
    New["SEC-Baseline-NEW<br/>(cross-domain copy)"]:::n_New
    Links["Re-link to OU /<br/>site / domain"]:::n_Links
    Backup --> Restore
    Backup --> Import
    Restore --> Orig
    Import --> New
    Orig -..->|"manual"| Links
    New -..->|"manual"| Links
    classDef n_Backup fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Restore fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Import fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Orig fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_New fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Links fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
