    NewGPO -->|"①"| GPO
    NewLink -->|"② link"| GPO
    GPO -->|"③ applies"| OU
    GPO -..->|"delete link ≠ delete GPO"| Unlinked
    classDef n_NewGPO fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_GPO fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_NewLink fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_OU fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Unlinked fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
