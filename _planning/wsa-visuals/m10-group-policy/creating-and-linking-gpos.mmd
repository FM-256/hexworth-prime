config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    NewGPO["New-GPO<br/>(creates object)"]:::n_NewGPO
    GPO["GPO<br/>SEC-Workstation-Baseline"]:::n_GPO
