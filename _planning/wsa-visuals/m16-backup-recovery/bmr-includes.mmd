---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["System State"]
        direction TB
        L0["Registry + COM+ + boot"]:::lItem
        L1["AD / SYSVOL / CertSrv"]:::lItem
        L2["NO data volumes"]:::lItem
        L3["NO partition layout"]:::lItem
        L4["Smallest backup<br/>that restores AD"]:::lItem
    end
    subgraph R ["BMR"]
        direction TB
        R0["Includes System State"]:::rItem
        R1["+ ALL critical volumes"]:::rItem
        R2["+ Partition layout"]:::rItem
        R3["+ Boot configuration"]:::rItem
        R4["Restores bare hardware<br/>from scratch"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
