---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["All Roles"]
        direction TB
        L0["Registry"]:::lItem
        L1["COM+ class DB"]:::lItem
        L2["Boot files"]:::lItem
        L3["Windows File Protection<br/>(WFP)"]:::lItem
        L4["Performance counters"]:::lItem
    end
    subgraph R ["Role-Specific"]
        direction TB
        R0["AD: NTDS.dit"]:::rItem
        R1["AD: SYSVOL"]:::rItem
        R2["AD CS: CertSrv DB"]:::rItem
        R3["Cluster: cluster DB"]:::rItem
        R4["IIS: metabase"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
