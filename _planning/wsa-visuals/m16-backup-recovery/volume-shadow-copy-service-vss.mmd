---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    App["Backup App<br/>(Requestor)"]:::n_App
    VSSsvc["VSS Service"]:::n_VSSsvc
    Writer["VSS Writer<br/>(SQL, AD, Exchange)"]:::n_Writer
    Provider["VSS Provider<br/>(snapshot engine)"]:::n_Provider
    Vol["Volume<br/>(C: / E:)"]:::n_Vol
    Snap["Shadow Copy<br/>(point-in-time)"]:::n_Snap
    App -->|"① request snapshot"| VSSsvc
    VSSsvc -->|"② freeze writers"| Writer
    VSSsvc -->|"③ create snapshot"| Provider
    Provider -->|"④ copy-on-write"| Vol
    Provider -->|"⑤ expose"| Snap
    VSSsvc -..->|"⑥ thaw writers"| Writer
    classDef n_App fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_VSSsvc fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Writer fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Provider fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Vol fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Snap fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
