---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI Lab"]
        direction TB
        L0["① WSB config + schedule"]:::lItem
        L1["② System State backup"]:::lItem
        L2["③ Browse + restore<br/>specific files"]:::lItem
        L3["④ Test AD object recovery"]:::lItem
    end
    subgraph R ["PowerShell Lab"]
        direction TB
        R0["① WBAdmin policies"]:::rItem
        R1["② Set-WBSchedule"]:::rItem
        R2["③ Get-WBJob status"]:::rItem
        R3["④ Start-WBVolumeRecovery"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
