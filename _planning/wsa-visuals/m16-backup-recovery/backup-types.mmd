config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    Root["Backup Strategy"]:::root
    C0["Full"]:::c0
    Root --> C0
    C0_0["All data every run"]:::sub0
    C0 --> C0_0
    C0_1["Slowest backup"]:::sub0
    C0 --> C0_1
    C0_2["Fastest restore<br/>(one set)"]:::sub0
    C0 --> C0_2
    C1["Incremental"]:::c1
    Root --> C1
    C1_0["Only changed since<br/>LAST backup"]:::sub1
    C1 --> C1_0
    C1_1["Smallest, fastest"]:::sub1
    C1 --> C1_1
    C1_2["Restore needs full +<br/>EVERY incremental"]:::sub1
    C1 --> C1_2
    C2["Differential"]:::c2
    Root --> C2
    C2_0["Changed since LAST FULL"]:::sub2
    C2 --> C2_0
    C2_1["Grows over time"]:::sub2
    C2 --> C2_1
    C2_2["Restore needs full +<br/>latest differential"]:::sub2
    C2 --> C2_2
    classDef root fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
