---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["App-Consistent"]
        direction TB
        L0["Writer exists for app"]:::lItem
        L1["In-flight writes flushed"]:::lItem
        L2["Restore = clean state"]:::lItem
        L3["SQL, AD, Exchange"]:::lItem
    end
    subgraph R ["Crash-Consistent"]
        direction TB
        R0["No Writer registered"]:::rItem
        R1["Snapshot taken mid-write"]:::rItem
        R2["Restore = like power loss"]:::rItem
        R3["Generic file servers"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
