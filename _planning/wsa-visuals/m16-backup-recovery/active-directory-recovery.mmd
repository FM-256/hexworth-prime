---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Non-Authoritative"]
        direction TB
        L0["Default mode"]:::lItem
        L1["Partners replicate IN<br/>and update the DC"]:::lItem
        L2["Use for DC hardware failure"]:::lItem
        L3["No object resurrection"]:::lItem
    end
    subgraph R ["Authoritative"]
        direction TB
        R0["Restores deleted objects"]:::rItem
        R1["DSRM + ntdsutil<br/>"authoritative restore""]:::rItem
        R2["Object replicates OUT<br/>to partners"]:::rItem
        R3["Used to undo accidental delete"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
