---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Default Documents"]
        direction TB
        L0["Ordered list IIS walks"]:::lItem
        L1["First match wins"]:::lItem
        L2["default.htm, index.html,<br/>home.html, default.aspx"]:::lItem
        L3["Add-WebConfiguration<br/>defaultDocument/files"]:::lItem
    end
    subgraph R ["Directory Browsing"]
        direction TB
        R0["Off by default<br/>(prevents info disclosure)"]:::rItem
        R1["Enable only for<br/>download sites"]:::rItem
        R2["Per-path scope"]:::rItem
        R3["Scope to /docs only"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
