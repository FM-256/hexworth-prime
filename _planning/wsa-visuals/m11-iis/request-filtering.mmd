---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Filters"]
        direction TB
        L0["File extensions<br/>(block .bak, .config)"]:::lItem
        L1["URL sequences<br/>(block dot-dot traversal)"]:::lItem
        L2["HTTP verbs<br/>(block TRACE, PUT)"]:::lItem
        L3["Hidden segments<br/>(/bin, /App_Data)"]:::lItem
    end
    subgraph R ["Limits"]
        direction TB
        R0["Max content: 30 MB"]:::rItem
        R1["Max URL: 4096 bytes"]:::rItem
        R2["Max query string:<br/>2048 bytes"]:::rItem
        R3["Reject double-encoded URLs"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
