---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI Lab"]
        direction TB
        L0["Site + bindings"]:::lItem
        L1["App pool + VDir"]:::lItem
        L2["Authentication + SSL"]:::lItem
        L3["IIS Manager workflow"]:::lItem
    end
    subgraph R ["PowerShell Lab"]
        direction TB
        R0["WebAdmin sites + pools"]:::rItem
        R1["Authentication + filtering"]:::rItem
        R2["FTP w/ SSL"]:::rItem
        R3["Scriptable + idempotent"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
