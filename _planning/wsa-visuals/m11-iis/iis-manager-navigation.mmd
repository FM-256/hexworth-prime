---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Connection Pane"]
        direction TB
        L0["Server node<br/>(global features)"]:::lItem
        L1["Sites collection<br/>(each website)"]:::lItem
        L2["App Pools collection"]:::lItem
        L3["Expand for apps + VDirs"]:::lItem
    end
    subgraph R ["Feature View"]
        direction TB
        R0["IIS group<br/>(bindings, auth, SSL)"]:::rItem
        R1["ASP.NET group<br/>(connection strings, etc)"]:::rItem
        R2["Management group<br/>(delegation, editor)"]:::rItem
        R3["Double-click to configure"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
