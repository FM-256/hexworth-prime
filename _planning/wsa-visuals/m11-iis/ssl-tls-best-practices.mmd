---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Protocols"]
        direction TB
        L0["Disable SSL 2/3"]:::lItem
        L1["Disable TLS 1.0 / 1.1"]:::lItem
        L2["Enable TLS 1.2"]:::lItem
        L3["Enable TLS 1.3"]:::lItem
        L4["Strong ciphers + PFS"]:::lItem
    end
    subgraph R ["Certificate Practices"]
        direction TB
        R0["2048-bit RSA minimum"]:::rItem
        R1["Include all SANs"]:::rItem
        R2["Renewal alerts"]:::rItem
        R3["HSTS enabled"]:::rItem
        R4["OCSP stapling"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
