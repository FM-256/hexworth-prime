---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Formats"]
        direction TB
        L0["W3C Extended<br/>(default, customizable)"]:::lItem
        L1["IIS"]:::lItem
        L2["NCSA Common"]:::lItem
        L3["Custom (ETW)"]:::lItem
    end
    subgraph R ["Fields"]
        direction TB
        R0["Date, Time, Client IP"]:::rItem
        R1["Method, URI, Status"]:::rItem
        R2["Bytes sent / received"]:::rItem
        R3["User-Agent, Referer"]:::rItem
        R4["Time-Taken (ms)"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
