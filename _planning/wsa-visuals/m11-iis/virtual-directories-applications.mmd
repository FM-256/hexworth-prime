---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Virtual Directory"]
        direction TB
        L0["URL → folder mapping"]:::lItem
        L1["Inherits parent app pool"]:::lItem
        L2["No own config scope"]:::lItem
        L3["New-WebVirtualDirectory"]:::lItem
        L4["e.g. /docs → D:\Documentation"]:::lItem
    end
    subgraph R ["Web Application"]
        direction TB
        R0["Own configuration scope"]:::rItem
        R1["Can use its own pool"]:::rItem
        R2["Process isolation"]:::rItem
        R3["New-WebApplication"]:::rItem
        R4["e.g. /api with APIAppPool"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
