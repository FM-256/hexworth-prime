---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Features"]
        direction TB
        L0["File mgmt over HTTP(S)"]:::lItem
        L1["Explorer "Map network drive""]:::lItem
        L2["Authoring + locking"]:::lItem
        L3["Custom MIME types"]:::lItem
    end
    subgraph R ["Authoring Rules"]
        direction TB
        R0["Per-path R/W permissions"]:::rItem
        R1["Require HTTPS"]:::rItem
        R2["Per-user / per-role scope"]:::rItem
        R3["Set-WebConfigurationProperty<br/>webdav/authoring enabled"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
