---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    Req["Incoming HTTP"]:::n_Req
    HTTPsys["HTTP.sys<br/>kernel queue"]:::n_HTTPsys
    WAS["WAS<br/>picks pool"]:::n_WAS
    W3["W3SVC<br/>routes worker"]:::n_W3
    Worker["w3wp.exe<br/>module pipeline"]:::n_Worker
    Integrated["Integrated Pipeline<br/>native + managed unified<br/>(default IIS 7+)"]:::n_Integrated
    Classic["Classic Pipeline<br/>separate ISAPI / .NET<br/>(legacy)"]:::n_Classic
    Resp["HTTP response"]:::n_Resp
    Req --> HTTPsys
    HTTPsys -->|"①"| WAS
    WAS -->|"②"| W3
    W3 -->|"③"| Worker
    Worker -->|"mode A"| Integrated
    Worker -..->|"mode B"| Classic
    Integrated --> Resp
    Classic -..-> Resp
    classDef n_Req fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_HTTPsys fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_WAS fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_W3 fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Worker fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Integrated fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Classic fill:#9ca3af,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Resp fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
