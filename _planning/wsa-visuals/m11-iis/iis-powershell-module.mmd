---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["WebAdministration (Legacy)"]
        direction TB
        L0["IIS: PSDrive provider"]:::lItem
        L1["Navigate like file system"]:::lItem
        L2["Broad compatibility"]:::lItem
        L3["New-Website, Get-WebBinding"]:::lItem
        L4["IIS 7.0+"]:::lItem
    end
    subgraph R ["IISAdministration (Modern)"]
        direction TB
        R0["Pipeline-friendly objects"]:::rItem
        R1["Better performance"]:::rItem
        R2["Available on IIS 10+"]:::rItem
        R3["Get-IISSite, New-IISSite"]:::rItem
        R4["Recommended for scripts"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
