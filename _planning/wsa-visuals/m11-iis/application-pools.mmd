---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Benefits"]
        direction TB
        L0["Process isolation —<br/>crash containment"]:::lItem
        L1["Distinct identity<br/>per pool"]:::lItem
        L2["Independent recycling"]:::lItem
        L3["Per-pool .NET CLR version"]:::lItem
    end
    subgraph R ["Identities"]
        direction TB
        R0["ApplicationPoolIdentity<br/>(default, virtual account)"]:::rItem
        R1["NetworkService<br/>(legacy)"]:::rItem
        R2["LocalSystem (avoid)"]:::rItem
        R3["Custom domain account"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
