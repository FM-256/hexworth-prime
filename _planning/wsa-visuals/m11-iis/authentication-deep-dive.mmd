---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Anonymous / Basic"]
        direction TB
        L0["Anonymous:<br/>IUSR account<br/>public sites"]:::lItem
        L1["Basic:<br/>Base64 credentials<br/>HTTPS required"]:::lItem
        L2["No interactive prompt<br/>for Anonymous"]:::lItem
        L3["Browser prompt<br/>for Basic"]:::lItem
    end
    subgraph R ["Digest / Windows"]
        direction TB
        R0["Digest:<br/>MD5 hash<br/>AD-bound, legacy"]:::rItem
        R1["Windows:<br/>Kerberos + NTLM<br/>intranet SSO"]:::rItem
        R2["No credential transit<br/>(Kerberos ticket)"]:::rItem
        R3["Browser autonegotiates"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#9ca3af,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
