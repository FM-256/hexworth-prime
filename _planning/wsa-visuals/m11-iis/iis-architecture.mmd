flowchart TB
    Client["HTTP Client"]:::n_Client
    Kernel["HTTP.sys<br/>(kernel mode)<br/>queues request"]:::n_Kernel
    WAS["WAS<br/>Windows Activation<br/>picks app pool"]:::n_WAS
    W3SVC["W3SVC<br/>WWW service<br/>routes to worker"]:::n_W3SVC
    Worker["w3wp.exe<br/>worker process<br/>runs module pipeline"]:::n_Worker
    Native["Native modules<br/>(C++)"]:::n_Native
    Managed["Managed modules<br/>(.NET)"]:::n_Managed
    Client -->|"HTTP request"| Kernel
    Kernel -->|"①"| WAS
    WAS -->|"②"| W3SVC
    W3SVC -->|"③ dispatch"| Worker
    Worker -->|"load"| Native
    Worker -->|"load"| Managed
    classDef n_Client fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Kernel fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_WAS fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_W3SVC fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Worker fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Native fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Managed fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
