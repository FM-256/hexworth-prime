---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Triggers["Recycling Triggers"]:::n_Triggers
    Time["Time<br/>1740 min default"]:::n_Time
    Mem["Memory<br/>private bytes cap"]:::n_Mem
    Req["Request count<br/>threshold"]:::n_Req
    Old["Old w3wp.exe<br/>in-flight reqs finish"]:::n_Old
    Overlap["Overlapped Recycle<br/>new w3wp starts<br/>before old exits"]:::n_Overlap
    New["New w3wp.exe<br/>serves new requests"]:::n_New
    Time --> Triggers
    Mem --> Triggers
    Req --> Triggers
    Triggers --> Overlap
    Overlap -->|"①"| New
    Overlap -..->|"② drain"| Old
    classDef n_Triggers fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Time fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Mem fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Req fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Old fill:#9ca3af,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Overlap fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_New fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
