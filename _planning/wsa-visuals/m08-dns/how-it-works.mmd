---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    Boot["Client boots"]:::n_Boot
    DHCP["DHCP gives IP"]:::n_DHCP
    Update["Client sends DDNS<br/>update to DNS"]:::n_Update
    Auth["DNS authenticates<br/>(if secure mode)"]:::n_Auth
    A["A record created<br/>/ updated"]:::n_A
    PTR["DHCP can register<br/>PTR records"]:::n_PTR
    Boot --> DHCP
    DHCP --> Update
    Update --> Auth
    Auth --> A
    A --> PTR
    classDef n_Boot fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DHCP fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Update fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Auth fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_A fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_PTR fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
