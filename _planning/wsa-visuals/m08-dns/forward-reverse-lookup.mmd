---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Forward Lookup"]
        direction TB
        L0["Name → IP"]:::lItem
        L1["dc01.hexworth.local<br/>→ 192.168.1.10"]:::lItem
        L2["Most common"]:::lItem
        L3["A · AAAA · CNAME records"]:::lItem
    end
    subgraph R ["Reverse Lookup"]
        direction TB
        R0["IP → Name"]:::rItem
        R1["10.1.168.192.in-addr.arpa<br/>→ dc01.hexworth.local"]:::rItem
        R2["Logging · security · spam"]:::rItem
        R3["PTR records"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
