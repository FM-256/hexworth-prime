config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    Client["Client<br/>(browser / app)"]:::n_Client
    Resolver["Recursive Resolver<br/>(ISP / 8.8.8.8)"]:::n_Resolver
    Root["Root (.)<br/>13 root server clusters"]:::n_Root
    TLD["TLD Server<br/>(.com / .org / .local)"]:::n_TLD
    Auth["Authoritative Server<br/>(hexworth.local)"]:::n_Auth
    Client -->|"① query FQDN"| Resolver
    Resolver -->|"② ask root"| Root
    Root -->|"③ refer to TLD"| TLD
    TLD -->|"④ refer to authoritative"| Auth
    Auth -..->|"⑤ answer + TTL"| Client
    classDef n_Client fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Resolver fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Root fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_TLD fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Auth fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
