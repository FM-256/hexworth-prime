---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Primary Zone"]
        direction TB
        L0["Read / write copy"]:::lItem
        L1["One primary per zone"]:::lItem
        L2["Source for zone transfers"]:::lItem
        L3["Can be AD-integrated"]:::lItem
    end
    subgraph R ["Secondary Zone"]
        direction TB
        R0["Read-only copy"]:::rItem
        R1["Multiple allowed"]:::rItem
        R2["Provides redundancy"]:::rItem
        R3["Gets data via zone transfer"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
