---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["List Records"]
        direction TB
        L0["Get-DnsServerResourceRecord"]:::lItem
        L1["-ZoneName #quot;hexworth.local#quot;"]:::lItem
        L2["Audit zone contents"]:::lItem
    end
    subgraph R ["Test Records"]
        direction TB
        R0["Resolve-DnsName -Name<br/>#quot;web01.hexworth.local#quot;"]:::rItem
        R1["PowerShell-native query"]:::rItem
        R2["Typed output object"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
