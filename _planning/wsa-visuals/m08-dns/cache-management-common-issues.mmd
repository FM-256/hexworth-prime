---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Cache Commands"]
        direction TB
        L0["Clear-DnsClientCache<br/>(client)"]:::lItem
        L1["Clear-DnsServerCache<br/>(server)"]:::lItem
        L2["Get-DnsClientCache<br/>(inspect)"]:::lItem
    end
    subgraph R ["Common Issues"]
        direction TB
        R0["Stale records<br/>(enable scavenging)"]:::rItem
        R1["Missing SRV<br/>(nltest /dsregdns)"]:::rItem
        R2["Wrong DNS server"]:::rItem
        R3["Forwarder timeout"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
