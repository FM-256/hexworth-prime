---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Standard Forwarder"]
        direction TB
        L0["ALL external queries"]:::lItem
        L1["ISP or public DNS<br/>(8.8.8.8 / 8.8.4.4)"]:::lItem
        L2["Set-DnsServerForwarder"]:::lItem
    end
    subgraph R ["Conditional Forwarder"]
        direction TB
        R0["Specific domains only"]:::rItem
        R1["Essential for AD trusts"]:::rItem
        R2["Add-DnsServerConditional<br/>ForwarderZone -Name partner.com"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
