---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["nslookup"]
        direction TB
        L0["nslookup dc01.hexworth.local"]:::lItem
        L1["nslookup -type=mx<br/>hexworth.local"]:::lItem
        L2["cross-platform classic"]:::lItem
    end
    subgraph R ["Resolve-DnsName"]
        direction TB
        R0["-Name "dc01.hexworth.local""]:::rItem
        R1["-Type A | AAAA | MX | SRV"]:::rItem
        R2["PowerShell-native + typed"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
