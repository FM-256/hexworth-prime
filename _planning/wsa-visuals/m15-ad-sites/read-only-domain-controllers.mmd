---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Characteristics"]
        direction TB
        L0["One-way inbound replication"]:::lItem
        L1["No AD changes accepted"]:::lItem
        L2["No passwords cached<br/>by default"]:::lItem
        L3["Filtered attribute set"]:::lItem
    end
    subgraph R ["Use Cases"]
        direction TB
        R0["Branch offices"]:::rItem
        R1["DMZ / perimeter"]:::rItem
        R2["Physically insecure sites"]:::rItem
        R3["Admin Role Separation<br/>(local admin ≠ Domain Admin)"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
