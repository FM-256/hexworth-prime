---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Connectivity"]
        direction TB
        L0["Time skew (>5 min = fail)"]:::lItem
        L1["DNS SRV records<br/>(_msdcs)"]:::lItem
        L2["RPC / firewall ports"]:::lItem
    end
    subgraph R ["Replication + Convergence"]
        direction TB
        R0["repadmin /replsummary"]:::rItem
        R1["repadmin /showrepl"]:::rItem
        R2["Test object on<br/>partner DCs"]:::rItem
        R3["dcdiag for health"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
