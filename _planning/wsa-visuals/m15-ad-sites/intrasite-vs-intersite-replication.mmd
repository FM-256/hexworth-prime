---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Intrasite"]
        direction TB
        L0["Change-notify<br/>(near-instant)"]:::lItem
        L1["Uncompressed"]:::lItem
        L2["Ring topology"]:::lItem
        L3["KCC auto-builds<br/>connection objects"]:::lItem
    end
    subgraph R ["Intersite"]
        direction TB
        R0["Scheduled<br/>(default 180 min)"]:::rItem
        R1["Compressed (CPU cost)"]:::rItem
        R2["Via bridgehead servers"]:::rItem
        R3["Spanning tree<br/>from site links"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
