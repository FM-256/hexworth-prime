---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Properties"]
        direction TB
        L0["Cost (lower = preferred)"]:::lItem
        L1["Interval (min 15 min)"]:::lItem
        L2["Schedule (when allowed)"]:::lItem
        L3["Transport (IP / SMTP)"]:::lItem
    end
    subgraph R ["Default Link"]
        direction TB
        R0["DEFAULTIPSITELINK<br/>auto-created"]:::rItem
        R1["Cost: 100"]:::rItem
        R2["Interval: 180 min"]:::rItem
        R3["Schedule: 24x7"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
