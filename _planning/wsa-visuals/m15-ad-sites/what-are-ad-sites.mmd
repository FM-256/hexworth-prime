---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Purpose"]
        direction TB
        L0["Control replication flow"]:::lItem
        L1["Direct clients to local DC"]:::lItem
        L2["Optimize for slow WAN links"]:::lItem
    end
    subgraph R ["Components"]
        direction TB
        R0["Sites"]:::rItem
        R1["Subnets"]:::rItem
        R2["Site Links"]:::rItem
        R3["Servers (DCs)<br/>assigned to sites"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
