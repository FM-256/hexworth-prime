---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    KCC["KCC<br/>(every DC, every 15 min)"]:::n_KCC
    Intra["Intrasite topology<br/>full mesh ≤7 DCs, else ring"]:::n_Intra
    ISTG["ISTG<br/>(one DC per site)"]:::n_ISTG
    Inter["Intersite topology<br/>spanning tree, compressed"]:::n_Inter
    BH["Bridgehead<br/>servers"]:::n_BH
    KCC -->|"builds"| Intra
    KCC -->|"elects"| ISTG
    ISTG -->|"computes"| Inter
    Inter -->|"selects"| BH
    classDef n_KCC fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Intra fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_ISTG fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Inter fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_BH fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
