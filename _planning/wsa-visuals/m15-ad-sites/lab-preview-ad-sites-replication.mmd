---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI Lab"]
        direction TB
        L0["Create sites + subnets"]:::lItem
        L1["Build site links"]:::lItem
        L2["View topology<br/>(AD Sites + Services)"]:::lItem
        L3["Force replication"]:::lItem
    end
    subgraph R ["PowerShell Lab"]
        direction TB
        R0["New-ADReplicationSite"]:::rItem
        R1["New-ADReplicationSubnet"]:::rItem
        R2["New-ADReplicationSiteLink"]:::rItem
        R3["repadmin / Get-ADReplication..."]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
