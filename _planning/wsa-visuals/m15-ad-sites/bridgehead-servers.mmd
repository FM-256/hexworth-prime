---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    SiteA["Site A"]:::n_SiteA
    BHA["Bridgehead A<br/>(KCC-selected)"]:::n_BHA
    DC1A["DC1 Site A"]:::n_DC1A
    DC2A["DC2 Site A"]:::n_DC2A
    SiteB["Site B"]:::n_SiteB
    BHB["Bridgehead B<br/>(KCC-selected)"]:::n_BHB
    DC1B["DC1 Site B"]:::n_DC1B
    DC2B["DC2 Site B"]:::n_DC2B
    DC1A --> BHA
    DC2A --> BHA
    BHA -->|"compressed<br/>replication"| BHB
    BHB --> DC1B
    BHB --> DC2B
    SiteA -..-> BHA
    SiteB -..-> BHB
    classDef n_SiteA fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_BHA fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DC1A fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DC2A fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_SiteB fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_BHB fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DC1B fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DC2B fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
