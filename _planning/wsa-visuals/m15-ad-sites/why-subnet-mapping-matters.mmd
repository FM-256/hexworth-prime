---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    H["Subnet → Site Mapping"]:::head
    I0["Clients find nearest DC<br/>via subnet → site lookup"]:::item
    H --> I0
    I1["DC locator uses<br/>site-aware SRV records"]:::item
    H --> I1
    I2["No match = falls back to<br/>random DC, possible cross-WAN"]:::item
    H --> I2
    I3["Unmapped clients = wrong<br/>GPO link, slow logon"]:::item
    H --> I3
    classDef head fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef item fill:#0c1a2e,color:#fff,stroke:#9ca3af,stroke-width:1px
