---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["FRS (Legacy)"]
        direction TB
        L0["File Replication Service"]:::lItem
        L1["Used Windows 2000 / 2003"]:::lItem
        L2["Single-master conflict"]:::lItem
        L3["Deprecated — migrate away"]:::lItem
    end
    subgraph R ["DFS-R (Modern)"]
        direction TB
        R0["Distributed File System<br/>Replication"]:::rItem
        R1["Default since Server 2008"]:::rItem
        R2["RDC for bandwidth efficiency"]:::rItem
        R3["Better conflict handling"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
