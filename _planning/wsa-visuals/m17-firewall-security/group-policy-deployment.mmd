    ServerOU -->|"applies"| Effective
    Local -..->|"optional"| Effective
    classDef n_Domain fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_ServerOU fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Local fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Effective fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
