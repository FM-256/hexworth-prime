---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Inbound Rules"]
        direction TB
        L0["Block unsolicited by default"]:::lItem
        L1["Filter by program / port / IP"]:::lItem
        L2["Criteria: Program · Port ·<br/>Predefined · Custom"]:::lItem
    end
    subgraph R ["Outbound Rules"]
        direction TB
        R0["Allow all by default"]:::rItem
        R1["Restrictive = block exfil"]:::rItem
        R2["Same criteria set as inbound"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
