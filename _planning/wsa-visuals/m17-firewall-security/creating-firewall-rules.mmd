    classDef n_Scope fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Action fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Profile fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
