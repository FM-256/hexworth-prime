---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI Lab"]
        direction TB
        L0["Configure profiles"]:::lItem
        L1["Add inbound rules"]:::lItem
        L2["Port exceptions"]:::lItem
        L3["Enable logging"]:::lItem
    end
    subgraph R ["PowerShell Lab"]
        direction TB
        R0["Set-NetFirewallProfile"]:::rItem
        R1["New-NetFirewallRule"]:::rItem
        R2["Query + filter rules"]:::rItem
        R3["Logging + connectivity test"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
