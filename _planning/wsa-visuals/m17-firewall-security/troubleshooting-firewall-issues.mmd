---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    Start["Connection failing?"]:::n_Start
    Q1["① Firewall the cause?<br/>Disable Domain profile,<br/>retest"]:::n_Q1
    Q2["② Which rule?<br/>Enable LogBlocked,<br/>reproduce, check log"]:::n_Q2
    Q3["③ Which profile?<br/>Get-NetConnectionProfile<br/>iface = Public ≠ Domain rule"]:::n_Q3
    Fixed["Rule corrected"]:::n_Fixed
    Start -->|"isolate"| Q1
    Q1 -->|"still blocked"| Q2
    Q2 -->|"rule exists but inactive"| Q3
    Q3 -->|"profile aligned"| Fixed
    classDef n_Start fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Q1 fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Q2 fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Q3 fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Fixed fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
