---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Superscope"]
        direction TB
        L0["Groups scopes sharing<br/>one physical network"]:::lItem
        L1["Multi-subnet segment"]:::lItem
        L2["Gradual IP expansion"]:::lItem
        L3["Migration scenarios"]:::lItem
    end
    subgraph R ["Multicast (MADCAP)"]
        direction TB
        R0["Assigns 224.0.0.0 – 239.255.255.255"]:::rItem
        R1["Streaming workloads"]:::rItem
        R2["Video conferencing"]:::rItem
        R3["WDS deployment"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
