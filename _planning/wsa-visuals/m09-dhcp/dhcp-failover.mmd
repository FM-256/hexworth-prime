---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Hot Standby"]
        direction TB
        L0["Primary leads"]:::lItem
        L1["Secondary takes over<br/>on failure"]:::lItem
        L2["Branch / HQ topology"]:::lItem
        L3["Asymmetric workload"]:::lItem
    end
    subgraph R ["Load Balance"]
        direction TB
        R0["Both serve 50 / 50"]:::rItem
        R1["Same-site HA"]:::rItem
        R2["-LoadBalancePercent 50"]:::rItem
        R3["MCLT default 1 hour"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
