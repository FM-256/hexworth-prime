---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI Lab"]
        direction TB
        L0["Build scopes"]:::lItem
        L1["Add reservations"]:::lItem
        L2["Configure failover"]:::lItem
        L3["Set scope options"]:::lItem
    end
    subgraph R ["PowerShell Lab"]
        direction TB
        R0["Cmdlet-based scope mgmt"]:::rItem
        R1["Lease queries"]:::rItem
        R2["Option configuration"]:::rItem
        R3["Audit log review"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
