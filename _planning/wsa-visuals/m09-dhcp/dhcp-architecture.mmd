---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Client["DHCP Client<br/>(needs IP)"]:::n_Client
    Relay["DHCP Relay Agent<br/>(across subnets)"]:::n_Relay
    Server["DHCP Server<br/>(scope + leases)"]:::n_Server
    AD["AD Authorization<br/>(prevent rogue)"]:::n_AD
    Client -->|"broadcast<br/>UDP 67 / 68"| Server
    Client -..->|"across subnet"| Relay
    Relay -->|"unicast forward"| Server
    AD -..->|"authorize"| Server
    classDef n_Client fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Relay fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Server fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_AD fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
