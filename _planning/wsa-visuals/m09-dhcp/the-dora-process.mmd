---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    D["DISCOVER<br/>Client broadcast:<br/>any DHCP out there?"]:::n_D
    O["OFFER<br/>Server replies<br/>with available IP"]:::n_O
    R["REQUEST<br/>Client accepts<br/>specific offer"]:::n_R
    A["ACKNOWLEDGE<br/>Server confirms<br/>+ sends full config"]:::n_A
    D -->|"① broadcast"| O
    O -->|"② unicast offer"| R
    R -->|"③ formal request"| A
    classDef n_D fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_O fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_R fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_A fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
