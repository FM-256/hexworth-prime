---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Common Issues"]
        direction TB
        L0["APIPA (169.254.x.x)<br/>no DHCP response"]:::lItem
        L1["Scope exhaustion"]:::lItem
        L2["Rogue DHCP server"]:::lItem
        L3["Wrong options"]:::lItem
        L4["Lease conflicts"]:::lItem
    end
    subgraph R ["Diagnostic Tools"]
        direction TB
        R0["ipconfig /all"]:::rItem
        R1["ipconfig /release + /renew"]:::rItem
        R2["Event Viewer DHCP logs"]:::rItem
        R3["DHCP audit logs"]:::rItem
        R4["Wireshark DORA capture"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
