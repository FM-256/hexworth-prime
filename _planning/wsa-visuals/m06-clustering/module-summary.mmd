    subgraph R ["PowerShell Lab"]
        direction TB
        R0["Test-Cluster validation"]:::rItem
        R1["New-Cluster -Node automation"]:::rItem
        R2["Set-ClusterQuorum -CloudWitness"]:::rItem
        R3["Invoke-CauRun rolling patches"]:::rItem
        R4["Scripted multi-cluster fleet ops"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
