---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Traditional Disk"]
        direction TB
        L0["Access: one node at a time"]:::lItem
        L1["Failover: disk must "move""]:::lItem
        L2["Path: own drive letter each"]:::lItem
        L3["Live migration: slow"]:::lItem
        L4["Lock contention on failover"]:::lItem
    end
    subgraph R ["Cluster Shared Volume"]
        direction TB
        R0["Access: all nodes simultaneous"]:::rItem
        R1["Failover: no disk movement"]:::rItem
        R2["Path: C:\ClusterStorage\…"]:::rItem
        R3["Live migration: fast"]:::rItem
        R4["Default for Hyper-V VMs"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#10b981,color:#fff,stroke:#fff,stroke-width:2px
