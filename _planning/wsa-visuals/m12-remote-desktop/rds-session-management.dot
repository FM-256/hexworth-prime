digraph session_states {
    rankdir=LR;
    bgcolor="#0c1a2e";
    fontname="Inter";
    pad=0.4;
    nodesep=0.6;
    ranksep=0.8;
    size="12.8,7.2!";
    ratio=fill;
    labelloc=t;
    label=<<FONT POINT-SIZE="26" COLOR="white"><B>RDS Session Management</B></FONT>>;
    fontcolor=white;
    node [fontname="Inter", fontsize=13, fontcolor="#ffffff", color="#ffffff", penwidth=2];

    subgraph cluster_states {
        label=<<FONT POINT-SIZE="14" COLOR="#9ca3af">Session States</FONT>>;
        style="rounded,dashed"; color="#9ca3af"; fontcolor="#9ca3af";
        listen [shape=circle, style=filled, label="LISTEN", fillcolor="#9ca3af", fontcolor="#0c1a2e", width=1.4, fixedsize=true];
        active [shape=circle, style=filled, label="ACTIVE", fillcolor="#16a34a", width=1.4, fixedsize=true];
        idle   [shape=circle, style=filled, label="IDLE",   fillcolor="#d97706", fontcolor="#0c1a2e", width=1.4, fixedsize=true];
        disc   [shape=circle, style=filled, label="DISCONN", fillcolor="#facc15", fontcolor="#0c1a2e", width=1.4, fixedsize=true];
        edge [fontname="Inter", fontsize=10, fontcolor="#ffd86b", color="#7aa2ff", penwidth=1.5];
        listen -> active [label="user connects"];
        active -> idle [label="idle timeout"];
        idle -> active [label="user input"];
        active -> disc [label="net lost"];
        disc -> active [label="reconnect"];
        disc -> listen [label="disc timeout"];
    }

    subgraph cluster_actions {
        label=<<FONT POINT-SIZE="14" COLOR="#9ca3af">Admin Actions</FONT>>;
        style="rounded,dashed"; color="#9ca3af"; fontcolor="#9ca3af";
        shadow_a   [shape=box, style="rounded,filled", label="Shadow",     fillcolor="#7c3aed", width=1.4, height=0.5, fixedsize=true];
        discon_a   [shape=box, style="rounded,filled", label="Disconnect", fillcolor="#7c3aed", width=1.4, height=0.5, fixedsize=true];
        logoff_a   [shape=box, style="rounded,filled", label="Log Off",    fillcolor="#dc2626", width=1.4, height=0.5, fixedsize=true];
        message_a  [shape=box, style="rounded,filled", label="Message",    fillcolor="#0891b2", width=1.4, height=0.5, fixedsize=true];
    }
}