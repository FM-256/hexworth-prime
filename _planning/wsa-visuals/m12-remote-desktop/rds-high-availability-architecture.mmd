---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    LB["NLB / DNS RR<br/>(public)"]:::n_LB
    GW1["RD Gateway 1"]:::n_GW1
    GW2["RD Gateway 2"]:::n_GW2
    CB1["Connection Broker 1<br/>active"]:::n_CB1
    CB2["Connection Broker 2<br/>active"]:::n_CB2
    SQL["Shared SQL<br/>(CB state)"]:::n_SQL
    RDSHpool["RDSH Pool<br/>(2+ hosts)"]:::n_RDSHpool
    LB -->|"session A"| GW1
    LB -->|"session B"| GW2
    GW1 -->|"orchestrate"| CB1
    GW2 -->|"orchestrate"| CB2
    CB1 -->|"state"| SQL
    CB2 -->|"state"| SQL
    CB1 -->|"dispatch"| RDSHpool
    CB2 -->|"dispatch"| RDSHpool
    classDef n_LB fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_GW1 fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_GW2 fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_CB1 fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_CB2 fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_SQL fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_RDSHpool fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
