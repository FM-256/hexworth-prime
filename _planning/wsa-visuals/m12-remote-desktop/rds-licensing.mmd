---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Per User CAL"]
        direction TB
        L0["Follows user across devices"]:::lItem
        L1["AD tracking required"]:::lItem
        L2["Best for road warriors / BYOD"]:::lItem
    end
    subgraph R ["Per Device CAL"]
        direction TB
        R0["Assigned to device"]:::rItem
        R1["Works for shared / shift use"]:::rItem
        R2["Best for kiosks, manufacturing floors"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
