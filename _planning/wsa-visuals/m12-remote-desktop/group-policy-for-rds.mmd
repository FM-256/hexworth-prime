---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Computer GPO"]
        direction TB
        L0["Licensing config"]:::lItem
        L1["NLA enforcement"]:::lItem
        L2["Encryption settings"]:::lItem
    end
    subgraph R ["User GPO"]
        direction TB
        R0["Session limits"]:::rItem
        R1["Redirection rules"]:::rItem
        R2["Start menu, desktop, drives"]:::rItem
        R3["RemoteApp + logon scripts"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
