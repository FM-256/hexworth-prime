---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Session-Based"]
        direction TB
        L0["One shared OS<br/>Multiple user sessions"]:::lItem
        L1["Low cost per user"]:::lItem
        L2["Standardized workloads<br/>(office, LoB apps)"]:::lItem
    end
    subgraph R ["VDI (Virtual Desktop Infrastructure)"]
        direction TB
        R0["One dedicated VM per user"]:::rItem
        R1["Higher cost, full isolation"]:::rItem
        R2["Best for devs / power users /<br/>admin-rights workloads"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
