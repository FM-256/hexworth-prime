---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Security Layer"]
        direction TB
        L0["Negotiate (default)"]:::lItem
        L1["SSL / TLS (recommended)"]:::lItem
        L2["RDP (legacy — avoid)"]:::lItem
    end
    subgraph R ["NLA — Network Level Auth"]
        direction TB
        R0["Authenticates BEFORE session"]:::rItem
        R1["CredSSP — always enable"]:::rItem
        R2["Blocks pre-auth attacks"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
