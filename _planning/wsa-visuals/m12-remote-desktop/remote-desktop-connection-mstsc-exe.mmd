---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Basics"]
        direction TB
        L0["/v:server (connect to)"]:::lItem
        L1["/f (full-screen)"]:::lItem
        L2["/w: /h: (resolution)"]:::lItem
        L3["/multimon"]:::lItem
    end
    subgraph R ["Advanced"]
        direction TB
        R0["/restrictedAdmin"]:::rItem
        R1["/remoteGuard"]:::rItem
        R2["/shadow:ID (shadow session)"]:::rItem
        R3[".rdp files"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
