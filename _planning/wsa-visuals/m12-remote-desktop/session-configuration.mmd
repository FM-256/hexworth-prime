---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Timeouts"]
        direction TB
        L0["Idle limit"]:::lItem
        L1["Active limit"]:::lItem
        L2["Disconnected limit"]:::lItem
        L3["Broken-connection action"]:::lItem
    end
    subgraph R ["Redirection"]
        direction TB
        R0["Printers"]:::rItem
        R1["Clipboard"]:::rItem
        R2["Local drives"]:::rItem
        R3["Smart cards, USB, audio"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
