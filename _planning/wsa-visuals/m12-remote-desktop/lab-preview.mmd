---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["GUI Lab"]
        direction TB
        L0["Build Session Collection"]:::lItem
        L1["Publish RemoteApp"]:::lItem
        L2["Configure Gateway policies"]:::lItem
        L3["Enable UPDs"]:::lItem
    end
    subgraph R ["PowerShell Lab"]
        direction TB
        R0["Deploy RDS roles via DSC"]:::rItem
        R1["Manage collections"]:::rItem
        R2["Configure Licensing"]:::rItem
        R3["Monitor active sessions"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
