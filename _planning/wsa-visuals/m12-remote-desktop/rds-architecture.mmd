---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Client["Client<br/>laptop / browser"]:::n_Client
    Gateway["RD Gateway<br/>TLS terminator"]:::n_Gateway
    WebAccess["RD Web Access<br/>browser portal"]:::n_WebAccess
    Broker["Connection Broker<br/>orchestrates sessions"]:::n_Broker
    RDSH["RD Session Host (RDSH)<br/>shared desktop sessions"]:::n_RDSH
    VDI["RD Virtualization Host<br/>VDI on Hyper-V"]:::n_VDI
    LicSrv["License Server<br/>CAL store"]:::n_LicSrv
    Client -->|"① RDP-over-HTTPS, port 443"| Gateway
    Client -..->|"② browser, RemoteApp feed"| WebAccess
    Gateway -->|"③ RDP 3389"| Broker
    WebAccess -..->|"launch"| Broker
    Broker -->|"④ dispatch session"| RDSH
    Broker -..->|"④ dispatch VM"| VDI
    RDSH -->|"⑤ CAL query"| LicSrv
    VDI -..->|"⑤ CAL query"| LicSrv
    classDef n_Client fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Gateway fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_WebAccess fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Broker fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_RDSH fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_VDI fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_LicSrv fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
