---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["CAP — Connection Auth Policy"]
        direction TB
        L0["WHO can connect"]:::lItem
        L1["User group membership"]:::lItem
        L2["Authentication method<br/>(password, smart card)"]:::lItem
    end
    subgraph R ["RAP — Resource Auth Policy"]
        direction TB
        R0["WHAT they can reach"]:::rItem
        R1["Target server groups"]:::rItem
        R2["Allowed ports"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
