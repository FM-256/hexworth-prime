---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Quick Start"]
        direction TB
        L0["All roles on one server"]:::lItem
        L1["Labs / small environments only"]:::lItem
        L2["Fast — single click"]:::lItem
    end
    subgraph R ["Standard"]
        direction TB
        R0["Roles split across servers"]:::rItem
        R1["Production + HA topology"]:::rItem
        R2["AD required"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
