---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart TB
    WinRE["WinRE<br/>cmd prompt"]:::n_WinRE
    FixMBR["① bootrec /fixmbr<br/>repair MBR"]:::n_FixMBR
    FixBoot["② bootrec /fixboot<br/>new boot sector"]:::n_FixBoot
    RebuildBCD["③ bootrec /rebuildbcd<br/>rebuild BCD store"]:::n_RebuildBCD
    DISM["④ DISM /Online<br/>/RestoreHealth<br/>repair component store"]:::n_DISM
    SFC["⑤ sfc /scannow<br/>scan + repair<br/>protected files"]:::n_SFC
    BSOD["BSOD analysis<br/>C:\Windows\Minidump<br/>WinDbg / BlueScreenView"]:::n_BSOD
    WinRE --> FixMBR
    FixMBR --> FixBoot
    FixBoot --> RebuildBCD
    RebuildBCD -->|"then OS up"| DISM
    DISM -->|"always DISM first"| SFC
    WinRE -..->|"parallel analysis"| BSOD
    classDef n_WinRE fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_FixMBR fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_FixBoot fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_RebuildBCD fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_DISM fill:#d97706,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_SFC fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_BSOD fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
