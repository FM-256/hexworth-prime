---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Identify["① Identify<br/>Define the problem"]:::n_Identify
    Research["② Research<br/>Gather info"]:::n_Research
    Hypothesize["③ Hypothesize<br/>Theory of cause"]:::n_Hypothesize
    Test["④ Test<br/>Verify theory"]:::n_Test
    Resolve["⑤ Resolve<br/>Implement fix"]:::n_Resolve
    Loop["Theory wrong?<br/>→ new hypothesis"]:::n_Loop
    Identify --> Research
    Research --> Hypothesize
    Hypothesize --> Test
    Test -->|"pass"| Resolve
    Test -..->|"fail"| Loop
    Loop -..->|"retry"| Hypothesize
    classDef n_Identify fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Research fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Hypothesize fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Test fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Resolve fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Loop fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
