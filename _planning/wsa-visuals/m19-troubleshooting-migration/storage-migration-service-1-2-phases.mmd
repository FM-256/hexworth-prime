---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    Source["Source File Server<br/>FS-OLD"]:::n_Source
    Inventory["① Inventory<br/>scan shares, data, ACLs"]:::n_Inventory
    Transfer["② Transfer<br/>copy data + perms"]:::n_Transfer
    Cutover["③ Cutover<br/>swap name + IP"]:::n_Cutover
    Validate["④ Validate<br/>verify shares + clients"]:::n_Validate
    Dest["Destination<br/>FS-NEW<br/>(now answers FS-OLD)"]:::n_Dest
    Source --> Inventory
    Inventory --> Transfer
    Transfer --> Cutover
    Cutover --> Validate
    Validate -->|"identity moved"| Dest
    classDef n_Source fill:#dc2626,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Inventory fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Transfer fill:#0891b2,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Cutover fill:#facc15,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Validate fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
    classDef n_Dest fill:#7c3aed,color:#fff,stroke:#fff,stroke-width:2px
