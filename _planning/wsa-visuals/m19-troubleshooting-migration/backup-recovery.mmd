---
config:
  theme: dark
  themeVariables:
    background: '#0c1a2e'
    primaryTextColor: '#ffffff'
    lineColor: '#7aa2ff'
    fontFamily: Inter
---
flowchart LR
    subgraph L ["Backup Types"]
        direction TB
        L0["Full Server + System State<br/>(AD, registry, boot)"]:::lItem
        L1["Bare Metal Recovery<br/>(restore to new HW)"]:::lItem
        L2["Volume / File<br/>(specific data)"]:::lItem
    end
    subgraph R ["AD Recovery Modes"]
        direction TB
        R0["Non-authoritative<br/>restore, replicate FROM<br/>other DCs"]:::rItem
        R1["Authoritative<br/>restore, replicate TO<br/>other DCs"]:::rItem
        R2["Use authoritative to<br/>UNDO mass deletion"]:::rItem
    end
    classDef lItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    classDef rItem fill:#0c1a2e,color:#fff,stroke:#9ca3af
    style L fill:#1f6feb,color:#fff,stroke:#fff,stroke-width:2px
    style R fill:#16a34a,color:#fff,stroke:#fff,stroke-width:2px
