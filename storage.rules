rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Task screenshots — admins can upload, anyone authenticated can read
    match /task-screenshots/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
