rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: is this user an admin? ─────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Users collection — authenticated users can read/write their own doc
    // Cloud Functions (setAdminClaim, addXP, recordProgress) use admin SDK (bypasses rules)
    match /users/{userId} {
      allow read: if request.auth != null;

      // Users can create their own doc (first sign-in)
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can update only safe fields
      // XP + level are client-writable because XPCalculator derives them deterministically
      // from completion state — the client can't inflate XP beyond what completions justify
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['callsign', 'callsignLower', 'displayName', 'photoURL',
                     'house', 'theme', 'favorites', 'settings', 'updatedAt',
                     'deviceId', 'accountType', 'firstName', 'lastName',
                     'studentId', 'isAnonymous', 'lastActivity',
                     'xp', 'level',
                     'modulesCompleted', 'labsCompleted', 'quizzes',
                     'achievements', 'streak',
                     'ctfBoxesPwned', 'ctfFlagsCaptured']);

      // Gate completions subcollection — written by Cloud Functions (completeGate)
      // Students can read their own, admins can read any
      match /gates/{gateId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        // Only Cloud Functions (admin SDK) can write — no client writes allowed
      }

      // Flag capture records — written by Cloud Functions (validateFlag)
      match /flag_captures/{captureId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Flag attempt rate-limiting — written by Cloud Functions (validateFlag)
      match /flag_attempts/{attemptId} {
        allow read: if isAdmin();
      }

      // Gate attempt rate-limiting — written by Cloud Functions (validateGateAnswer)
      match /gate_attempts/{attemptId} {
        allow read: if isAdmin();
      }

      // Activation code attempt rate-limiting — written by Cloud Functions (validateActivationCode)
      match /activation_attempts/{attemptId} {
        allow read: if isAdmin();
      }

      // Bulk localStorage sync — users can read/write their own sync blob
      match /sync/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Score submission rate-limiting — written by Cloud Functions (submitGameScore)
      match /score_submissions/{submissionId} {
        allow read: if isAdmin();
      }
    }

    // Flag registry — server-side only (admin SDK writes, no client access)
    match /flag_registry/{boxId} {
      allow read: if false;
      allow write: if false;
    }

    // Gate answer registry — server-side only (admin SDK writes, no client access)
    match /gate_registry/{setId} {
      allow read: if false;
      allow write: if false;
    }

    // Game scoreboards — any authenticated user can read, Cloud Functions write
    match /game_scores/{gameId} {
      allow read: if request.auth != null;
    }

    // Leaderboards — any authenticated user can read
    match /leaderboards/{docId} {
      allow read: if request.auth != null;
    }

    // HED reports — authenticated users can create, admin can read/delete
    match /hed_reports/{reportId} {
      allow create: if request.auth != null;
      allow read, delete: if isAdmin();
    }

    // OASIS Rings — anyone authenticated can read, any auth user can update (score submission)
    match /rings/{ringId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;

      // Attempts subcollection — auth users can create own, anyone can read
      match /attempts/{attemptId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }

    // Arena Co-Op sessions — authenticated users can create, join, and sync state
    match /arena_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.hostUid == request.auth.uid || resource.data.createdBy == request.auth.uid);

      // Activity log subcollection
      match /activity/{activityId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }

    // Classes collection — handlers create/manage, students join/leave
    match /classes/{classId} {
      // Any authenticated user can read (needed for code lookup)
      allow read: if request.auth != null;

      // Any authenticated user can create a class
      allow create: if request.auth != null;

      // Handler can update anything; students can ONLY add/remove own UID
      allow update: if request.auth != null && (
        // Handler full access
        resource.data.handlerUid == request.auth.uid
        ||
        // Student joining: adds own UID to memberUids, increments memberCount
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids
          && !(request.auth.uid in resource.data.memberUids)
          && resource.data.memberUids.size() < resource.data.maxMembers
        )
        ||
        // Student leaving: removes own UID from memberUids, decrements memberCount
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt'])
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.auth.uid in resource.data.memberUids
        )
      );

      // Only the handler who owns the class can delete
      allow delete: if request.auth != null
        && resource.data.handlerUid == request.auth.uid;

      // Assignments subcollection — handler manages, authenticated users can read
      match /assignments/{assignmentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
      }

      // Members subcollection — students write own profile, anyone authenticated can read
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == memberId;
        allow delete: if request.auth != null && (
          request.auth.uid == memberId
          || get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid
        );
      }

      // Progress subcollection — students write own progress, anyone authenticated can read
      match /progress/{studentUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == studentUid;
        allow delete: if request.auth != null && (
          request.auth.uid == studentUid
          || get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid
        );
      }

      // Activity subcollection — students log own events, anyone authenticated can read
      match /activity/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
      }
    }
  }
}
