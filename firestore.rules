rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: is this user an admin? ─────────────────────────
    // Checks both custom claims (admin: true) and email allowlist.
    // The email check mirrors requireAdmin() in Cloud Functions
    // (functions/index.js line 1819) so both paths grant the same access.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'f.mora80@gmail.com' ||
        request.auth.token.email == 'jorden@hexworth.com'
      );
    }

    // Users collection — authenticated users can read/write their own doc
    // Cloud Functions (setAdminClaim, addXP, recordProgress) use admin SDK (bypasses rules)
    match /users/{userId} {
      allow read: if request.auth != null;

      // Users can create their own doc (first sign-in)
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can update only safe fields
      // XP + level are in the whitelist for backward compat but syncProgress CF
      // derives them server-side — client values are ignored during sync
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['callsign', 'callsignLower', 'displayName', 'photoURL',
                     'house', 'theme', 'favorites', 'settings', 'updatedAt',
                     'deviceId', 'accountType', 'firstName', 'lastName',
                     'studentId', 'isAnonymous', 'lastActivity',
                     'xp', 'level',
                     'modulesCompleted', 'labsCompleted', 'quizzes',
                     'achievements', 'streak',
                     'ctfBoxesPwned', 'ctfFlagsCaptured',
                     'gamesPlayed']);

      // Gate completions subcollection — written by Cloud Functions (completeGate)
      // Students can read their own, admins can read any
      match /gates/{gateId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        // Only Cloud Functions (admin SDK) can write — no client writes allowed
      }

      // Flag capture records — written by Cloud Functions (validateFlag)
      match /flag_captures/{captureId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Flag attempt rate-limiting — written by Cloud Functions (validateFlag)
      match /flag_attempts/{attemptId} {
        allow read: if isAdmin();
      }

      // Gate attempt rate-limiting — written by Cloud Functions (validateGateAnswer)
      match /gate_attempts/{attemptId} {
        allow read: if isAdmin();
      }

      // EDT Case Room reset counter — written by Cloud Functions (resetEDTSubmission)
      match /edt_resets/{labId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Activation code attempt rate-limiting — written by Cloud Functions (validateActivationCode)
      match /activation_attempts/{attemptId} {
        allow read: if isAdmin();
      }

      // Bulk localStorage sync — users can read/write their own sync blob
      match /sync/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Score submission rate-limiting — written by Cloud Functions (submitGameScore)
      match /score_submissions/{submissionId} {
        allow read: if isAdmin();
      }

      // TripWire events subcollection — written by client (IntegrityLockscreen), admin reads for dashboard
      match /tripwire_events/{eventId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if isAdmin();
      }
    }

    // Flag registry — admin can read (for tournament challenge setup), no client access
    // Cloud Functions use admin SDK for validation (bypasses rules)
    match /flag_registry/{boxId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Hexworth Observatory (research-consent house) ──
    // Consent records — the operator's copy of each participant's signed consent.
    // A student creates/updates their own doc (doc id == their uid); owner or admin reads.
    match /observatory_consent/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Enrollment roster — the clean per-student record (uid, class, name, email)
    // the admin dashboard queries, separate from the consent prose. A student
    // writes their own (doc id == their uid); owner or admin reads; admin deletes
    // (e.g. on withdrawal).
    match /observatory_enrollment/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Class roster — admin-managed list students enroll into. Any signed-in user
    // reads it (to populate the enrollment dropdown); only an admin writes.
    match /observatory_classes/{classId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Activity events — the consented cohort's tracked activity (the operator's
    // research/analytics data). A user may create events stamped with their own
    // uid; only an admin reads (the tracking dashboard). Append-only.
    match /observatory_activity/{eventId} {
      // Writes go ONLY through the logObservatoryEvent Cloud Function (admin SDK,
      // bypasses rules). Direct client writes are denied — this is what prevents
      // uid spoofing, classId forgery, and event stuffing. Admin reads (dashboard).
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    // Gate answer registry — server-side only (admin SDK writes, no client access)
    match /gate_registry/{setId} {
      allow read: if false;
      allow write: if false;
    }

    // Challenge leaderboards — scores and per-level stats for interactive labs
    match /challenge_leaderboard/{challengeId} {
      allow read: if request.auth != null;

      // Scores subcollection — Cloud Functions write (submitChallengeScore), authenticated read
      match /scores/{scoreId} {
        allow read: if request.auth != null;
        // Only Cloud Functions (admin SDK) can write
      }

      // Stats subcollection — Cloud Functions write (submitChallengeScore), authenticated read
      match /stats/{statId} {
        allow read: if request.auth != null;
        // Only Cloud Functions (admin SDK) can write
      }
    }

    // Game scoreboards — any authenticated user can read, Cloud Functions write
    match /game_scores/{gameId} {
      allow read: if request.auth != null;
    }

    // Leaderboards — any authenticated user can read
    match /leaderboards/{docId} {
      allow read: if request.auth != null;
    }

    // HED reports — authenticated users can create, admin can read/delete
    match /hed_reports/{reportId} {
      allow create: if request.auth != null;
      allow read, delete: if isAdmin();
    }

    // OASIS Rings — anyone authenticated can read, any auth user can update (score submission)
    match /rings/{ringId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;

      // Attempts subcollection — auth users can create own, anyone can read
      match /attempts/{attemptId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }

    // Arena box ratings — hat rating system
    match /arena_ratings/{boxId} {
      // Anyone authenticated can read aggregates
      allow read: if request.auth != null;
      // Only transactions can update aggregates (validated shape)
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['totalScore', 'count', 'avg', 'updated'])
        && request.resource.data.totalScore is int
        && request.resource.data.count is int
        && request.resource.data.avg is number;

      // Individual ratings — users can only write their own
      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['rating', 'review', 'timestamp', 'displayName'])
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.review is string
          && request.resource.data.review.size() <= 120;
      }
    }

    // Arena Co-Op sessions — authenticated users can create, join, and sync state
    match /arena_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.hostUid == request.auth.uid || resource.data.createdBy == request.auth.uid);

      // Activity log subcollection
      match /activity/{activityId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }

    // Handler messages — F-27 handler-to-student comms
    match /handler_messages/{msgId} {
      // Any authenticated user can read (queries filter by recipientUid or classId)
      allow read: if request.auth != null;
      // Students can update only the readBy field (mark as read)
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      // Handlers can delete their own messages
      allow delete: if request.auth != null && resource.data.senderUid == request.auth.uid;
      // Only Cloud Functions (admin SDK) can create
    }

    // ─── F-23: Messaging System ──────────────────────────────────────

    // Helper: check if current user is a handler for the given class
    function isHandlerForClass(classId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
    }

    // Messages — read by participants or class handler; write only via Cloud Functions
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        resource.data.from == request.auth.uid ||
        resource.data.to == request.auth.uid ||
        isHandlerForClass(resource.data.classId)
      );

      // Direct writes blocked — all creates go through sendMessage CF
      allow create: if false;

      // Only recipient can mark as read
      allow update: if request.auth != null &&
        resource.data.to == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read == true;

      // Soft-delete only by handler
      allow update: if request.auth != null &&
        isHandlerForClass(resource.data.classId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted']) &&
        request.resource.data.deleted == true;

      allow delete: if false; // Hard deletes only via purge CF
    }

    // Conversations — read by participants or class handler
    match /conversations/{conversationId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        isHandlerForClass(resource.data.classId)
      );

      // Writes only via Cloud Functions
      allow write: if false;
    }

    // Messaging blocks — handler managed
    match /messaging_blocks/{blockId} {
      allow read: if request.auth != null && (
        resource.data.blockedUid == request.auth.uid ||
        isHandlerForClass(resource.data.classId)
      );

      // Write only via Cloud Functions
      allow write: if false;
    }

    // Spectator streams — read by anyone authenticated, write only via CFs
    match /spectator_streams/{streamId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // EDT lab submissions — students write their own, handlers read for grading
    match /edt_submissions/{submissionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        submissionId.matches('.*_' + request.auth.uid + '$');
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Classes collection — handlers create/manage, students join/leave
    match /classes/{classId} {
      // Any authenticated user can read (needed for code lookup)
      allow read: if request.auth != null;

      // Any authenticated user can create a class
      allow create: if request.auth != null;

      // Handler can update anything; students can ONLY add/remove own UID
      allow update: if request.auth != null && (
        // Handler full access
        resource.data.handlerUid == request.auth.uid
        ||
        // Student joining: adds own UID to memberUids, increments memberCount
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids
          && !(request.auth.uid in resource.data.memberUids)
          && resource.data.memberUids.size() < resource.data.maxMembers
        )
        ||
        // Student leaving: removes own UID from memberUids, decrements memberCount
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt'])
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.auth.uid in resource.data.memberUids
        )
      );

      // Only the handler who owns the class can delete
      allow delete: if request.auth != null
        && resource.data.handlerUid == request.auth.uid;

      // Assignments subcollection — handler manages, authenticated users can read
      match /assignments/{assignmentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
      }

      // Members subcollection — students write own profile, anyone authenticated can read
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == memberId;
        allow delete: if request.auth != null && (
          request.auth.uid == memberId
          || get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid
        );
      }

      // Progress subcollection — students write own progress, anyone authenticated can read
      match /progress/{studentUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == studentUid;
        allow delete: if request.auth != null && (
          request.auth.uid == studentUid
          || get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid
        );
      }

      // Activity subcollection — students log own events, anyone authenticated can read
      match /activity/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
      }
    }

    // TripWire events — authenticated users can create (report their own incidents)
    // Admin can read all. Rate limited to 10 per user per hour via Cloud Function.
    match /tripwire_events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid_hash', 'method', 'category', 'detail', 'timestamp', 'nonce', 'sessionId'])
        && request.resource.data.method is string
        && request.resource.data.category is string
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 200;
      allow read: if isAdmin();
    }

    // TripWire global stats — anyone authenticated can read, only Cloud Functions can write
    match /tripwire_stats/{docId} {
      allow read: if request.auth != null;
      // Only Cloud Functions (admin SDK) can write — increment counters
    }

    // Handler activation codes — admin console reads for Code History panel.
    // All writes go through Cloud Functions (adminGenerateHandlerCode, adminRevokeHandlerCode).
    match /handler_codes/{codeId} {
      allow read: if isAdmin();
      // Only Cloud Functions (admin SDK) can write
    }

    // ─── PFI Auto-Grading ──────────────────────────────────────────────
    // Test specs: server-only (admin SDK reads in CF, no client access)
    match /pfi_test_specs/{specId} {
      allow read: if false;
      allow write: if false;
    }

    // Submissions: written by CF, readable by authenticated users (student sees own, handler sees class)
    match /pfi_submissions/{submissionId} {
      allow read: if request.auth != null;
      // Only Cloud Functions (admin SDK) can write
    }

    // ─── Quality Reports ─────────────────────────────────────────────
    // Published by Nexus CLI (admin SDK writes via --publish flag).
    // Admin console reads to populate the Quality panel.
    match /_quality_reports/{reportId} {
      allow read: if isAdmin();
      // Only CLI (admin SDK) can write — no client writes allowed
    }

    // ─── Self-Healing Pipeline Queues ────────────────────────────────
    // Slice 1 of the bidirectional control plane. See:
    //   _docs/features/SELF_HEALING_PIPELINE.md
    //
    // _triage_queue: human-reviewed high/critical defects (aggregated)
    // _auto_fix_queue: agent-pull queue (Slice 1 ships empty allowlist;
    //                  Slice 3 enables agent-pull when fix templates exist)
    //
    // Both queues: admin-only read/write. Schema enforced via hasOnly
    // (extra-field injection blocked). Immutable fields preserved across
    // updates (defectFingerprint, source, severity, rule, createdAt).
    // Owner field validated via agent/human regex when set.

    function isValidActor(id) {
      return id is string && id.matches('^(agent|human):[a-z0-9_-]+$');
    }

    function isValidTriageData() {
      return request.resource.data.keys().hasAll([
            'defectFingerprint', 'source', 'severity', 'status',
            'priority', 'autoFixEligible', 'createdAt', 'updatedAt'
          ])
        && request.resource.data.keys().hasOnly([
            'defectFingerprint', 'source', 'severity', 'rule', 'ruleVersion',
            'title', 'description', 'filePath', 'lineNumber',
            'groupKey', 'childCount', 'childPaths',
            'status', 'priority', 'owner', 'claimedAt', 'heartbeatAt',
            'autoFixEligible', 'fixTemplate',
            'createdAt', 'updatedAt', 'resolvedAt', 'resolvedBy', 'resolveCommitSha',
            'history'
          ])
        && request.resource.data.defectFingerprint is string
        && request.resource.data.defectFingerprint.size() == 64
        && request.resource.data.source in ['nexus', 'sprint-master', 'manual']
        && request.resource.data.severity in ['critical', 'high', 'medium', 'low']
        && request.resource.data.status in ['open', 'claimed', 'in-progress', 'resolved', 'deferred', 'dismissed']
        && request.resource.data.autoFixEligible is bool
        && request.resource.data.priority is number
        && request.resource.data.priority >= 0
        && request.resource.data.priority <= 100
        && (!('owner' in request.resource.data)
            || request.resource.data.owner == null
            || isValidActor(request.resource.data.owner));
    }

    function preservesImmutableFields() {
      return request.resource.data.defectFingerprint == resource.data.defectFingerprint
        && request.resource.data.source == resource.data.source
        && request.resource.data.severity == resource.data.severity
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('rule', null) == resource.data.get('rule', null);
    }

    // ─── Launchpad Live Feed (LIVE-3, added 2026-06-03) ──────────────
    // featured_opportunities: aggregated jobs + internships from
    // USAJobs, Hacker News, and We Work Remotely. Written by the
    // scheduled fetchOpportunities Cloud Function via admin SDK
    // (no client writes possible). Public read so the Internship
    // Finder + Job Board pages can render the live feed without
    // requiring auth.
    match /featured_opportunities/{oppId} {
      allow read: if true;
      // Writes are server-only (admin SDK, no security-rules path)
    }

    // featured_opportunities_runs: telemetry from fetchOpportunities
    // (per-run counts, durations, errors). Admin-only read; server write.
    match /featured_opportunities_runs/{runId} {
      allow read: if isAdmin();
      // Writes are server-only
    }

    // featured_picks: operator-curated editorial spotlight pick
    // (Program of the Week / Featured Employer of the Week).
    // featured_picks/current is the active pick. Public read so
    // Internship Finder + Job Board can render the Spotlight without
    // auth. Write restricted to admins (operator + handler emails)
    // for weekly updates from the handler-dashboard admin path (LIVE-5).
    match /featured_picks/{pickId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /_triage_queue/{itemId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidTriageData();
      allow update: if isAdmin() && isValidTriageData() && preservesImmutableFields();
      allow delete: if isAdmin();
    }

    match /_auto_fix_queue/{itemId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidTriageData();
      allow update: if isAdmin() && isValidTriageData() && preservesImmutableFields();
      allow delete: if isAdmin();
    }

    // Item history archive — written on resolve to keep main item lean
    match /_triage_history/{itemId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Saturation alarm history — written by checkSaturationAlarm CF
    // (admin SDK, bypasses rules); admin reads for trend analysis.
    // Explicit deny on client writes (Nancy round 7) so the absence of
    // an allow rule is intentional rather than accidental.
    match /_saturation_history/{docId} {
      allow read: if isAdmin();
      allow write: if false;  // CF only via admin SDK
    }

    // ─── Self-Healing System Master Toggle ─────────────────────────────
    // _system_config/self_healing — single doc holding the master kill
    // switch + per-template enable map. Defaults to disabled.
    // Pulse admin UI writes; CLI agent commands and Cloud Functions read
    // before acting. No autonomous code mutation can happen unless this
    // doc says enabled: true.
    function isValidSystemConfig() {
      return request.resource.data.keys().hasOnly([
            'enabled', 'enabledBy', 'enabledAt',
            'lastDisabledBy', 'lastDisabledAt',
            'enabledTemplates',
            'availableTemplates', 'availableTemplatesUpdatedAt',
            'updatedAt'
          ])
        && request.resource.data.enabled is bool;
    }
    match /_system_config/{configId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidSystemConfig();
      allow delete: if false;
    }

    // ─── Admin Task Board ─────────────────────────────────────────────
    // Shared operational task board for the admin team.
    // Full read/write gated to admins only — no student access.
    match /_admin_tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    // ─── WL: White Label Tenant System ─────────────────────────────────

    // Tenant config — public read (loader page needs branding), admin write
    // The tenant config contains branding, licensing, and domain info.
    // Anyone can read (the branded loader page fetches this before auth).
    // Only Cloud Functions (admin SDK) can create/update/delete.
    match /tenants/{tenantId} {
      allow read: if true;  // Public — loader page needs this pre-auth
      // Write only via Cloud Functions (tenant-admin.js uses admin SDK)
    }

    // Tenant classes — scoped to tenant admins and enrolled students
    match /tenants/{tenantId}/classes/{classId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids;
      allow update, delete: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids;

      // Assignments within a tenant class
      match /assignments/{assignmentId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids;
      }

      // Student progress within a tenant class
      match /progress/{studentUid} {
        allow read: if request.auth != null && (
          request.auth.uid == studentUid ||
          request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids
        );
        allow write: if request.auth != null && request.auth.uid == studentUid;

        // ─── Analytics v2 — Event Log Subcollections ──────────────
        // Architecture: _docs/architecture/student-analytics-v2.md §4.5
        // Source of truth: Firestore subcollections under progress/{uid}.
        // ALL writes go via Cloud Functions (Admin SDK bypasses these rules).
        // Reads are gated per the governance status in the architecture doc.

        // Sessions — server-issued session tokens record the session lifecycle.
        // Self-readable (student can see their own session); CFs write.
        match /sessions/{sessionId} {
          allow read: if request.auth != null && request.auth.uid == studentUid;
          allow write: if false;
        }

        // Events — raw event log. NEVER readable from any client (CF-only).
        // Instructors see projections (itemState, aggregates), not raw events.
        match /events/{eventId} {
          allow read: if false;
          allow write: if false;
        }

        // IntegrityEvents — capture-only governance.
        // PI-only read access (platform admin). Even class instructor cannot read raw integrity events.
        match /integrityEvents/{eventId} {
          allow read: if isAdmin();
          allow write: if false;
        }

        // ItemState — per-item projection cache. Instructor-facing.
        match /itemState/{itemId} {
          allow read: if request.auth != null && (
            request.auth.uid == studentUid ||
            request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids
          );
          allow write: if false;
        }

        // QuizAttempts — full attempt history. Instructor-facing.
        match /quizAttempts/{attemptKey} {
          allow read: if request.auth != null && (
            request.auth.uid == studentUid ||
            request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids
          );
          allow write: if false;
        }

        // Mastery — concept mastery rollups (Phase 4). Instructor-facing.
        match /mastery/{objectiveId} {
          allow read: if request.auth != null && (
            request.auth.uid == studentUid ||
            request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids
          );
          allow write: if false;
        }
      }

      // ─── Analytics v2 — Aggregates ────────────────────────────────
      // Class-level rollups. Instructor-facing aggregates live at /aggregates/*.
      // Capture-only / PI-only aggregates live at /aggregates/internal/*.
      match /aggregates/{aggDoc} {
        // Instructor-facing aggregates: classStats, itemAnalytics, quizAnalytics, atRisk
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids ||
          isAdmin()
        );
        allow write: if false;
      }
      match /aggregates/internal/{captureOnlyDoc=**} {
        // Capture-only aggregates: PI ONLY
        allow read: if isAdmin();
        allow write: if false;
      }

      // ─── Analytics v2 — AI Ghost actions (Phase 1 Ghost RFC stub) ─
      // Pending actions written by the Ghost CF; rendered on student UI / instructor alerts.
      match /ghostActions/{actionId} {
        // Student reads their own targeted actions
        allow read: if request.auth != null && (
          (resource.data.targetUid == request.auth.uid) ||
          request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids ||
          isAdmin()
        );
        allow write: if false;  // CFs only
      }
    }

    // ─── Analytics v2 — Per-tenant consent records ───────────────────
    match /tenants/{tenantId}/consent/{version} {
      allow read: if request.auth != null;
      allow write: if false;  // CFs only
    }

    // ─── Analytics v2 — Platform Health Doc ────────────────────────
    // Projector heartbeat lives at /analytics_v2/projectorHeartbeat.
    // Instructor UI reads this for staleness detection (arch §7.1).
    match /analytics_v2/{healthDoc} {
      allow read: if request.auth != null;  // any signed-in user (instructor UI uses it)
      allow write: if false;  // CFs only
    }

    // ─── Signal C2 — Hardware Command & Control ──────────────────
    // Devices use HTTP endpoints (Cloud Functions) with deviceKey auth.
    // Dashboard reads are admin-only via Firestore direct access.
    // All writes go through Cloud Functions (admin SDK bypasses rules).

    // C2 device registry — admin read for dashboard, owner read for
    // student-owned devices ("My Devices" page). CF writes only.
    // Legacy open-enrollment devices (registered via /c2Register with
    // no pairing code) have ownerUid==null and stay admin-only.
    match /c2_devices/{deviceId} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow write: if false;  // Cloud Functions only
    }

    // C2 command queue — admin read for dashboard, CF writes
    match /c2_commands/{commandId} {
      allow read: if isAdmin();
      allow write: if false;  // Cloud Functions only
    }

    // C2 activity logs — admin read for dashboard, CF writes
    match /c2_logs/{deviceId}/entries/{entryId} {
      allow read: if isAdmin();
      allow write: if false;  // Cloud Functions only
    }

    // C2 pairing codes — admin read for operator dashboard. Student-owned
    // codes (issuedTo == 'student', ownerUid == caller) are also readable
    // by the owning student so the web flasher can poll for usedAt to
    // detect successful device registration. Admin-issued codes remain
    // admin-only (ownerUid is null or another admin uid).
    match /c2_pairing_codes/{code} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow write: if false;  // Cloud Functions only
    }

    // Student pairing-code rate-limit state. Owner read for UI display
    // ("you have 2 of 3 codes left in the next 24h"). CF writes only.
    match /student_pairing_state/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;  // Cloud Functions only
    }

    // ─── CTF Tournament System ─────────────────────────────────────
    // Tournament metadata — public read (podium page), admin write
    match /tournaments/{tournamentId} {
      allow read: if true;  // Public — podium and lobby pages need this pre-auth
      allow create, update, delete: if isAdmin();

      // Challenges — public read for lobby/board display
      // Flags are stored as SHA-256 hashes (flagHash field) so public read is safe.
      // The raw flag is never stored in Firestore — only the salted hash.
      // Cloud Functions validate submissions by hashing the attempt and comparing.
      match /challenges/{challengeId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Teams — public read (podium shows rankings), Cloud Functions manage joins/scoring
      match /teams/{teamId} {
        allow read: if true;  // Public — live podium needs this
        allow create: if request.auth != null;  // Authenticated users can create teams
        allow update: if request.auth != null && (
          // Team captain can update roster
          resource.data.captain == request.auth.uid ||
          // Admin can update anything
          isAdmin()
        );
        allow delete: if isAdmin();
      }

      // Submissions — admin can read all, team members read own team's
      match /submissions/{submissionId} {
        allow read: if request.auth != null;
        allow write: if false;  // Cloud Functions only (ctfSubmitFlag)
      }
    }

    // ─── Cohorts (REMOVED) ──────────────────────────────────
    // Cohort system consolidated into tenants/classes. See TENANT_COHORT_CONSOLIDATION.md.

    // ─── Enrollment Lookup ─────────────────────────────────
    // Fast lookup doc written at enrollment time by enrollInClass CF.
    // Read by syncClassProgress CF to find student's tenant/class.
    // Students can read their own enrollment. Written only by CF (admin SDK).
    match /enrollments/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Tenant Invites ────────────────────────────────────
    // Pre-registration instructor invites. tokenId is a bearer credential —
    // collection is fully locked at the rules layer; all access goes through
    // adminCreateInvite / adminListInvites / adminRevokeInvite / redeemInvite
    // CFs (admin SDK bypasses rules). See _docs/architecture/tenant-invites.md.
    match /tenant_invites/{tokenId} {
      allow read, write: if false;
    }

    // ─── ePaper Boards ─────────────────────────────────────
    // Per-physical-device config for XIAO-driven e-paper displays
    // (classroom doors, lobby signage, etc.). Admin UI at
    // /admin/epaper-boards.html reads + writes here. The operatorBoard
    // Cloud Function reads via admin SDK (bypasses these rules) and
    // also writes lastSeen/lastSeenIp heartbeat fields on every device
    // fetch — no public client writes ever.
    match /epaper_boards/{boardId} {
      allow read, write: if isAdmin();
    }

    // ─── Signal hub: per-user project completion sync ──────────
    // Each authenticated user owns one doc keyed by their uid. Stores
    // a flat completed map { "sg-NN": <timestamp> }. SignalProgressSync
    // (client) reads + writes; no Cloud Function involvement.
    match /signal_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Projects-hub progress (P4b) ───────────────────────────
    // Doc { projects: { "<projectId>": {"1":true,...} }, updatedAt }.
    // ProjectsProgressSync (client) reads + writes; owner-only, mirrors signal_progress.
    match /projects_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Web Flasher telemetry ─────────────────────────────────
    // Anonymous append-only event log for the Web Flasher. Each doc
    // is one event (page_load, project_select, connect_success,
    // connect_fail, flash_success, flash_fail). Lets us tune the
    // tool against real-world WebSerial / driver / cable failure
    // rates without burdening students with sign-in or surveys.
    //
    // No uid stored. Schema enforced at the rule layer: only a
    // fixed whitelist of fields, only a fixed set of event types,
    // size capped to prevent abuse. Read is admin-only.
    //
    // Top-level collection (Firestore paths alternate collection/doc;
    // a nested `/_telemetry/web_flasher_events/{id}` path would imply
    // `_telemetry` is a single doc with a subcollection, which is not
    // what we want).
    match /web_flasher_telemetry/{eventId} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly([
          'event', 'createdAt', 'project', 'flasherMode', 'errorMessage',
          'userAgent', 'browser', 'webSerialSupported'
        ]) &&
        request.resource.data.event in [
          'page_load', 'project_select', 'connect_success', 'connect_fail',
          'flash_start', 'flash_success', 'flash_fail',
          'pairing_code_claim_success', 'pairing_code_claim_fail'
        ] &&
        request.resource.data.createdAt == request.time &&
        (!('userAgent' in request.resource.data) ||
          request.resource.data.userAgent.size() < 500) &&
        (!('errorMessage' in request.resource.data) ||
          request.resource.data.errorMessage.size() < 500);
      allow update, delete: if false;
    }

    // ─── Hex AI Tool Invocation Audit Log (v0.6.0c-3) ─────────────────
    // Written by CF hexAiToolCallback (admin SDK bypasses rules).
    // Read access:
    //   - Student can read their own invocations (transparency: they can
    //     see what Dr. Hex looked up about them).
    //   - Admin/instructor can read all (operator oversight).
    // No client writes — only the CF (which authenticates the
    // orchestrator via X-API-Key) writes here.
    match /tool_invocations/{docId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    // Dr. Hex security events — defense-layer hit log (encoding_bypass,
    // jailbreak, rate_limit, lockout, output_scrub, tool_budget,
    // convo_locked). Written by hexAiSecurityEvent CF only, admin read
    // only, append-only. Cyber-platform-tier postmortem instrument.
    //
    // Schema fields are typed at the CF write layer; rules just gate
    // access. See _docs/operations/dr-hex-security-events.md (TBD).
    match /dr_hex_security_events/{docId} {
      allow read: if isAdmin();
      allow write: if false;  // CF Admin SDK only (bypasses rules)
    }

    // Dr. Hex engagement events — student-side beacons (intervention_sent,
    // downvote_response, tab_closed, walkthrough_opened, external_ai_signal).
    // Written exclusively by the hexAiEngagementEvent CF (Admin SDK bypasses
    // rules). Read access is admin-only, used by the engagement metrics
    // dashboard at /admin/dr-hex-engagement.html.
    //
    // No student-side write path — students cannot directly create these
    // documents. All writes go through the callable CF, which sanitizes
    // event_type against an allowlist and hashes the UID before persisting.
    match /dr_hex_engagement_events/{docId} {
      allow read: if isAdmin();
      allow write: if false;  // CF only
    }

    // Dr. Hex quality observations — operator-flagged response-quality
    // issues (rag-relevance, hallucination, help-ceiling, etc.). Schema +
    // taxonomy in _docs/operations/dr-hex-quality-log.md.
    //
    // Admin-only — these are operator observations of how the AI behaved,
    // not student-visible data. Written by the flag-quality.js CLI (admin
    // SDK bypasses these rules) and by the admin dashboard at
    // /admin/dr-hex-quality.html (client-side via these rules).
    //
    // Audit trail: any update that CHANGES the status field must set
    // statusChangedBy (the admin's uid) and statusChangedAt (timestamp).
    // Updates that don't touch status (e.g., notes edit) are unaffected.
    // Nancy review 2026-05-24: "you can always answer 'who last touched
    // this and when' without a schema migration later."
    match /dr_hex_quality_observations/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['category', 'observation', 'status', 'flaggedBy', 'flaggedAt'])
        && request.resource.data.category is string
        && request.resource.data.observation is string
        && request.resource.data.flaggedBy == request.auth.uid;
      allow update: if isAdmin() && (
        // No-change-to-status: any field-only edit is fine.
        request.resource.data.status == resource.data.status ||
        // Status change requires audit fields on the same write.
        (
          request.resource.data.statusChangedBy == request.auth.uid &&
          request.resource.data.statusChangedAt is timestamp
        )
      );
      allow delete: if false;   // append-only — fix the issue, don't erase the record
    }

    // ─── PIS Live Kahoot ─────────────────────────────────────────────────
    // kahoot_rooms/{code} — host creates and drives the room; players join
    // with anonymous auth. Room code is a 6-digit numeric string.
    //
    // Players subcollection: each player owns their own doc (uid == playerId).
    // Host can read/delete any player doc (kick). No server-side scoring —
    // client submits its own score; scores are not used for grading, only
    // classroom leaderboard display.
    match /kahoot_rooms/{code} {
      // Any authenticated user (including anonymous players) can read room metadata.
      // Players need status + currentQuestionIdx + questions array.
      allow read:   if request.auth != null;

      // Only a non-anonymous, logged-in tenant user can create a room (the host).
      allow create: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && request.resource.data.hostUid == request.auth.uid;

      // Only the host (identified by hostUid field) can update room state.
      // This gates question advance, reveal, and finished writes.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.hostUid;

      // Host can delete the room when the session is over.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.hostUid;

      match /players/{playerId} {
        // Any authenticated user can read the players subcollection
        // (needed for leaderboard display on all clients).
        allow read: if request.auth != null;

        // Player creates their own doc on join (anonymous uid must match document id).
        allow create: if request.auth != null
                      && request.auth.uid == playerId;

        // Player updates their own doc (answer submission, score update).
        // Field whitelist + score cap blocks the trivial console exploit
        // (UID-authenticated player writes score: 9999999 to own doc).
        // Cap: 20 questions x (1000 base + 200 streak bonus) = 24,000 max
        //      theoretical legit score; 25,000 ceiling allows headroom.
        allow update: if request.auth != null
                      && request.auth.uid == playerId
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['score', 'streak', 'bestStreak',
                                   'correctCount', 'wrongCount',
                                   'lastAnswerIdx', 'lastAnswerTimeMs',
                                   'lastAnswerCorrect'])
                      && request.resource.data.score is number
                      && request.resource.data.score >= 0
                      && request.resource.data.score <= 25000;

        // Host can delete a player doc (kick player from room).
        allow delete: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/kahoot_rooms/$(code)).data.hostUid;
      }
    }
  }
}
