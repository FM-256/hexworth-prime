rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: is this user an admin? ─────────────────────────
    // Checks both custom claims (admin: true) and email allowlist.
    // The email check mirrors requireAdmin() in Cloud Functions
    // (functions/index.js line 1819) so both paths grant the same access.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'f.mora80@gmail.com' ||
        request.auth.token.email == 'jorden@hexworth.com'
      );
    }

    // NOTE: an isHandler() helper (request.auth.token.handler == true || isAdmin()) was written
    // and emulator-tested for the users/{userId} GET tightening, then REMOVED rather than
    // shipped unused. Phase 2 restores it -- see the two-phase note in users/{userId} below for
    // why the GET half is held back and what has to happen first.

    // Users collection — authenticated users can read/write their own doc
    // Cloud Functions (setAdminClaim, addXP, recordProgress) use admin SDK (bypasses rules)
    match /users/{userId} {
      /* WAS: `allow read: if request.auth != null;` -- fixed 2026-08-21.
         In Firestore `read` grants GET *and* LIST, so that single line let ANY signed-in
         account enumerate the entire users collection and read every document in it. The
         documents carry `email` and `displayName` (see the create allowlist below), and
         anonymous sign-in is enabled because it is how students join a class -- so the
         practical effect was that anybody at all could list every student's name and email
         address. The comment directly above this block has always said "read/write their own
         doc"; the rule was simply broader than its own stated intent.

         Found on 2026-08-21 while assessing the blast radius of student UIDs that had been
         committed to this PUBLIC repo. The UIDs turned out to be a footnote: enumeration
         meant an attacker never needed one.

         Split deliberately rather than tightened to self-only, because two instructor
         surfaces legitimately read OTHER users' docs and would otherwise break:
           _app/js/handler-dashboard.js:4279            (_fetchGlobalProfile)
           _app/components/analytics/attendance-heatmap.html:396
         Both use .doc(uid).get() -- a GET. NOTHING client-side lists this collection; the one
         `.collection('users').get()` in the tree is admin-SDK Cloud Function code, which
         bypasses rules entirely. So LIST can be closed to everyone but admin without
         breaking a single caller.

         ⚠ SHIPPED IN TWO PHASES, ON PURPOSE. PHASE 1 (this change) closes LIST only.
         The GET half was written, tested and then HELD BACK, because a read-only production
         count found it would silently break real instructors:

             distinct tenants/{id}.adminUids uids : 4
             accountType=handler (would keep access) : 1
             accountType=<none>  (would LOSE access) : 3

         redeemInvite (functions/index.js:5493) grants tenant-instructor access by adding the
         uid to tenants/{id}.adminUids and writes NOTHING else -- no custom claim, no
         accountType, no role. grantHandler writes both. So a tenant-invited instructor is
         invisible to any claim-based check, and rules cannot rescue them: adminUids membership
         is per-tenant and rules cannot iterate tenants to discover which one they administer.
         Worse, handler-dashboard.js:4300 try/catches the read and falls back to roster data
         with only a console.warn, so those three would have degraded SILENTLY.

         PHASE 2, once redeemInvite also grants the claim and existing tenant admins are
         backfilled: restore
             allow get: if request.auth != null && (request.auth.uid == userId || isHandler());
         with the isHandler() helper. Until then GET stays as it was -- no regression, and the
         mass-enumeration hole is closed regardless, which is the part that made this severe. */
      allow get: if request.auth != null;
      allow list: if isAdmin();

      // Users can create their own doc (first sign-in) -- but never with a role.
      // Nancy 2026-08-03: `role` became a TRUST ANCHOR when AccessGuard's instructor level
      // started reading it. The update rule below already excludes it, but create had no
      // field restriction at all, so any signed-in user (anonymous included) could
      // setDoc(users/{uid}, {role:'instructor'}) BEFORE initializeNewUser ran -- a
      // deterministic self-grant, no race, no forgery needed. Only the admin SDK
      // (setAdminClaim and friends, which bypass rules) may ever write `role`.
      /* CREATE HAD NO FIELD ALLOWLIST — only `role` was blocked. Every other field was
         free, so any brand-new signup could create their own profile with arbitrary values:
         PROVEN 2026-08-05 by writing ctfBoxesPwned=9999 / ctfFlagsCaptured=9999 directly via
         the REST API immediately after accounts:signUp, confirmed persisted by a second-
         channel Admin SDK read, and rendered as fact on the user dossier
         (UserProfileModal.js:249-250).
         This defeated the counter hardening added to the UPDATE rule hours earlier: update
         correctly excluded the CTF counters, create did not exist in that guarantee. Existing
         users were never exposed — their writes route through update — but every new account
         was, deterministically, with no race.
         `tier` was equally free, and it includes 'instructor' and 'enterprise', rendered as a
         badge by FirestoreLeaderboard.js:288.
         The allowlist below is exactly what FirestoreManager.initializeNewUser writes
         (FirestoreManager.js:1616+), and the value pins say a new profile must START CLEAN.
         Anything a student earns is written by the server afterwards, never asserted at
         signup. */
      allow create: if request.auth != null && request.auth.uid == userId
        && !('role' in request.resource.data)
        && request.resource.data.keys().hasOnly([
             'email', 'displayName', 'photoURL', 'tier', 'grandfathered',
             'xp', 'streak', 'modulesCompleted', 'labsCompleted',
             'achievements', 'quizzes', 'createdAt',
             /* setUserProfile (FirestoreManager.js:363) unconditionally appends updatedAt to
                EVERY write it makes, including the first. Since the doc does not exist yet,
                that merge:true write is evaluated as a CREATE carrying 13 keys, not the 12
                initializeNewUser lists. Omitting it denied every Google, email and ANONYMOUS
                sign-in — anonymous being how students join a class. Caught in the emulator
                before deploy; the allowlist was built from the object literal and missed the
                wrapper that actually performs the write. */
             'updatedAt'
           ])
        && request.resource.data.get('tier', 'free') == 'free'
        && request.resource.data.get('grandfathered', false) == false
        && request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('streak', 0) == 0
        && request.resource.data.get('modulesCompleted', []).size() == 0
        && request.resource.data.get('labsCompleted', []).size() == 0
        && request.resource.data.get('achievements', []).size() == 0
        && request.resource.data.get('quizzes', {}).size() == 0;

      // Users can update only safe fields
      // XP + level are in the whitelist for backward compat but syncProgress CF
      // derives them server-side — client values are ignored during sync
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['callsign', 'callsignLower', 'displayName', 'photoURL',
                     'house', 'theme', 'favorites', 'settings', 'updatedAt',
                     'deviceId', 'accountType', 'firstName', 'lastName',
                     'studentId', 'isAnonymous', 'lastActivity',
                     'xp', 'level',
                     'modulesCompleted', 'labsCompleted', 'quizzes',
                     'achievements', 'streak',
                     /* ctfBoxesPwned and ctfFlagsCaptured were REMOVED here 2026-08-05
                        (Phase B). They are written solely by _recomputeCtfStats on the
                        server, from flag_captures and flag_registry. Re-adding them would
                        restore the dual-writer drift that made a forged value
                        indistinguishable from an honest one. Both client writers were
                        removed in the SAME change — BoxEngine.js and dashboard.html — because
                        this hasOnly() check evaluates the whole write, so a leftover client
                        write of these fields would reject its entire patch. */
                     'gamesPlayed']);

      // Gate completions subcollection — written by Cloud Functions (completeGate)
      // Students can read their own, admins can read any
      match /gates/{gateId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        // Only Cloud Functions (admin SDK) can write — no client writes allowed
      }

      // Operator mission completions -- written by Cloud Functions (validateMissionCompletion)
      // Students read their own so the Operator hub can hydrate cross-device completion marks
      match /mission_completions/{missionId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        // Only Cloud Functions (admin SDK) can write -- no client writes allowed
      }

      // Flag capture records — written by Cloud Functions (validateFlag)
      match /flag_captures/{captureId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Flag attempt rate-limiting — written by Cloud Functions (validateFlag)
      match /flag_attempts/{attemptId} {
        allow read: if isAdmin();
      }

      /* Mission progress — the evidence ledger the reveal gate is evaluated against (#306).
         Written ONLY by recordMissionFinding, which verifies each claim against the server's
         own copy of the mission provenance before recording it.

         ⚠ NO CLIENT WRITE, AND THIS IS THE WHOLE CONTROL. If a client could write here it
         would simply post {findings: {...: true}} and every gate opens: the verification in
         recordMissionFinding becomes a formality you can walk around, and #306 is reopened
         by its own fix. Read is allowed so a player's own progress can be shown back to them;
         reading it reveals nothing they did not establish themselves.

         Omitting this block entirely would ALSO have been safe here, since the default at the
         bottom of this file denies what is not matched. It is written out because a rule that
         exists and says "no client writes" survives someone later adding a permissive
         users/{userId}/{document=**} catch-all, and a silent default does not. */
      match /mission_progress/{progressId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }

      // Gate attempt rate-limiting — written by Cloud Functions (validateGateAnswer)
      match /gate_attempts/{attemptId} {
        allow read: if isAdmin();
      }

      // EDT Case Room reset counter — written by Cloud Functions (resetEDTSubmission)
      match /edt_resets/{labId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Activation code attempt rate-limiting — written by Cloud Functions (validateActivationCode)
      match /activation_attempts/{attemptId} {
        allow read: if isAdmin();
      }

      // Bulk localStorage sync — users can read/write their own sync blob
      match /sync/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Score submission rate-limiting — written by Cloud Functions (submitGameScore)
      match /score_submissions/{submissionId} {
        allow read: if isAdmin();
      }

      // TripWire events subcollection — written by client (IntegrityLockscreen), admin reads for dashboard
      match /tripwire_events/{eventId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if isAdmin();
      }
    }

    // Flag registry — admin can read (for tournament challenge setup), no client access
    // Cloud Functions use admin SDK for validation (bypasses rules)
    match /flag_registry/{boxId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* Mission gates — the server's copy of what a player must have FOUND before a flag counts.
       Admin reads for authoring; no client access at all. Cloud Functions use the admin SDK
       (assertGateSatisfied / recordMissionFinding) and bypass rules.

       This block was MISSING. The collection was protected only by FIRESTORE'S IMPLICIT DEFAULT
       — an unmatched path is denied — and NOT by any rule in this file: there is no
       `match /{document=**}` catch-all here at all (the only occurrence of that string is inside
       the mission_progress comment above, which describes one loosely). An adversarial audit
       confirmed reads were already refused (403), so nothing was exposed.

       It is written out for the reason mission_progress states: an explicit "no client access"
       survives someone later adding a permissive catch-all, and a silent default does not.
       mission_progress could carry that warning precisely BECAUSE it had a block to attach it
       to; this collection had nowhere to put one.

       Client read access here would defeat the whole gate. The doc contains every source, its
       axes and each finding's expected value — enough to satisfy any gate without doing the
       investigation, and on a badly-designed box (one whose flag equals an axis value) enough
       to read the answer straight out. */
    match /mission_gates/{boxId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Hexworth Observatory (research-consent house) ──
    // Consent records — the operator's copy of each participant's signed consent.
    // A student creates/updates their own doc (doc id == their uid); owner or admin reads.
    match /observatory_consent/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Enrollment roster — the clean per-student record (uid, class, name, email)
    // the admin dashboard queries, separate from the consent prose. A student
    // writes their own (doc id == their uid); owner or admin reads; admin deletes
    // (e.g. on withdrawal).
    match /observatory_enrollment/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Class roster — admin-managed list students enroll into. Any signed-in user
    // reads it (to populate the enrollment dropdown); only an admin writes.
    match /observatory_classes/{classId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Activity events — the consented cohort's tracked activity (the operator's
    // research/analytics data). A user may create events stamped with their own
    // uid; only an admin reads (the tracking dashboard). Append-only.
    match /observatory_activity/{eventId} {
      // Writes go ONLY through the logObservatoryEvent Cloud Function (admin SDK,
      // bypasses rules). Direct client writes are denied — this is what prevents
      // uid spoofing, classId forgery, and event stuffing. Admin reads (dashboard).
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    // Withdrawal tombstones — written ONLY by the withdrawFromObservatory Cloud
    // Function (admin SDK, bypasses rules). Admin reads (withdrawal audit). No
    // client access; holds no PII and no research data.
    match /observatory_withdrawals/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Sextant Plane B — tokenized cohort trajectory points. Written by the snapshot
    // Cloud Function (admin SDK). Holds NO PII: uid is replaced by HMAC(pepper, uid).
    // Admin reads for research; no client access, no client writes.
    match /sextant_cohort_points/{pointId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Sextant run summaries — observability for the snapshot pipeline. Admin read only.
    match /sextant_runs/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Gate answer registry — server-side only (admin SDK writes, no client access)
    match /gate_registry/{setId} {
      allow read: if false;
      allow write: if false;
    }

    // Challenge leaderboards — scores and per-level stats for interactive labs
    match /challenge_leaderboard/{challengeId} {
      allow read: if request.auth != null;

      // Scores subcollection — Cloud Functions write (submitChallengeScore), authenticated read
      match /scores/{scoreId} {
        allow read: if request.auth != null;
        // Only Cloud Functions (admin SDK) can write
      }

      // Stats subcollection — Cloud Functions write (submitChallengeScore), authenticated read
      match /stats/{statId} {
        allow read: if request.auth != null;
        // Only Cloud Functions (admin SDK) can write
      }
    }

    // Game scoreboards — any authenticated user can read, Cloud Functions write
    match /game_scores/{gameId} {
      allow read: if request.auth != null;
    }

    // Leaderboards — any authenticated user can read
    match /leaderboards/{docId} {
      allow read: if request.auth != null;
    }

    // HED reports — client-written error telemetry; admin reads.
    //
    // FIXED 2026-08-05. `allow create: if request.auth != null` had no field allowlist, no
    // size cap and no attribution check — any signed-in user could write an arbitrarily
    // shaped, arbitrarily large document, and set `uid` to anyone. Two SIBLING telemetry
    // collections in this same file (tripwire_events, web_flasher_telemetry) already use the
    // hasOnly + cap pattern, so this was an inconsistency rather than an unknown.
    //
    // `uid` is read from a localStorage cache by HED.js:180, so it is client-supplied and was
    // forgeable. It may still be null — a report from a session whose cache is missing is
    // legitimate and must not be rejected — but if present it has to be the caller.
    match /hed_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'sessionId', 'uid', 'house', 'userAgent', 'errors', 'errorCount', 'reportedAt'
           ])
        && (request.resource.data.get('uid', null) == null
            || request.resource.data.uid == request.auth.uid)
        && request.resource.data.errorCount is int
        && request.resource.data.errorCount >= 0
        && request.resource.data.errorCount <= 1000
        && request.resource.data.errors.size() <= 50
        && request.resource.data.userAgent.size() <= 200;
      allow read, delete: if isAdmin();
    }

    // OASIS Rings — anyone authenticated can read, any auth user can update (score submission)
    match /rings/{ringId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;

      // Attempts subcollection — auth users can create own, anyone can read
      match /attempts/{attemptId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }

    // Arena box ratings — hat rating system
    match /arena_ratings/{boxId} {
      // Anyone authenticated can read aggregates
      allow read: if request.auth != null;
      // Only transactions can update aggregates (validated shape)
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['totalScore', 'count', 'avg', 'updated'])
        && request.resource.data.totalScore is int
        && request.resource.data.count is int
        && request.resource.data.avg is number;

      // Individual ratings — users can only write their own
      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['rating', 'review', 'timestamp', 'displayName'])
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.review is string
          && request.resource.data.review.size() <= 120;
      }
    }

    // Arena Co-Op / VS sessions — authenticated users can create, join, and sync state
    //
    // FIXED 2026-08-29. `allow update: if request.auth != null` was scoped by nothing, so ANY
    // signed-in user could write ANY session. Paired with `allow read: if request.auth != null`
    // — which permits LISTING every session id — one account could enumerate every live room
    // and, in games it had never joined, flip `status` to 'disbanded'/'completed', overwrite
    // `winner`, or corrupt the shared `state` every player renders from.
    //
    // THE BOUNDARY IS MEMBERSHIP, because that is the boundary the game itself has: a room code
    // admits you, and everything after is a member acting inside their own room. Host-only
    // status transitions were considered and REJECTED — `surrender()` (CoOpSync.js:933) sets
    // `winner` and `status` from a NON-host team member, so host-only would break VS mode.
    // "Deny the attack" is only half a rule; the half that breaks users is the other one.
    //
    // BOTH DOCUMENT SHAPES are handled because the engine writes two (CoOpSync.js:166-200):
    // co-op keeps `players` at the top level, VS nests `teams.alpha|bravo.players`. Players are
    // keyed by `_getPlayerId()`, which returns the Firebase uid for any signed-in user
    // (CoOpSync.js:956-961) — so `uid in players` is a real identity check, not a convention.
    match /arena_sessions/{sessionId} {
      // Already in this room?
      function isMember() {
        return ('players' in resource.data && request.auth.uid in resource.data.players)
            || ('teams' in resource.data
                && ((request.auth.uid in resource.data.teams.alpha.players)
                 || (request.auth.uid in resource.data.teams.bravo.players)));
      }
      // Joining. Open by design — the room code is the ticket — but the write must land the
      // caller IN the room, so an update from someone who does not end up a member is refused.
      function isJoining() {
        return ('players' in request.resource.data
                && request.auth.uid in request.resource.data.players)
            || ('teams' in request.resource.data
                && ((request.auth.uid in request.resource.data.teams.alpha.players)
                 || (request.auth.uid in request.resource.data.teams.bravo.players)));
      }

      // ── BUG-234: WHICH fields a member may write ────────────────────────────────────
      // Membership above stops OUTSIDERS. It does not stop a member from writing anything they
      // like inside a room they legitimately joined, and a room code is the only ticket needed
      // to become a member -- so an alpha player could overwrite bravo's state, forge the
      // opponent's progress, or hand themselves the win. These checks scope the write itself.
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      // `boxId`, `mode`, `config` and `createdAt` describe WHICH lab this is and are set once
      // at creation. Nothing in CoOpSync.js ever updates them, so a write that touches one is
      // not gameplay -- it is someone repointing a live session at different content.
      function onlyMutableTopLevel() {
        return changed().hasOnly(['players', 'state', 'teams', 'status', 'winner']);
      }

      // NOT SCOPED: co-op `players`. The obvious rule -- "a member may write only their own
      // entry" -- was written, and then REJECTED because it breaks host migration:
      // _handleHostMigration (CoOpSync.js:810-812) demotes the stale host and promotes a
      // replacement in ONE transaction, so two player entries legitimately change and the
      // writer may be neither of them. Rules cannot express "every changed entry differs only
      // in isHost", so a correct-looking constraint here would have silently broken recovery
      // from a host disconnect -- a worse outcome than the gap it closes. Co-op is
      // collaborative (teammates, not opponents), and player-eviction was not among the harms
      // BUG-234 named. Left open deliberately, recorded rather than papered over.
      //
      // This does NOT apply to VS: host migration reads the top-level `players` map, which VS
      // docs do not have (CoOpSync.js:169-188), so it never runs there -- which is what makes
      // the per-player constraint below safe for teams and unsafe for co-op.

      // VS: each team is either untouched, or it is the team the caller is in (or joining) and
      // the only player entry that moved is their own. A team's `state` may change freely for
      // its own members -- that is the shared scoreboard they are collaborating on -- but the
      // OPPOSING team's map must come through byte-identical.
      //
      // TIGHTENED after Nancy reproduced a working attack against the first version (2026-08-29).
      // That version accepted the write if the caller ended up in the team's players map, which
      // an attacker satisfies by ADDING THEMSELVES — so an alpha player could self-join bravo
      // and rewrite `teams.bravo.state` in the very same write, and freely thereafter as a
      // genuine member. The join clause introduced to permit legitimate joins re-opened the
      // exact harm the rule existed to close. Two independent guards now stop it:
      //
      //   notDualMember()  you may not end up on BOTH teams. This kills the laundering route at
      //                    the root: an alpha player cannot become a bravo member at all. The
      //                    client never supported dual membership either (joinSession picks one
      //                    team, CoOpSync.js:268-274) — it was merely UI convention, and a raw
      //                    updateDoc bypassed it because rules were the only enforcement layer.
      //   state guard      a team's `state` may change only if the caller was ALREADY on that
      //                    team in `resource.data`. Joining and editing are decoupled, so even
      //                    if a future edit re-opened dual membership this write still fails.
      function vsTeamOk(t) {
        return request.resource.data.teams[t] == resource.data.teams[t]
            || (request.resource.data.teams[t].players.diff(resource.data.teams[t].players)
                  .affectedKeys().hasOnly([request.auth.uid])
                && (request.resource.data.teams[t].state == resource.data.teams[t].state
                    || request.auth.uid in resource.data.teams[t].players));
      }
      function notDualMember() {
        return !(request.auth.uid in request.resource.data.teams.alpha.players
                 && request.auth.uid in request.resource.data.teams.bravo.players);
      }
      function vsTeamsOk() {
        return !('teams' in changed())
            || (vsTeamOk('alpha') && vsTeamOk('bravo') && notDualMember());
      }

      // Only the four values the client actually writes (CoOpSync.js: waiting/active/
      // completed/disbanded). Keeps a member from parking a room in an undefined state.
      function statusOk() {
        return !('status' in changed())
            || request.resource.data.status in ['waiting', 'active', 'completed', 'disbanded'];
      }

      // A winner may be declared ONCE and never changed.
      //
      // The first draft required the winner to be the OTHER team, reasoning from surrender()
      // (CoOpSync.js:952, "Sets the other team as winner"). That was wrong and would have
      // broken the primary way a VS match ends: submitFlag (CoOpSync.js:544-546) sets
      // `winner = _teamId` -- the writer's OWN team -- when they capture the last flag first.
      // I had grepped every writer of `status` and not of `winner`. Both real writers are
      // legitimate, and they disagree about whose team gets named, so "which team" cannot be
      // the invariant.
      //
      // What IS invariant is that submitFlag only writes a winner when there is none yet
      // (`!data.winner`, inside a transaction). Enforcing exactly that server-side makes the
      // decided result immutable: the losing side cannot overwrite a finished match, which is
      // the theft BUG-234 named. `get('winner', null)` tolerates co-op docs, which have no
      // such field, instead of erroring into a deny for the wrong reason.
      //
      // STILL POSSIBLE, and out of scope here: a member declaring a win they did not earn,
      // because completion is computed client-side. Closing that needs server-side flag
      // validation, which is the same root cause as the BoxEngine flag-prefetch finding.
      function winnerOk() {
        return !('winner' in changed())
            || (request.resource.data.winner in ['alpha', 'bravo']
                && resource.data.get('winner', null) == null);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (isMember() || isJoining())
        && onlyMutableTopLevel()
        && vsTeamsOk()
        && statusOk()
        && winnerOk();
      // NOTE: this can never match. Sessions carry neither `hostUid` nor `createdBy` — see the
      // creation payload at CoOpSync.js:153-200 — so delete is effectively denied to everyone.
      // Left as-is deliberately: teardown goes through `status: 'disbanded'` (CoOpSync.js:641),
      // nothing calls delete, and widening it would add a destructive path nobody asked for.
      allow delete: if request.auth != null && (resource.data.hostUid == request.auth.uid || resource.data.createdBy == request.auth.uid);

      // Activity log subcollection
      // Activity log.
      //
      // FIXED 2026-08-29 alongside the parent. Subcollection rules do NOT inherit the parent
      // match's conditions, so scoping `update` above while leaving this bare would have closed
      // the door and left the window open one collection down: a stranger could forge entries
      // into a room they never joined, with any `player`/`playerId` they liked. Proven in
      // mallory-sweep-2026-08-04.test.js, which recorded exactly that.
      //
      // Two checks, and they close different things:
      //   playerId == uid   stops IDENTITY forgery (writing an entry as somebody else). Free.
      //   isSessionMember   stops writing into a room you are not in. Costs one document read
      //                     per entry -- acceptable because logActivity fires on join, start,
      //                     disband and surrender (CoOpSync.js:620), not per frame.
      // A missing or malformed parent makes get() error, which denies. That is the safe
      // direction: the log is an audit trail, and a lost entry beats a forged one.
      function isSessionMember(sid) {
        let s = get(/databases/$(database)/documents/arena_sessions/$(sid)).data;
        return ('players' in s && request.auth.uid in s.players)
            || ('teams' in s
                && ((request.auth.uid in s.teams.alpha.players)
                 || (request.auth.uid in s.teams.bravo.players)));
      }
      match /activity/{activityId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.playerId == request.auth.uid
          && isSessionMember(sessionId);
      }
    }

    // Handler messages — F-27 handler-to-student comms
    //
    // FIXED 2026-08-04. `allow read: if request.auth != null` was scoped by nothing. Its
    // comment claimed "queries filter by recipientUid or classId", but that is a CLIENT
    // convention, not a rule — a direct get() on a known id, or an unfiltered list(), was
    // enforced by nothing at all. PROVEN in the rules emulator: an uninvolved user read a
    // private individually-targeted message, listed the whole collection unfiltered, and
    // flipped readBy on someone else's message. Production held 9 real messages, 4 of them
    // private instructor-to-student, readable by any authenticated account on the platform.
    //
    // Scoped below to the people a message is actually for. Mirrors the newer F-23
    // messages/ rules further down this file, which got this right from the start.
    //
    // A message is either individually targeted (recipientUid set) or class-wide
    // (recipientUid absent — see sendHandlerMessage, functions/index.js:1240-1296, where
    // recipientUid is optional and validated against the class memberUids).
    match /handler_messages/{msgId} {
      // NOTE ON .get(field, default) AND exists(): a bare `resource.data.senderUid` throws
      // "Property senderUid is undefined" on any document missing the field, and a bare
      // get(/classes/$(id)) throws when the class no longer exists. In rules an evaluation
      // error denies, so a fragile predicate still fails closed — but it denies for the
      // WRONG REASON, and on a list() the error aborts the whole query rather than filtering
      // it. Defaults and an exists() guard keep the predicate total. Caught by the emulator
      // harness on the first run of this fix.
      allow read: if request.auth != null && (
        // the sender
        resource.data.get('senderUid', '') == request.auth.uid ||
        // the named recipient
        resource.data.get('recipientUid', '') == request.auth.uid ||
        // the handler of the class it belongs to
        isHandlerForClass(resource.data.get('classId', '')) ||
        // a class-wide message (no named recipient), read by a member of that class.
        // MUST test `== null`, NOT `== ''`. sendHandlerMessage (functions/index.js:1290)
        // writes `recipientUid: recipientUid || null`, so on a class-wide message the key is
        // PRESENT WITH VALUE null — never absent. `.get(field, default)` returns the default
        // only when the key is ABSENT, so a `.get('recipientUid','') == ''` test never fired
        // for a single real message. Caught in the rules emulator before deploy; it would
        // have left every class-wide message permanently unmarkable-as-read.
        // (`recipientType == 'class'` is the explicit discriminator, but the null test also
        // covers any legacy document written without that field.)
        (resource.data.get('recipientUid', null) == null &&
          exists(/databases/$(database)/documents/classes/$(resource.data.get('classId', '__none__'))) &&
          request.auth.uid in
            get(/databases/$(database)/documents/classes/$(resource.data.get('classId', '__none__'))).data.get('memberUids', []))
      );

      // Mark-as-read, but only by someone the message was actually for. The hasOnly(['readBy'])
      // guard limited WHICH field could change and never WHO could change it.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && (
          resource.data.get('recipientUid', '') == request.auth.uid ||
          (resource.data.get('recipientUid', null) == null &&
            exists(/databases/$(database)/documents/classes/$(resource.data.get('classId', '__none__'))) &&
            request.auth.uid in
              get(/databases/$(database)/documents/classes/$(resource.data.get('classId', '__none__'))).data.get('memberUids', []))
        );

      // Handlers can delete their own messages — already correctly scoped, unchanged.
      allow delete: if request.auth != null && resource.data.senderUid == request.auth.uid;
      // Only Cloud Functions (admin SDK) can create
    }

    // ─── F-23: Messaging System ──────────────────────────────────────

    // Helper: check if current user is a handler for the given class
    function isHandlerForClass(classId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
    }

    // Messages — read by participants or class handler; write only via Cloud Functions
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        resource.data.from == request.auth.uid ||
        resource.data.to == request.auth.uid ||
        isHandlerForClass(resource.data.classId)
      );

      // Direct writes blocked — all creates go through sendMessage CF
      allow create: if false;

      // Only recipient can mark as read
      allow update: if request.auth != null &&
        resource.data.to == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read == true;

      // Soft-delete only by handler
      allow update: if request.auth != null &&
        isHandlerForClass(resource.data.classId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted']) &&
        request.resource.data.deleted == true;

      allow delete: if false; // Hard deletes only via purge CF
    }

    // Conversations — read by participants or class handler
    match /conversations/{conversationId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        isHandlerForClass(resource.data.classId)
      );

      // Writes only via Cloud Functions
      allow write: if false;
    }

    // Messaging blocks — handler managed
    match /messaging_blocks/{blockId} {
      allow read: if request.auth != null && (
        resource.data.blockedUid == request.auth.uid ||
        isHandlerForClass(resource.data.classId)
      );

      // Write only via Cloud Functions
      allow write: if false;
    }

    // Spectator streams — read by anyone authenticated, write only via CFs
    match /spectator_streams/{streamId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // EDT lab submissions — students write their own, handlers read for grading
    //
    // FIXED 2026-08-04. VERB ASYMMETRY: `create` was correctly scoped to the caller's own
    // uid via the doc-id suffix, and `update` was bare `if request.auth != null`. The author
    // clearly understood ownership mattered and applied it to one verb only.
    //
    // A submission holds frameworkResponse, codeConflictResponse, autoScores AND the grade
    // fields frameworkGraded, frameworkScore, finalTotal, instructorFeedback, gradedBy —
    // written solely by gradeEDTSubmission (functions/index.js:7151-7249), which requires a
    // handler/admin claim and verifies the grading instructor owns a class containing that
    // student. PROVEN in the rules emulator: userA updated userB's submission setting
    // frameworkGraded, finalTotal:100 and gradedBy:'userA', bypassing every one of those
    // checks. A student could forge their own passing grade, or destroy another student's
    // work and fabricate instructor feedback.
    //
    // Closed as CF-only rather than scoped-to-owner: the owner must not be able to write
    // their own grade fields either, and no client code writes this collection — submission
    // goes through submitEDTLab (functions/index.js:6903-7059) and grading through
    // gradeEDTSubmission, both Admin SDK, which bypasses these rules.
    //
    // Zero submissions existed when this was found, so no real grade was forged. The path
    // was live and would have mattered the day the Ethics labs went into use.
    match /edt_submissions/{submissionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        submissionId.matches('.*_' + request.auth.uid + '$');
      // Updates via Cloud Functions only — see the note above.
      allow update: if false;
      allow delete: if false;
    }

    // Classes collection — handlers create/manage, students join/leave
    match /classes/{classId} {
      // Any authenticated user can read (needed for code lookup)
      allow read: if request.auth != null;

      // Create a class you own. The handlerUid must be YOU.
      //
      // FIXED 2026-08-04. This was bare `if request.auth != null` — no ownership check and
      // no schema check. PROVEN in the rules emulator: userA created a class with
      // handlerUid:'userB', a forged owner. ClassManager.js:182 always sets
      // `handlerUid: user.uid`, so the legitimate path is unaffected; the rule simply now
      // enforces what the only real writer already does.
      //
      // Impact of the hole: a planted class appears in a REAL handler's own "My Classes"
      // query (which filters where('handlerUid','==',uid)) the next time they open their
      // dashboard — roster pollution and instructor impersonation. Not takeover of their
      // existing classes; `update` was already correctly gated and is unchanged.
      // (No stored-XSS chain found — `name` is escapeHtml'd where it renders in
      // handler-dashboard.js.)
      allow create: if request.auth != null
        && request.resource.data.handlerUid == request.auth.uid;

      // Handler can update anything; students can ONLY add/remove own UID
      allow update: if request.auth != null && (
        // Handler full access
        resource.data.handlerUid == request.auth.uid
        ||
        // Student joining: adds own UID to memberUids, increments memberCount
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids
          && !(request.auth.uid in resource.data.memberUids)
          && resource.data.memberUids.size() < resource.data.maxMembers
        )
        ||
        // Student leaving: removes own UID from memberUids, decrements memberCount
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount', 'updatedAt'])
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.auth.uid in resource.data.memberUids
        )
      );

      // Only the handler who owns the class can delete
      allow delete: if request.auth != null
        && resource.data.handlerUid == request.auth.uid;

      // Assignments subcollection — handler manages, authenticated users can read
      match /assignments/{assignmentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
      }

      // Members subcollection — students write own profile, anyone authenticated can read
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == memberId;
        allow delete: if request.auth != null && (
          request.auth.uid == memberId
          || get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid
        );
      }

      // Progress subcollection — students write own progress, anyone authenticated can read
      match /progress/{studentUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == studentUid;
        allow delete: if request.auth != null && (
          request.auth.uid == studentUid
          || get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid
        );
      }

      // Activity subcollection — students log own events, anyone authenticated can read
      match /activity/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/classes/$(classId)).data.handlerUid == request.auth.uid;
      }
    }

    // TripWire events — authenticated users can create (report their own incidents)
    // Admin can read all. Rate limited to 10 per user per hour via Cloud Function.
    match /tripwire_events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid_hash', 'method', 'category', 'detail', 'timestamp', 'nonce', 'sessionId'])
        && request.resource.data.method is string
        && request.resource.data.category is string
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 200;
      allow read: if isAdmin();
    }

    // TripWire global stats — anyone authenticated can read, only Cloud Functions can write
    match /tripwire_stats/{docId} {
      allow read: if request.auth != null;
      // Only Cloud Functions (admin SDK) can write — increment counters
    }

    // Handler activation codes — admin console reads for Code History panel.
    // All writes go through Cloud Functions (adminGenerateHandlerCode, adminRevokeHandlerCode).
    match /handler_codes/{codeId} {
      allow read: if isAdmin();
      // Only Cloud Functions (admin SDK) can write
    }

    // ─── PFI Auto-Grading ──────────────────────────────────────────────
    // Test specs: server-only (admin SDK reads in CF, no client access)
    match /pfi_test_specs/{specId} {
      allow read: if false;
      allow write: if false;
    }

    // Submissions: written by CF, readable by authenticated users (student sees own, handler sees class)
    match /pfi_submissions/{submissionId} {
      allow read: if request.auth != null;
      // Only Cloud Functions (admin SDK) can write
    }

    // ─── Quality Reports ─────────────────────────────────────────────
    // Published by Nexus CLI (admin SDK writes via --publish flag).
    // Admin console reads to populate the Quality panel.
    match /_quality_reports/{reportId} {
      allow read: if isAdmin();
      // Only CLI (admin SDK) can write — no client writes allowed
    }

    // ─── Self-Healing Pipeline Queues ────────────────────────────────
    // Slice 1 of the bidirectional control plane. See:
    //   _docs/features/SELF_HEALING_PIPELINE.md
    //
    // _triage_queue: human-reviewed high/critical defects (aggregated)
    // _auto_fix_queue: agent-pull queue (Slice 1 ships empty allowlist;
    //                  Slice 3 enables agent-pull when fix templates exist)
    //
    // Both queues: admin-only read/write. Schema enforced via hasOnly
    // (extra-field injection blocked). Immutable fields preserved across
    // updates (defectFingerprint, source, severity, rule, createdAt).
    // Owner field validated via agent/human regex when set.

    function isValidActor(id) {
      return id is string && id.matches('^(agent|human):[a-z0-9_-]+$');
    }

    function isValidTriageData() {
      return request.resource.data.keys().hasAll([
            'defectFingerprint', 'source', 'severity', 'status',
            'priority', 'autoFixEligible', 'createdAt', 'updatedAt'
          ])
        && request.resource.data.keys().hasOnly([
            'defectFingerprint', 'source', 'severity', 'rule', 'ruleVersion',
            'title', 'description', 'filePath', 'lineNumber',
            'groupKey', 'childCount', 'childPaths',
            'status', 'priority', 'owner', 'claimedAt', 'heartbeatAt',
            'autoFixEligible', 'fixTemplate',
            'createdAt', 'updatedAt', 'resolvedAt', 'resolvedBy', 'resolveCommitSha',
            'history'
          ])
        && request.resource.data.defectFingerprint is string
        && request.resource.data.defectFingerprint.size() == 64
        && request.resource.data.source in ['nexus', 'sprint-master', 'manual']
        && request.resource.data.severity in ['critical', 'high', 'medium', 'low']
        && request.resource.data.status in ['open', 'claimed', 'in-progress', 'resolved', 'deferred', 'dismissed']
        && request.resource.data.autoFixEligible is bool
        && request.resource.data.priority is number
        && request.resource.data.priority >= 0
        && request.resource.data.priority <= 100
        && (!('owner' in request.resource.data)
            || request.resource.data.owner == null
            || isValidActor(request.resource.data.owner));
    }

    function preservesImmutableFields() {
      return request.resource.data.defectFingerprint == resource.data.defectFingerprint
        && request.resource.data.source == resource.data.source
        && request.resource.data.severity == resource.data.severity
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('rule', null) == resource.data.get('rule', null);
    }

    // ─── Launchpad Live Feed (LIVE-3, added 2026-06-03) ──────────────
    // featured_opportunities: aggregated jobs + internships from
    // USAJobs, Hacker News, and We Work Remotely. Written by the
    // scheduled fetchOpportunities Cloud Function via admin SDK
    // (no client writes possible). Public read so the Internship
    // Finder + Job Board pages can render the live feed without
    // requiring auth.
    match /featured_opportunities/{oppId} {
      allow read: if true;
      // Writes are server-only (admin SDK, no security-rules path)
    }

    // featured_opportunities_runs: telemetry from fetchOpportunities
    // (per-run counts, durations, errors). Admin-only read; server write.
    match /featured_opportunities_runs/{runId} {
      allow read: if isAdmin();
      // Writes are server-only
    }

    // featured_picks: operator-curated editorial spotlight pick
    // (Program of the Week / Featured Employer of the Week).
    // featured_picks/current is the active pick. Public read so
    // Internship Finder + Job Board can render the Spotlight without
    // auth. Write restricted to admins (operator + handler emails)
    // for weekly updates from the handler-dashboard admin path (LIVE-5).
    match /featured_picks/{pickId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /_triage_queue/{itemId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidTriageData();
      allow update: if isAdmin() && isValidTriageData() && preservesImmutableFields();
      allow delete: if isAdmin();
    }

    match /_auto_fix_queue/{itemId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidTriageData();
      allow update: if isAdmin() && isValidTriageData() && preservesImmutableFields();
      allow delete: if isAdmin();
    }

    // Item history archive — written on resolve to keep main item lean
    match /_triage_history/{itemId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Saturation alarm history — written by checkSaturationAlarm CF
    // (admin SDK, bypasses rules); admin reads for trend analysis.
    // Explicit deny on client writes (Nancy round 7) so the absence of
    // an allow rule is intentional rather than accidental.
    match /_saturation_history/{docId} {
      allow read: if isAdmin();
      allow write: if false;  // CF only via admin SDK
    }

    // ─── Self-Healing System Master Toggle ─────────────────────────────
    // _system_config/self_healing — single doc holding the master kill
    // switch + per-template enable map. Defaults to disabled.
    // Pulse admin UI writes; CLI agent commands and Cloud Functions read
    // before acting. No autonomous code mutation can happen unless this
    // doc says enabled: true.
    function isValidSystemConfig() {
      return request.resource.data.keys().hasOnly([
            'enabled', 'enabledBy', 'enabledAt',
            'lastDisabledBy', 'lastDisabledAt',
            'enabledTemplates',
            'availableTemplates', 'availableTemplatesUpdatedAt',
            'updatedAt'
          ])
        && request.resource.data.enabled is bool;
    }
    match /_system_config/{configId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidSystemConfig();
      allow delete: if false;
    }

    // ─── Admin Task Board ─────────────────────────────────────────────
    // Shared operational task board for the admin team.
    // Full read/write gated to admins only — no student access.
    match /_admin_tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    // ─── WL: White Label Tenant System ─────────────────────────────────

    // Tenant config — public read (loader page needs branding), admin write
    // The tenant config contains branding, licensing, and domain info.
    // Anyone can read (the branded loader page fetches this before auth).
    // Only Cloud Functions (admin SDK) can create/update/delete.
    match /tenants/{tenantId} {
      allow read: if true;  // Public — loader page needs this pre-auth
      // Write only via Cloud Functions (tenant-admin.js uses admin SDK)
    }

    // Tenant classes — read for any signed-in user; ALL writes via Cloud Functions.
    //
    // Client writes removed 2026-08-04. They let anyone in the tenant's adminUids create or
    // update a class document straight from the client SDK, bypassing adminCreateClass and
    // therefore the white-label licence gate entirely — the exact population that gate
    // exists to constrain. They also permitted `update` on ANY field including courseId,
    // defeating adminUpdateClass's allowlist, which deliberately excludes courseId so a
    // class cannot be switched to an unlicensed course after creation.
    //
    // The licence gate's stated justification was "if the unlicensed class never exists,
    // nothing downstream can write to it." That was false while this rule stood: the rules
    // layer was itself an ungated writer. Caught at QC before anyone relied on the claim.
    //
    // Safe to close: no client code writes these documents (verified across _app — the only
    // matches were observatory_classes and CSS classList), and every operation already has a
    // Cloud Function (adminCreateClass / adminUpdateClass / adminDeleteClass) running on the
    // admin SDK, which bypasses rules.
    //
    // Mirrors the parent tenants/{tenantId} rule above, which is already CF-only.
    match /tenants/{tenantId}/classes/{classId} {
      allow read: if request.auth != null;
      // Writes denied by omission — use the Cloud Functions named above.

      // Assignments within a tenant class — read for signed-in users; ALL writes via
      // Cloud Functions (createAssignment / updateAssignment / deleteAssignment,
      // functions/index.js:4053-4279).
      //
      // The client write was removed 2026-08-04 after it was PROVEN exploitable, not merely
      // suspected. Authenticated as a real member of faculty-testing-primus adminUids, a
      // direct REST PATCH returned HTTP 200 and created an assignment with: title 300 chars
      // (CF max 200), points 999999999 (CF max 10000), a contentType outside
      // VALID_CONTENT_TYPES, a status outside VALID_ASSIGNMENT_STATUSES, an arbitrary field
      // the update allowlist would strip, and a FORGED createdBy naming a uid that never
      // authenticated. Confirmed landed via the Admin SDK, then removed.
      //
      // Every validation the Assignment API performs was therefore optional for any tenant
      // admin, and downstream consumers (student assignment lists, points aggregation,
      // instructor dashboards) were built assuming those guarantees held.
      //
      // This is the same defect as the parent classes/{classId} rule fixed hours earlier:
      // a rules-layer write sitting beside a validating Cloud Function, gated only on
      // adminUids membership. Fixing the parent and not the child is how a sibling survives
      // a fix — check one level down.
      match /assignments/{assignmentId} {
        allow read: if request.auth != null;
        // Writes denied by omission — use the Cloud Functions named above.
      }

      // Student progress within a tenant class
      match /progress/{studentUid} {
        allow read: if request.auth != null && (
          request.auth.uid == studentUid ||
          request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids
        );
        allow write: if request.auth != null && request.auth.uid == studentUid;

        // ─── Analytics v2 — Event Log Subcollections ──────────────
        // Architecture: _docs/architecture/student-analytics-v2.md §4.5
        // Source of truth: Firestore subcollections under progress/{uid}.
        // ALL writes go via Cloud Functions (Admin SDK bypasses these rules).
        // Reads are gated per the governance status in the architecture doc.

        // Sessions — server-issued session tokens record the session lifecycle.
        // Self-readable (student can see their own session); CFs write.
        match /sessions/{sessionId} {
          allow read: if request.auth != null && request.auth.uid == studentUid;
          allow write: if false;
        }

        // Events — raw event log. NEVER readable from any client (CF-only).
        // Instructors see projections (itemState, aggregates), not raw events.
        match /events/{eventId} {
          allow read: if false;
          allow write: if false;
        }

        // IntegrityEvents — capture-only governance.
        // PI-only read access (platform admin). Even class instructor cannot read raw integrity events.
        match /integrityEvents/{eventId} {
          allow read: if isAdmin();
          allow write: if false;
        }

        // ItemState — per-item projection cache. Instructor-facing.
        match /itemState/{itemId} {
          allow read: if request.auth != null && (
            request.auth.uid == studentUid ||
            request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids
          );
          allow write: if false;
        }

        // QuizAttempts — full attempt history. Instructor-facing.
        match /quizAttempts/{attemptKey} {
          allow read: if request.auth != null && (
            request.auth.uid == studentUid ||
            request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids
          );
          allow write: if false;
        }

        // Mastery — concept mastery rollups (Phase 4). Instructor-facing.
        match /mastery/{objectiveId} {
          allow read: if request.auth != null && (
            request.auth.uid == studentUid ||
            request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids
          );
          allow write: if false;
        }
      }

      // ─── Analytics v2 — Aggregates ────────────────────────────────
      // Class-level rollups. Instructor-facing aggregates live at /aggregates/*.
      // Capture-only / PI-only aggregates live at /aggregates/internal/*.
      match /aggregates/{aggDoc} {
        // Instructor-facing aggregates: classStats, itemAnalytics, quizAnalytics, atRisk
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids ||
          isAdmin()
        );
        allow write: if false;
      }
      match /aggregates/internal/{captureOnlyDoc=**} {
        // Capture-only aggregates: PI ONLY
        allow read: if isAdmin();
        allow write: if false;
      }

      // ─── Analytics v2 — AI Ghost actions (Phase 1 Ghost RFC stub) ─
      // Pending actions written by the Ghost CF; rendered on student UI / instructor alerts.
      match /ghostActions/{actionId} {
        // Student reads their own targeted actions
        allow read: if request.auth != null && (
          (resource.data.targetUid == request.auth.uid) ||
          request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.adminUids ||
          isAdmin()
        );
        allow write: if false;  // CFs only
      }
    }

    // ─── Analytics v2 — Per-tenant consent records ───────────────────
    match /tenants/{tenantId}/consent/{version} {
      allow read: if request.auth != null;
      allow write: if false;  // CFs only
    }

    // ─── Analytics v2 — Platform Health Doc ────────────────────────
    // Projector heartbeat lives at /analytics_v2/projectorHeartbeat.
    // Instructor UI reads this for staleness detection (arch §7.1).
    match /analytics_v2/{healthDoc} {
      allow read: if request.auth != null;  // any signed-in user (instructor UI uses it)
      allow write: if false;  // CFs only
    }

    // ─── Signal C2 — Hardware Command & Control ──────────────────
    // Devices use HTTP endpoints (Cloud Functions) with deviceKey auth.
    // Dashboard reads are admin-only via Firestore direct access.
    // All writes go through Cloud Functions (admin SDK bypasses rules).

    // C2 device registry — admin read for dashboard, owner read for
    // student-owned devices ("My Devices" page). CF writes only.
    // Legacy open-enrollment devices (registered via /c2Register with
    // no pairing code) have ownerUid==null and stay admin-only.
    match /c2_devices/{deviceId} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow write: if false;  // Cloud Functions only
    }

    // C2 command queue — admin read for dashboard, CF writes
    match /c2_commands/{commandId} {
      allow read: if isAdmin();
      allow write: if false;  // Cloud Functions only
    }

    // C2 activity logs — admin read for dashboard, CF writes
    match /c2_logs/{deviceId}/entries/{entryId} {
      allow read: if isAdmin();
      allow write: if false;  // Cloud Functions only
    }

    // C2 pairing codes — admin read for operator dashboard. Student-owned
    // codes (issuedTo == 'student', ownerUid == caller) are also readable
    // by the owning student so the web flasher can poll for usedAt to
    // detect successful device registration. Admin-issued codes remain
    // admin-only (ownerUid is null or another admin uid).
    match /c2_pairing_codes/{code} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow write: if false;  // Cloud Functions only
    }

    // Student pairing-code rate-limit state. Owner read for UI display
    // ("you have 2 of 3 codes left in the next 24h"). CF writes only.
    match /student_pairing_state/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;  // Cloud Functions only
    }

    // ─── CTF Tournament System ─────────────────────────────────────
    // Tournament metadata — public read (podium page), admin write
    match /tournaments/{tournamentId} {
      allow read: if true;  // Public — podium and lobby pages need this pre-auth
      allow create, update, delete: if isAdmin();

      // Challenges — public read for lobby/board display
      // Flags are stored as SHA-256 hashes (flagHash field) so public read is safe.
      // The raw flag is never stored in Firestore — only the salted hash.
      // Cloud Functions validate submissions by hashing the attempt and comparing.
      match /challenges/{challengeId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Teams — public read (podium shows rankings), Cloud Functions manage joins/scoring
      match /teams/{teamId} {
        allow read: if true;  // Public — live podium needs this
        // BUG-024: teams are created only inside the admin-gated tournament-creation flow
        // (tournaments create = isAdmin). Locking create+update to admins closes the crafted-
        // team-field / crafted-doc-id XSS+DoS class (BUG-023/025) at the source, and drops the
        // dead `captain` clause (captain is ALWAYS null — it never granted anyone). Cloud
        // Functions (ctfSubmitFlag) update score/solves via the admin SDK, bypassing these rules.
        // Self-service join/leave (Model B, BUG-026) is re-enabled via a ctfJoinTeam/ctfLeaveTeam
        // Cloud Function so name<->uid binding is validated server-side: a client rule cannot
        // secure the parallel members[]/memberNames[] arrays (adversarial-review finding).
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // Submissions — admin can read all, team members read own team's
      match /submissions/{submissionId} {
        allow read: if request.auth != null;
        allow write: if false;  // Cloud Functions only (ctfSubmitFlag)
      }

      // Roster locks — one doc per uid = one team claim; serializes self-join so a user cannot
      // flood multiple teams. Cloud Functions only (ctfJoinTeam/ctfLeaveTeam, admin SDK); never
      // client-accessible.
      match /rosterLocks/{uid} {
        allow read, write: if false;
      }

      // Private tournament config — the join code, and anything else that must not be public.
      //
      // ADDED 2026-08-29 (TOURN-03). The parent `tournaments/{id}` is `allow read: if true` so
      // the podium and lobby work pre-auth, which means a secret stored on that document is
      // published rather than protected — an audit read an "invite only" event's plaintext code
      // with no authentication at all. Firestore rules cannot hide a FIELD, only a document, so
      // the secret has to live somewhere else: here.
      //
      // ADMIN-ONLY, not nobody. The first draft was `allow read, write: if false`, which was
      // wrong in both directions: it denied the admin console's own write when creating a
      // tournament, and it denied the manage view the read it needs to show an instructor the
      // code they are about to read out to a class. A rule that blocks the legitimate path is
      // half a rule.
      //
      // What matters is that STUDENTS cannot read it, and they cannot: isAdmin() gates both
      // verbs. ctfJoinTeam reads it with the admin SDK, which bypasses rules entirely.
      match /private/{docId} {
        allow read, write: if isAdmin();
      }
    }

    // ─── Hub Registry (dynamic, admin-created hubs) ────────────────
    // Firestore persistence layer for HubRegistry.js (task #225). Admin-created hubs render at
    // /houses/hub/<id> (one dynamic renderer) and are Observatory-tracked from creation.
    // status ('draft' | 'published') is the SOLE exposure gate:
    //   read   — readable if published, or by an admin (draft preview). For a LIST query,
    //            Firestore denies the WHOLE query unless every returnable doc provably satisfies
    //            the rule, so NON-ADMIN consumers MUST constrain with
    //            where('status','==','published'); admins may list unconstrained (isAdmin
    //            short-circuits). A single-doc get on a draft by a non-admin returns
    //            permission-denied -> the renderer shows "not available yet". (Every doc in this
    //            collection is dynamic and always carries a status, so there is no null-status
    //            edge in list; the static hubs live in HubRegistry.js, never here.)
    //   create — admin only AND the id must NOT collide with a reserved static HubRegistry.js id,
    //            so a dynamic doc can never shadow a live hardcoded course. Defense-in-depth with
    //            the static-wins merge in allWithDynamic(). Reserved set mirrors HubRegistry.all()
    //            (142 ids as of 2026-07-27; kept in parity by _tools/eduscan/hub-registry-audit.js +
    //            _tools/rules-test/hub-registry-rules.test.js, which assert no drift vs HubRegistry.js).
    //   update, delete — admin only.
    match /hubRegistry/{hubId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin()
        && !(hubId in ['wireshark', 'forensics', 'bug-hunting', 'signal', 'arctic-cli',
                       'network-plus', 'cyberops', 'aplus-core1', 'aplus-core2', 'md-100',
                       'md-101', 'feh', 'python-hub', 'python-for-it', 'security-plus', 'isc2-cc',
                       'server-plus', 'wsa', 'adv-linux', 'ethics-it', 'domino-effect', 'infosec',
                       'casp-plus', 'comptia-linux', 'aws-ccp', 'aws-developer',
                       'azure-fundamentals', 'security-operations', 'devops-fundamentals',
                       'cryptography-track', 'security-plus-crypto',
                       'cortex', 'code-armory', 'algorithm-chamber', 'proving-grounds', 'backbone',
                       'az-104', 'ai-900', 'ai-102', 'ehe', 'intro-networks', 'net-essentials',
                       'cloud-essentials', 'hardware-support', 'intro-security', 'cybersecurity-ethics',
                       'linux-essentials', 'linux-mastery', 'grep-pipe-mastery', 'databases',
                       'zero-to-python', 'projects', 'the-rig', 'clh', 'linux-admin',
                       'cse', 'openstack', 'cyber-framework', 'python-programming',
                       'api', 'vault', 'ai-advanced', 'ai-agents', 'ai-automation', 'azure-openai',
                       'cli-tools', 'adversarial', 'cnn', 'cyber-ml', 'deep-learning', 'cortex-foundations',
                       'generative', 'cortex-math', 'mlops', 'nlp', 'cortex-rl', 'supervised',
                       'transformers', 'unsupervised', 'api-auth', 'cloud-patterns', 'api-design', 'event-driven',
                       'owasp', 'pentest', 'rate-limiting', 'api-capstone', 'ms-102', 'ms-900', 'pl-300',
                       'complexity', 'data-structures', 'discrete-math', 'algorithm-chamber-dp', 'geometry', 'graphs',
                       'greedy', 'sorting', 'strings', 'assembly', 'bash', 'armory-c',
                       'cpp', 'csharp', 'armory-go', 'java', 'javascript', 'lua-perl-r',
                       'php', 'powershell', 'armory-python', 'python-graphics', 'ruby', 'rust',
                       'armory-sql', 'swift-kotlin', 'devops', 'ceh', 'intro-computers', 'piverse',
                       'protocore', 'cmmc', 'ms-security', 'sc-200', 'sc-900', 'security-101',
                       'bgp', 'carrier', 'datacenter', 'backbone-forensics', 'infiniband', 'ipv6',
                       'mpls', 'netsec', 'optical', 'qos', 'routing', 'sdn',
                       'sdwan', 'wireless', 'wifi-arsenal', 'toolkit',
                       'eye-cysa', 'web-ccna']);
      allow update, delete: if isAdmin();
    }

    // ─── Cohorts (REMOVED) ──────────────────────────────────
    // Cohort system consolidated into tenants/classes. See TENANT_COHORT_CONSOLIDATION.md.

    // ─── Enrollment Lookup ─────────────────────────────────
    // Fast lookup doc written at enrollment time by enrollInClass CF.
    // Read by syncClassProgress CF to find student's tenant/class.
    // Students can read their own enrollment. Written only by CF (admin SDK).
    match /enrollments/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Tenant Invites ────────────────────────────────────
    // Pre-registration instructor invites. tokenId is a bearer credential —
    // collection is fully locked at the rules layer; all access goes through
    // adminCreateInvite / adminListInvites / adminRevokeInvite / redeemInvite
    // CFs (admin SDK bypasses rules). See _docs/architecture/tenant-invites.md.
    match /tenant_invites/{tokenId} {
      allow read, write: if false;
    }

    // ─── ePaper Boards ─────────────────────────────────────
    // Per-physical-device config for XIAO-driven e-paper displays
    // (classroom doors, lobby signage, etc.). Admin UI at
    // /admin/epaper-boards.html reads + writes here. The operatorBoard
    // Cloud Function reads via admin SDK (bypasses these rules) and
    // also writes lastSeen/lastSeenIp heartbeat fields on every device
    // fetch — no public client writes ever.
    match /epaper_boards/{boardId} {
      allow read, write: if isAdmin();
    }

    // ─── Signal hub: per-user project completion sync ──────────
    // Each authenticated user owns one doc keyed by their uid. Stores
    // a flat completed map { "sg-NN": <timestamp> }. SignalProgressSync
    // (client) reads + writes; no Cloud Function involvement.
    match /signal_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Projects-hub progress (P4b) ───────────────────────────
    // Doc { projects: { "<projectId>": {"1":true,...} }, updatedAt }.
    // ProjectsProgressSync (client) reads + writes; owner-only, mirrors signal_progress.
    match /projects_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Web Flasher telemetry ─────────────────────────────────
    // Anonymous append-only event log for the Web Flasher. Each doc
    // is one event (page_load, project_select, connect_success,
    // connect_fail, flash_success, flash_fail). Lets us tune the
    // tool against real-world WebSerial / driver / cable failure
    // rates without burdening students with sign-in or surveys.
    //
    // No uid stored. Schema enforced at the rule layer: only a
    // fixed whitelist of fields, only a fixed set of event types,
    // size capped to prevent abuse. Read is admin-only.
    //
    // Top-level collection (Firestore paths alternate collection/doc;
    // a nested `/_telemetry/web_flasher_events/{id}` path would imply
    // `_telemetry` is a single doc with a subcollection, which is not
    // what we want).
    match /web_flasher_telemetry/{eventId} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly([
          'event', 'createdAt', 'project', 'flasherMode', 'errorMessage',
          'userAgent', 'browser', 'webSerialSupported'
        ]) &&
        request.resource.data.event in [
          'page_load', 'project_select', 'connect_success', 'connect_fail',
          'flash_start', 'flash_success', 'flash_fail',
          'pairing_code_claim_success', 'pairing_code_claim_fail'
        ] &&
        request.resource.data.createdAt == request.time &&
        (!('userAgent' in request.resource.data) ||
          request.resource.data.userAgent.size() < 500) &&
        (!('errorMessage' in request.resource.data) ||
          request.resource.data.errorMessage.size() < 500);
      allow update, delete: if false;
    }

    // ─── Hex AI Tool Invocation Audit Log (v0.6.0c-3) ─────────────────
    // Written by CF hexAiToolCallback (admin SDK bypasses rules).
    // Read access:
    //   - Student can read their own invocations (transparency: they can
    //     see what Dr. Hex looked up about them).
    //   - Admin/instructor can read all (operator oversight).
    // No client writes — only the CF (which authenticates the
    // orchestrator via X-API-Key) writes here.
    match /tool_invocations/{docId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    // Dr. Hex security events — defense-layer hit log (encoding_bypass,
    // jailbreak, rate_limit, lockout, output_scrub, tool_budget,
    // convo_locked). Written by hexAiSecurityEvent CF only, admin read
    // only, append-only. Cyber-platform-tier postmortem instrument.
    //
    // Schema fields are typed at the CF write layer; rules just gate
    // access. See _docs/operations/dr-hex-security-events.md (TBD).
    match /dr_hex_security_events/{docId} {
      allow read: if isAdmin();
      allow write: if false;  // CF Admin SDK only (bypasses rules)
    }

    // Dr. Hex engagement events — student-side beacons (intervention_sent,
    // downvote_response, tab_closed, walkthrough_opened, external_ai_signal).
    // Written exclusively by the hexAiEngagementEvent CF (Admin SDK bypasses
    // rules). Read access is admin-only, used by the engagement metrics
    // dashboard at /admin/dr-hex-engagement.html.
    //
    // No student-side write path — students cannot directly create these
    // documents. All writes go through the callable CF, which sanitizes
    // event_type against an allowlist and hashes the UID before persisting.
    match /dr_hex_engagement_events/{docId} {
      allow read: if isAdmin();
      allow write: if false;  // CF only
    }

    // Dr. Hex quality observations — operator-flagged response-quality
    // issues (rag-relevance, hallucination, help-ceiling, etc.). Schema +
    // taxonomy in _docs/operations/dr-hex-quality-log.md.
    //
    // Admin-only — these are operator observations of how the AI behaved,
    // not student-visible data. Written by the flag-quality.js CLI (admin
    // SDK bypasses these rules) and by the admin dashboard at
    // /admin/dr-hex-quality.html (client-side via these rules).
    //
    // Audit trail: any update that CHANGES the status field must set
    // statusChangedBy (the admin's uid) and statusChangedAt (timestamp).
    // Updates that don't touch status (e.g., notes edit) are unaffected.
    // Nancy review 2026-05-24: "you can always answer 'who last touched
    // this and when' without a schema migration later."
    match /dr_hex_quality_observations/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['category', 'observation', 'status', 'flaggedBy', 'flaggedAt'])
        && request.resource.data.category is string
        && request.resource.data.observation is string
        && request.resource.data.flaggedBy == request.auth.uid;
      allow update: if isAdmin() && (
        // No-change-to-status: any field-only edit is fine.
        request.resource.data.status == resource.data.status ||
        // Status change requires audit fields on the same write.
        (
          request.resource.data.statusChangedBy == request.auth.uid &&
          request.resource.data.statusChangedAt is timestamp
        )
      );
      allow delete: if false;   // append-only — fix the issue, don't erase the record
    }

    // ─── PIS Live Kahoot ─────────────────────────────────────────────────
    // kahoot_rooms/{code} — host creates and drives the room; players join
    // with anonymous auth. Room code is a 6-digit numeric string.
    //
    // Players subcollection: each player owns their own doc (uid == playerId).
    // Host can read/delete any player doc (kick). No server-side scoring —
    // client submits its own score; scores are not used for grading, only
    // classroom leaderboard display.
    match /kahoot_rooms/{code} {
      // Any authenticated user (including anonymous players) can read room metadata.
      // Players need status + currentQuestionIdx + questions array.
      allow read:   if request.auth != null;

      // Only a non-anonymous, logged-in tenant user can create a room (the host).
      allow create: if request.auth != null
                    && !request.auth.token.firebase.sign_in_provider.matches('anonymous')
                    && request.resource.data.hostUid == request.auth.uid;

      // Only the host (identified by hostUid field) can update room state.
      // This gates question advance, reveal, and finished writes.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.hostUid;

      // Host can delete the room when the session is over.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.hostUid;

      match /players/{playerId} {
        // Any authenticated user can read the players subcollection
        // (needed for leaderboard display on all clients).
        allow read: if request.auth != null;

        // Player creates their own doc on join (anonymous uid must match document id).
        allow create: if request.auth != null
                      && request.auth.uid == playerId;

        // Player updates their own doc (answer submission, score update).
        // Field whitelist + score cap blocks the trivial console exploit
        // (UID-authenticated player writes score: 9999999 to own doc).
        // Cap: 20 questions x (1000 base + 200 streak bonus) = 24,000 max
        //      theoretical legit score; 25,000 ceiling allows headroom.
        allow update: if request.auth != null
                      && request.auth.uid == playerId
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['score', 'streak', 'bestStreak',
                                   'correctCount', 'wrongCount',
                                   'lastAnswerIdx', 'lastAnswerTimeMs',
                                   'lastAnswerCorrect'])
                      && request.resource.data.score is number
                      && request.resource.data.score >= 0
                      && request.resource.data.score <= 25000;

        // Host can delete a player doc (kick player from room).
        allow delete: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/kahoot_rooms/$(code)).data.hostUid;
      }
    }
  }
}
