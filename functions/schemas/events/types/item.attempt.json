{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "item.attempt",
  "title": "Content Item Attempt",
  "description": "Emitted on each attempt at a graded item (quiz, lab, exam). Distinct from item.complete which fires once when fully done; item.attempt fires for every submission/try.",
  "type": "object",
  "additionalProperties": false,
  "required": ["itemId", "itemType", "attemptNumber"],
  "properties": {
    "itemId": {
      "type": "string"
    },
    "itemType": {
      "type": "string",
      "enum": ["quiz", "lab", "exam"]
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based attempt counter for this item by this student"
    },
    "score": {
      "type": ["number", "null"]
    },
    "scoreScale": {
      "type": ["string", "null"],
      "enum": ["percent", "raw", "points", null]
    },
    "passed": {
      "type": ["boolean", "null"]
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Time spent on this attempt in milliseconds"
    }
  },
  "governance": {
    "status": "instructor-facing",
    "consentScope": "performance data",
    "phase": 1,
    "dimension": 2
  }
}
