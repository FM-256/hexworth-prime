{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nav.session_end",
  "title": "Session End",
  "description": "Emitted on pagehide/visibilitychange-hidden when the session is being torn down. Best-effort — may not fire on iOS Safari tab kills or crashes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["durationMs"],
  "properties": {
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Total session duration in milliseconds (since session_start)"
    },
    "activeMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Active (non-idle) duration in milliseconds"
    },
    "exitUrl": {
      "type": "string",
      "description": "Last URL the student was on"
    },
    "reason": {
      "type": "string",
      "enum": ["pagehide", "visibilitychange", "explicit_logout", "token_expiry", "unknown"],
      "description": "What triggered the session end"
    }
  },
  "governance": {
    "status": "instructor-facing",
    "consentScope": "interaction data",
    "phase": 1,
    "dimension": 1
  }
}
